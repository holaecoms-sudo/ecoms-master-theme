{%- comment -%}
  ECOMS · «¿Dónde la vas a usar?»: up to 4 tabs (zone name + short how-to). CSS-only (radio inputs), works without
  JavaScript. Items come from the section blocks, or from a product metafield (list of «ecoms_item»: title + text),
  so one template serves every product. Hidden when empty.
{%- endcomment -%}
{%- liquid
  assign ec_src = section.blocks
  if section.settings.metafield != blank and product
    assign ec_mfp = section.settings.metafield | strip | split: '.'
    if ec_mfp.size == 2
      assign ec_mfl = product.metafields[ec_mfp[0]][ec_mfp[1]].value
      if ec_mfl != blank
        assign ec_src = ec_mfl
      endif
    endif
  endif
-%}
{%- if ec_src.size > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-zt-sec' %}>
  <div class="ec-w">
    {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="ec-zt">
      {%- for block in ec_src limit: 4 -%}
        <input class="ec-zt__r" type="radio" name="zt-{{ section.id }}" id="zt-{{ section.id }}-{{ forloop.index }}"{% if forloop.first %} checked{% endif %}>
      {%- endfor -%}
      <div class="ec-zt__tabs" role="presentation">
        {%- for block in ec_src limit: 4 -%}
          {%- assign zt_name = block.settings.name | default: block.title.value | default: block.label.value -%}
          <label for="zt-{{ section.id }}-{{ forloop.index }}" {{ block.shopify_attributes }}>{{ zt_name | escape }}</label>
        {%- endfor -%}
      </div>
      <div class="ec-zt__panels">
        {%- for block in ec_src limit: 4 -%}
          {%- assign zt_tip = block.settings.tip | default: block.text.value -%}
          <div class="ec-zt__p">
            <p class="ec-eyebrow">{{ section.settings.tip_label | default: 'Cómo usarla en' | escape }} {{ block.settings.name | default: block.title.value | escape | downcase }}</p>
            <p class="ec-zt__tip">{{ zt_tip | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Elige tu zona",
  "settings": [
    { "type": "text", "id": "metafield", "label": "Contenido desde metacampo del producto", "default": "ecoms.zones", "info": "Lista de «Ítem de contenido» (título = zona, texto = cómo usarla). Vacío o sin metacampo = usa los bloques." },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Una barra, tres zonas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Dónde la vas a usar?" },
    { "type": "text", "id": "tip_label", "label": "Texto sobre la indicación", "default": "Cómo usarla en" },
    { "type": "header", "content": "Diseño" },
    { "type": "select", "id": "width", "label": "Ancho en escritorio", "options": [
      { "value": "full", "label": "Completo" }, { "value": "left", "label": "Mitad izquierda" }, { "value": "right", "label": "Mitad derecha" } ], "default": "full" },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 80, "step": 4, "default": 36, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 80, "step": 4, "default": 36, "unit": "px" }
  ],
  "blocks": [
    { "type": "zone", "name": "Zona", "settings": [
      { "type": "text", "id": "name", "label": "Zona", "default": "Mejillas" },
      { "type": "textarea", "id": "tip", "label": "Cómo usarla", "default": "Desliza la barra y extiende con los dedos." } ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "ECOMS · Elige tu zona" }]
}
{% endschema %}
