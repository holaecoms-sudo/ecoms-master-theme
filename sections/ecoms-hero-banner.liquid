{%- comment -%}
  ECOMS · Banner oscuro: dark rounded card with eyebrow, heading, text and a product photo, plus a strip of repeating tags underneath.
  Appearance/function language only; every line must be verifiable.
{%- endcomment -%}
{%- liquid
  assign hb_img = section.settings.image
  if hb_img == blank and section.settings.product_image_index > 0
    assign hb_i = section.settings.product_image_index | minus: 1
    assign hb_img = product.images[hb_i]
  endif
  assign hb_alt = section.settings.heading | strip_html | replace: '*', ''
-%}
{%- render 'ecoms-css-defer', href: 'ecoms-ritual-sections.css' -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-hb-sec' %}>
  <div class="ec-w">
    <div class="ec-hb{% if hb_img == blank %} ec-hb--solo{% endif %}">
      <div class="ec-hb__body">
        {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="ec-hb__t">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.settings.note != blank -%}<p class="ec-hb__note">{{ section.settings.note | escape }}</p>{%- endif -%}
      </div>
      {%- if hb_img != blank -%}
        <div class="ec-hb__media">{{ hb_img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 560px, 100vw', alt: hb_alt }}</div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="ec-hb__strip" aria-hidden="true">
        {%- for i in (1..3) -%}
          {%- for block in section.blocks -%}<span {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>&#10022; {{ block.settings.label | escape }}</span>{%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ECOMS · Banner oscuro",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Activa tu *metabolismo.*" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "note", "label": "Nota pequeña" },
    { "type": "image_picker", "id": "image", "label": "Foto (opcional)" },
    { "type": "range", "id": "product_image_index", "label": "O usar la foto N° de la galería del producto", "min": 0, "max": 20, "step": 1, "default": 0, "info": "0 = no usar." },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    { "type": "tag", "name": "Etiqueta de la franja", "settings": [ { "type": "text", "id": "label", "label": "Texto", "default": "Activa tu metabolismo" } ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "ECOMS · Banner oscuro" } ]
}
{% endschema %}
