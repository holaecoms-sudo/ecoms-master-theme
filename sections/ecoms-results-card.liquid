{%- comment -%}
  ECOMS · Resultados: soft gradient card with a product photo, a heading, a checklist and one closing paragraph.
  Appearance/function language only; every line must be verifiable.
{%- endcomment -%}
{%- liquid
  assign rc_img = section.settings.image
  if rc_img == blank and section.settings.product_image_index > 0
    assign rc_i = section.settings.product_image_index | minus: 1
    assign rc_img = product.images[rc_i]
  endif
  assign rc_alt = section.settings.heading | strip_html | replace: '*', ''
-%}
{%- if section.blocks.size > 0 or request.design_mode -%}
{{ 'ecoms-ritual-sections.css' | asset_url | stylesheet_tag }}
<section {% render 'ecoms-section-style', section: section, class: 'ec-rr-sec' %}>
  <div class="ec-w">
    <div class="ec-rr{% if rc_img == blank %} ec-rr--solo{% endif %}">
      {%- if rc_img != blank -%}
        <div class="ec-rr__media">{{ rc_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,800,900', sizes: '(min-width: 990px) 420px, 100vw', alt: rc_alt }}</div>
      {%- endif -%}
      <div class="ec-rr__body">
        {%- if section.settings.heading != blank -%}{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}{%- endif -%}
        <ul class="ec-rr__list" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span class="ec-rr__ck">{% render 'ecoms-icon', name: 'check' %}</span>{{ block.settings.label | escape }}</li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.text != blank -%}<p class="ec-rr__t">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.settings.note != blank -%}<p class="ec-rr__note">{{ section.settings.note | escape }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Resultados",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que aporta *Lemme Burn.*" },
    { "type": "textarea", "id": "text", "label": "Párrafo final" },
    { "type": "text", "id": "note", "label": "Nota pequeña" },
    { "type": "image_picker", "id": "image", "label": "Foto (opcional)" },
    { "type": "range", "id": "product_image_index", "label": "O usar la foto N° de la galería del producto", "min": 0, "max": 20, "step": 1, "default": 0, "info": "0 = no usar." },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    { "type": "point", "name": "Punto con check", "settings": [ { "type": "text", "id": "label", "label": "Texto", "default": "Apoya tu metabolismo energético" } ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "ECOMS · Resultados" } ]
}
{% endschema %}
