{%- comment -%}
  ECOMS · Big-number callout: eyebrow, huge value («5 %»), label, short copy and up to 3 pills.
  Used for the star ingredient. Hidden when it has no value.
{%- endcomment -%}
{%- if section.settings.value != blank or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-callout-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}<h2 class="ec-callout__h">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="ec-callout">
      {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow ec-callout__eb">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <div class="ec-callout__big">{{ section.settings.value | escape }}<span>{{ section.settings.label | escape }}</span></div>
      {%- if section.settings.text != blank -%}<p class="ec-callout__t">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- assign pills = section.settings.pills | split: '·' -%}
      {%- if pills.size > 0 and section.settings.pills != blank -%}
        <p class="ec-callout__pills">{%- for p in pills -%}<span>{{ p | strip | escape }}</span>{%- endfor -%}</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Cifra destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "text", "id": "value", "label": "Cifra", "default": "5%" },
    { "type": "text", "id": "label", "label": "Nombre del ingrediente", "default": "Ingrediente." },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "pills", "label": "Etiquetas", "info": "Sepáralas con un punto medio (·)." },
    { "type": "header", "content": "Diseño" },
    { "type": "select", "id": "width", "label": "Ancho en escritorio", "options": [
      { "value": "full", "label": "Completo" }, { "value": "left", "label": "Mitad izquierda" }, { "value": "right", "label": "Mitad derecha" } ], "default": "full" },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 80, "step": 4, "default": 36, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 80, "step": 4, "default": 36, "unit": "px" }
  ],
  "presets": [{ "name": "ECOMS · Cifra destacada" }]
}
{% endschema %}
