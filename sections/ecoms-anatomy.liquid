{%- comment -%}
  ECOMS · Anatomía del producto: the product photo in the center with numbered feature callouts on both
  sides (stacked on mobile). Only describe features the product really has.
{%- endcomment -%}
{%- liquid
  assign items = 0
  for block in section.blocks
    if block.settings.title != blank
      assign items = items | plus: 1
    endif
  endfor
  assign half = items | plus: 1 | divided_by: 2
  assign pic = section.settings.image | default: product.featured_image
  assign n = 0
-%}
{%- if items > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-anat-sec' %}>
  <div class="ec-anat-wrap ec-anat-wrap--{{ section.settings.style }}">
    <div class="ec-w">
      <div class="ec-sec-h">
        {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      <div class="ec-anat">
        <div class="ec-anat__img">
          {%- if pic != blank -%}
            {{ pic | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 420px, 80vw', alt: section.settings.heading }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ec-placeholder' }}
          {%- endif -%}
        </div>
        {%- capture col_l -%}{%- endcapture -%}
        {%- capture col_r -%}{%- endcapture -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.title == blank -%}{%- continue -%}{%- endif -%}
          {%- assign n = n | plus: 1 -%}
          {%- capture item -%}
            <li class="ec-anat__item" {{ block.shopify_attributes }}>
              <span class="ec-anat__n">{{ n }}</span>
              <div>
                <b>{%- if block.settings.icon != 'none' -%}{% render 'ecoms-icon', name: block.settings.icon %}{%- endif -%}{{ block.settings.title | escape }}</b>
                {%- if block.settings.text != blank -%}<span class="ec-anat__t">{{ block.settings.text | escape }}</span>{%- endif -%}
              </div>
            </li>
          {%- endcapture -%}
          {%- if n <= half -%}
            {%- capture col_l -%}{{ col_l }}{{ item }}{%- endcapture -%}
          {%- else -%}
            {%- capture col_r -%}{{ col_r }}{{ item }}{%- endcapture -%}
          {%- endif -%}
        {%- endfor -%}
        <ul class="ec-anat__col ec-anat__col--l" role="list">{{ col_l }}</ul>
        <ul class="ec-anat__col ec-anat__col--r" role="list">{{ col_r }}</ul>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Anatomía",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "dark",
          "label": "Oscuro (color principal)"
        },
        {
          "value": "soft",
          "label": "Fondo suave"
        },
        {
          "value": "plain",
          "label": "Sin fondo"
        }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Diseñado para limpiar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Cada detalle cuenta"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (vacío = foto principal del producto)",
      "info": "Ideal: producto recortado sobre fondo transparente o liso."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Característica",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            {
              "value": "none",
              "label": "Sin icono"
            },
            {
              "value": "truck",
              "label": "Camión / envío"
            },
            {
              "value": "lock",
              "label": "Candado / pago seguro"
            },
            {
              "value": "shield",
              "label": "Escudo / garantía"
            },
            {
              "value": "return",
              "label": "Devolución"
            },
            {
              "value": "chat",
              "label": "Soporte"
            },
            {
              "value": "cash",
              "label": "Pago / efectivo"
            },
            {
              "value": "gift",
              "label": "Regalo"
            },
            {
              "value": "star",
              "label": "Estrella"
            },
            {
              "value": "heart",
              "label": "Corazón"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "clock",
              "label": "Reloj"
            },
            {
              "value": "fire",
              "label": "Fuego / oferta"
            },
            {
              "value": "bolt",
              "label": "Rayo / potencia"
            },
            {
              "value": "sparkle",
              "label": "Brillo"
            },
            {
              "value": "leaf",
              "label": "Hoja / natural"
            },
            {
              "value": "drop",
              "label": "Gota / agua"
            },
            {
              "value": "snow",
              "label": "Frío"
            },
            {
              "value": "thermo",
              "label": "Temperatura"
            },
            {
              "value": "sun",
              "label": "Sol / luz"
            },
            {
              "value": "gem",
              "label": "Gema / premium"
            },
            {
              "value": "hand",
              "label": "Mano / fácil"
            },
            {
              "value": "users",
              "label": "Personas"
            },
            {
              "value": "box",
              "label": "Caja / paquete"
            },
            {
              "value": "grid",
              "label": "Accesorios"
            },
            {
              "value": "battery",
              "label": "Batería"
            },
            {
              "value": "home",
              "label": "Hogar"
            },
            {
              "value": "verified",
              "label": "Verificado"
            },
            {
