{%- comment -%}
  ECOMS · Anatomía del producto: the product photo in the center with numbered feature callouts on both
  sides (stacked on mobile). Only describe features the product really has.
{%- endcomment -%}
{%- liquid
  # Items come from the section blocks, or from a product metafield (list of metaobjects «ecoms_item»)
  # when «Contenido desde metacampo» is set and the product has it. One template then serves every product.
  assign ec_src = section.blocks
  if section.settings.metafield != blank and product
    assign ec_mfp = section.settings.metafield | strip | split: '.'
    if ec_mfp.size == 2
      assign ec_mfl = product.metafields[ec_mfp[0]][ec_mfp[1]].value
      if ec_mfl != blank
        assign ec_src = ec_mfl
      endif
    endif
  endif
-%}
{%- liquid
  assign items = 0
  for block in ec_src
    assign bk_icon = block.settings.icon | default: block.icon.value
    assign bk_text = block.settings.text | default: block.text.value
    assign bk_title = block.settings.title | default: block.title.value
    if bk_title != blank
      assign items = items | plus: 1
    endif
  endfor
  assign half = items | plus: 1 | divided_by: 2
  assign pic = product.metafields.ecoms.feature_image.value | default: section.settings.image | default: product.featured_image
  assign n = 0
-%}
{%- if items > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-anat-sec' %}>
  <div class="ec-anat-wrap ec-anat-wrap--{{ section.settings.style }}">
    <div class="ec-w">
      <div class="ec-sec-h">
        {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      <div class="ec-anat{% unless section.settings.show_numbers %} ec-anat--plain{% endunless %}">
        <div class="ec-anat__img">
          {%- if pic != blank -%}
            {{ pic | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 420px, 80vw', alt: section.settings.heading }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ec-placeholder' }}
          {%- endif -%}
        </div>
        {%- capture col_l -%}{%- endcapture -%}
        {%- capture col_r -%}{%- endcapture -%}
        {%- for block in ec_src -%}
          {%- liquid
            assign bk_icon = block.settings.icon | default: block.icon.value
            assign bk_text = block.settings.text | default: block.text.value
            assign bk_title = block.settings.title | default: block.title.value
          -%}
          {%- if bk_title == blank -%}{%- continue -%}{%- endif -%}
          {%- assign n = n | plus: 1 -%}
          {%- capture item -%}
            <li class="ec-anat__item" {{ block.shopify_attributes }}>
              {%- if section.settings.show_numbers -%}
                <span class="ec-anat__n">{{ n }}</span>
              {%- elsif bk_icon != 'none' -%}
                <span class="ec-anat__ic">{% render 'ecoms-icon', name: bk_icon %}</span>
              {%- endif -%}
              <div>
                <b>
                  {%- if section.settings.show_numbers and bk_icon != 'none' -%}{% render 'ecoms-icon', name: bk_icon %}{%- endif -%}
                  {{- bk_title | escape -}}
                </b>
                {%- if bk_text != blank -%}<span class="ec-anat__t">{{ bk_text | escape }}</span>{%- endif -%}
              </div>
            </li>
          {%- endcapture -%}
          {%- if n <= half -%}
            {%- capture col_l -%}{{ col_l }}{{ item }}{%- endcapture -%}
          {%- else -%}
            {%- capture col_r -%}{{ col_r }}{{ item }}{%- endcapture -%}
          {%- endif -%}
        {%- endfor -%}
        <ul class="ec-anat__col ec-anat__col--l" role="list">{{ col_l }}</ul>
        <ul class="ec-anat__col ec-anat__col--r" role="list">{{ col_r }}</ul>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Anatomía",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "metafield",
      "label": "Contenido desde metacampo del producto",
      "info": "Opcional. Ej.: ecoms.stats. Si el producto tiene ese metacampo (lista de «Ítem de contenido»), reemplaza los bloques. Así una plantilla sirve para todos los productos."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "dark",
          "label": "Oscuro (color principal)"
        },
        {
          "value": "soft",
          "label": "Fondo suave"
        },
        {
          "value": "plain",
          "label": "Sin fondo"
        }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Diseñado para limpiar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Cada detalle cuenta"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (vacío = foto principal del producto)",
      "info": "Ideal: producto recortado sobre fondo transparente o liso."
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Numerar las características",
      "default": false,
      "info": "Desactivado: cada tarjeta muestra su ícono y el texto alineado a la izquierda."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
