              "label": "Brillo"
            },
            {
              "value": "leaf",
              "label": "Hoja / natural"
            },
            {
              "value": "drop",
              "label": "Gota / agua"
            },
            {
              "value": "snow",
              "label": "Frío"
            },
            {
              "value": "thermo",
              "label": "Temperatura"
            },
            {
              "value": "sun",
              "label": "Sol / luz"
            },
            {
              "value": "gem",
              "label": "Gema / premium"
            },
            {
              "value": "hand",
              "label": "Mano / fácil"
            },
            {
              "value": "users",
