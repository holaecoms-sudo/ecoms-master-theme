{%- comment -%}
  ECOMS · Moving band. Style «band»: short claims scrolling on a colored strip (ingredients, services).
  Style «logos»: «Visto en» row with the logos of media where the product really appeared; hidden on the
  storefront until a logo is uploaded.
{%- endcomment -%}
{%- liquid
  assign style = section.settings.style | default: 'band'
  assign items = 0
  for block in section.blocks
    if block.type == 'text' and block.settings.text != blank
      assign items = items | plus: 1
    elsif block.type == 'logo' and block.settings.logo != blank
      assign items = items | plus: 1
    endif
  endfor
-%}
{%- if items > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-mq-sec' %}>
  <div class="ec-mq ec-mq--{{ style }}">
    {%- if section.settings.heading != blank -%}<p class="ec-mq__h">{{ section.settings.heading | escape }}</p>{%- endif -%}
    <div class="ec-mq__view">
      <div class="ec-mq__track" style="--ec-mq-speed: {{ section.settings.speed | default: 30 }}s;">
        {%- for pass in (1..2) -%}
          <ul class="ec-mq__list" role="list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'text' -%}
                  {%- if block.settings.text != blank -%}
                    <li {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
                      {%- if block.settings.icon != 'none' -%}{% render 'ecoms-icon', name: block.settings.icon %}{%- endif -%}
                      <span>{{ block.settings.text | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- when 'logo' -%}
                  {%- if block.settings.logo != blank -%}
                    <li {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
                      {{ block.settings.logo | image_url: height: 80 | image_tag: loading: 'lazy', height: 40, alt: block.settings.name | default: block.settings.logo.alt, class: 'ec-mq__logo' }}
                    </li>
                  {%- elsif request.design_mode and pass == 1 -%}
                    <li {{ block.shopify_attributes }}><span class="ec-mq__ph">Sube el logo de {{ block.settings.name | default: 'un medio' | escape }}</span></li>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Banda en movimiento",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "band", "label": "Franja de color con frases" },
        { "value": "logos", "label": "Logos («Visto en»)" }
      ],
      "default": "band"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Ej.: Visto en. Úsalo solo con medios donde el producto realmente apareció."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duración de una vuelta",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 30
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho",
      "options": [
        { "value": "full", "label": "Completo" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Frase",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "sparkle", "label": "Destello" },
            { "value": "check", "label": "Check" },
            { "value": "drop", "label": "Gota" },
            { "value": "gem", "label": "Gema" },
            { "value": "leaf", "label": "Hoja" },
            { "value": "heart", "label": "Corazón" },
            { "value": "star", "label": "Estrella" },
            { "value": "truck", "label": "Camión" },
            { "value": "cash", "label": "Dinero" },
            { "value": "shield", "label": "Escudo" }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Fórmula coreana"
        }
      ]
    },
    {
      "type": "logo",
      "name": "Logo de medio",
      "settings": [
        {
          "type": "paragraph",
          "content": "Solo medios donde el producto realmente apareció: mostrar logos sin respaldo es publicidad engañosa."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre del medio"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "ECOMS · Banda en movimiento",
      "blocks": [
        { "type": "text", "settings": { "text": "Fórmula coreana" } },
        { "type": "text", "settings": { "text": "Colágeno + péptidos" } },
        { "type": "text", "settings": { "text": "Pago al recibir" } }
      ]
    }
  ]
}
{% endschema %}
