{%- comment -%}
  ECOMS · Zone photos: one card per area (eyes, cheeks, forehead, neck…) with a real photo, what the shopper notices there (chips)
  and how the product helps. Cards without a photo are skipped; with none, the whole section hides. Appearance language only.
{%- endcomment -%}
{%- liquid
  assign fz_ready = 0
  for block in section.blocks
    if block.settings.image != blank
      assign fz_ready = fz_ready | plus: 1
    endif
  endfor
-%}
{%- if fz_ready > 0 -%}
{{ 'ecoms-ritual-sections.css' | asset_url | stylesheet_tag }}
<section {% render 'ecoms-section-style', section: section, class: 'ec-fz-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h">{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}</div>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<p class="ec-fz__intro">{{ section.settings.text | escape }}</p>{%- endif -%}
  </div>
  <div class="ec-fz" role="list">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        {%- assign fz_chips = block.settings.concerns | split: ',' -%}
        <article class="ec-fz__card" role="listitem" {{ block.shopify_attributes }}>
          <div class="ec-fz__ph">
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: "(min-width: 750px) 25vw, 50vw", alt: block.settings.label }}
          </div>
          <div class="ec-fz__body">
            <b class="ec-fz__name">{{ block.settings.label | escape }}</b>
            {%- if block.settings.concerns != blank -%}<div class="ec-fz__chips">{%- for c in fz_chips -%}{%- assign c_t = c | strip -%}{%- if c_t != blank -%}<span>{{ c_t | escape }}</span>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
            <p class="ec-fz__t">{{ block.settings.text | escape }}</p>
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="ec-w">
    {%- if section.settings.image_note != blank or section.settings.note != blank -%}
      <p class="ec-fz__note">{{ section.settings.image_note | escape }} {{ section.settings.note | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="#" class="ec-btn ec-btn--accent ec-btn--lg ec-fz__cta" data-ec-scroll-buy>{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Fotos por zona",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu rostro | ¿Qué *parte* te preocupa?" },
    { "type": "textarea", "id": "text", "label": "Texto de apertura" },
    { "type": "text", "id": "chips_label", "label": "Etiqueta de las preocupaciones", "default": "Lo que notas aquí" },
    { "type": "text", "id": "image_note", "label": "Aviso de las fotos", "default": "Imágenes ilustrativas." },
    { "type": "text", "id": "note", "label": "Nota pequeña", "default": "Resultados cosméticos de apariencia; varían según cada piel y la constancia de uso." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Quiero probarlo" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Zona",
      "settings": [
        { "type": "text", "id": "label", "label": "Título (el problema que se nota)", "default": "Contorno de ojos" },
        { "type": "text", "id": "concerns", "label": "Lo que se nota (separado por comas)", "default": "Sequedad, Aspecto apagado" },
        { "type": "image_picker", "id": "image", "label": "Foto de la zona (horizontal 16:10, 1200 x 750 px)" },
        { "type": "textarea", "id": "text", "label": "Cómo ayuda el producto" }
      ]
    }
  ],
  "presets": [ { "name": "ECOMS · Fotos por zona" } ]
}
{% endschema %}
