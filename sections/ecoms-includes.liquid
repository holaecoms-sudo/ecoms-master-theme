{%- comment -%}
  ECOMS · Qué incluye (value stack). Shows every piece the customer gets (product, heads, accessories,
  gifts) so the offer reads as a kit, not a single item. Quantities and badges come from the editor:
  only list pieces that really ship in the box. The price line uses the real Shopify price.
{%- endcomment -%}
{%- liquid
  assign shown = 0
  for block in section.blocks
    if block.settings.title != blank
      assign shown = shown | plus: 1
    endif
  endfor
  assign variant = product.selected_or_first_available_variant
-%}
{%- if shown > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-incl-sec' %}>
  <div class="ec-w">
    <div class="ec-sec-h">
      {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <ul class="ec-incl" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.title == blank -%}{%- continue -%}{%- endif -%}
        <li class="ec-incl__item{% if block.settings.highlight %} ec-incl__item--hl{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="ec-incl__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          <div class="ec-incl__media{% if block.settings.image == blank %} ec-incl__media--icon{% endif %}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,300,400', sizes: '(min-width: 990px) 200px, 40vw', alt: block.settings.title }}
            {%- else -%}
              <span class="ec-ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>
            {%- endif -%}
            {%- if block.settings.qty != blank -%}<span class="ec-incl__qty">{{ block.settings.qty | escape }}</span>{%- endif -%}
          </div>
          <div class="ec-incl__body">
            <b>{{ block.settings.title | escape }}</b>
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_price and variant -%}
      <div class="ec-incl__total">
        <p>
          {{ section.settings.total_label | escape }}
          <b>{{ variant.price | money }}</b>
          {%- if variant.compare_at_price > variant.price %} <s>{{ variant.compare_at_price | money }}</s>{% endif -%}
        </p>
        {%- if section.settings.button_label != blank -%}
          <a href="#" class="ec-btn ec-btn--primary" data-ec-scroll-buy>{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<p class="ec-incl__note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

