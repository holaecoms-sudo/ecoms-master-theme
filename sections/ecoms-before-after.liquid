{% if section.settings.before != blank or section.settings.after != blank or request.design_mode %}
<section class="ecoms-section ecoms-beforeafter" id="ecoms-beforeafter-{{ section.id }}">
 <div class="page-width"><h2 class="ecoms-section-title">{{ section.settings.heading | escape }}</h2>
 {% if section.settings.text != blank %}<p class="ecoms-section-lead">{{ section.settings.text | escape }}</p>{% endif %}
 <div class="ecoms-beforeafter__grid">
 {% if section.settings.before != blank %}<figure>{{ section.settings.before | image_url: width: 900 | image_tag: loading: 'lazy', widths: '350,550,750,900' }}<figcaption>{{ section.settings.before_caption | escape }}</figcaption></figure>{% elsif request.design_mode %}<div class="ecoms-photo-placeholder">Imagen anterior</div>{% endif %}
 {% if section.settings.after != blank %}<figure>{{ section.settings.after | image_url: width: 900 | image_tag: loading: 'lazy', widths: '350,550,750,900' }}<figcaption>{{ section.settings.after_caption | escape }}</figcaption></figure>{% elsif request.design_mode %}<div class="ecoms-photo-placeholder">Imagen posterior</div>{% endif %}
 </div></div>
</section>
{% endif %}
{% schema %}
{"name":"ECOMS · Antes y después","settings":[{"type":"text","id":"heading","label":"Título","default":"Mira la diferencia"},{"type":"text","id":"text","label":"Descripción","default":"Compara una situación real con el resultado obtenido."},{"type":"image_picker","id":"before","label":"Imagen antes"},{"type":"text","id":"before_caption","label":"Etiqueta antes","default":"Antes"},{"type":"image_picker","id":"after","label":"Imagen después"},{"type":"text","id":"after_caption","label":"Etiqueta después","default":"Después"}],"presets":[{"name":"ECOMS · Antes y después"}]}
{% endschema %}
