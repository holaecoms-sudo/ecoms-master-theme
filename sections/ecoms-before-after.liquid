{%- comment -%}
  ECOMS · Before / after with real photos. «slider» = one photo with a draggable divider (before left, after right);
  «side» = two photos side by side. Hidden on the storefront until both photos exist.
{%- endcomment -%}
{%- assign ba_ready = false -%}
{%- assign ba_zones = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.settings.before != blank and block.settings.after != blank -%}{%- assign ba_zones = ba_zones | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if section.settings.before != blank and section.settings.after != blank or ba_zones > 0 -%}{%- assign ba_ready = true -%}{%- endif -%}
{%- if ba_ready or request.design_mode -%}
{{ 'ecoms-ritual-sections.css' | asset_url | stylesheet_tag }}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ba-sec' %}>
  <div class="ec-w" data-ec-bz>
    {%- if section.settings.heading != blank -%}{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2', class: 'ec-h3' %}{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="ec-sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="ec-bz__chips" role="tablist">
        {%- assign ba_first = true -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank and block.settings.before != blank and block.settings.after != blank or request.design_mode and block.settings.label != blank -%}
            <button type="button" role="tab" class="ec-zp__chip{% if ba_first %} is-on{% endif %}" aria-selected="{{ ba_first }}" data-ec-bz-tab="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
            {%- assign ba_first = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- assign ba_first = true -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank and block.settings.before != blank and block.settings.after != blank or request.design_mode and block.settings.label != blank -%}
          <div class="ec-bz__panel" data-ec-bz-panel="{{ block.id }}"{% unless ba_first %} hidden{% endunless %}>
            {% render 'ecoms-ba-pair', before: block.settings.before, after: block.settings.after, before_caption: section.settings.before_caption, after_caption: section.settings.after_caption, style: section.settings.style %}
            {%- if block.settings.note != blank -%}<p class="ec-bz__note">{{ block.settings.note | escape }}</p>{%- endif -%}
          </div>
          {%- assign ba_first = false -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {% render 'ecoms-ba-pair', before: section.settings.before, after: section.settings.after, before_caption: section.settings.before_caption, after_caption: section.settings.after_caption, style: section.settings.style %}
    {%- endif -%}
  </div>
  <script>
    (function () {
      if (window.__ecBa) return;
      window.__ecBa = true;
      document.addEventListener('input', function (e) {
        var r = e.target;
        if (r && r.hasAttribute && r.hasAttribute('data-ec-cmpr-range')) r.parentNode.style.setProperty('--pos', r.value + '%');
      });
      document.addEventListener('click', function (e) {
        var tab = e.target.closest && e.target.closest('[data-ec-bz-tab]');
        if (!tab) return;
        var root = tab.closest('[data-ec-bz]');
        var id = tab.getAttribute('data-ec-bz-tab');
        root.querySelectorAll('[data-ec-bz-tab]').forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('is-on', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll('[data-ec-bz-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-ec-bz-panel') !== id; });
      });
    })();
  </script>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Antes y después",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "slider",
          "label": "Deslizable: una foto con divisor"
        },
        {
          "value": "side",
          "label": "Dos fotos lado a lado"
        }
      ],
      "default": "slider"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mira la diferencia"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Descripción",
      "default": "Compara una situación real con el resultado obtenido."
    },
    {
      "type": "image_picker",
      "id": "before",
      "label": "Imagen antes"
    },
    {
      "type": "text",
      "id": "before_caption",
      "label": "Etiqueta antes",
      "default": "Antes"
    },
    {
      "type": "image_picker",
      "id": "after",
      "label": "Imagen después"
    },
    {
      "type": "text",
      "id": "after_caption",
      "label": "Etiqueta después",
      "default": "Después"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Zona",
      "settings": [
        { "type": "text", "id": "label", "label": "Zona (cápsula)", "default": "Codos" },
        { "type": "image_picker", "id": "before", "label": "Foto antes" },
        { "type": "image_picker", "id": "after", "label": "Foto después" },
        { "type": "text", "id": "note", "label": "Nota (opcional)", "info": "Ej.: Tras 14 días de uso, 2 veces por semana." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "ECOMS · Antes y después"
    }
  ],
  "tag": "section"
}
{% endschema %}
