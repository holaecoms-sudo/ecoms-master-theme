{%- comment -%}
  ECOMS · Quiénes somos: intro + photo, story, values (blocks), how we work (steps), company data card
  (only the fields that are filled) and a closing CTA. Every claim is editable: keep it true.
{%- endcomment -%}
{%- liquid
  assign store_name = settings.ecoms_store_name | default: shop.name
  assign values_count = 0
  assign steps_count = 0
  for block in section.blocks
    if block.type == 'value'
      assign values_count = values_count | plus: 1
    elsif block.type == 'step'
      assign steps_count = steps_count | plus: 1
    endif
  endfor
  assign s = section.settings
  assign has_company = false
  if s.legal_name != blank or s.rut != blank or s.city != blank or s.email != blank
    assign has_company = true
  endif
-%}
<section class="ec-ab" style="--ec-pt: {{ s.padding_top }}px; --ec-pb: {{ s.padding_bottom }}px;">
  <div class="ec-ab__hero">
    <div class="ec-w ec-ab__heroin{% if s.image == blank %} ec-ab__heroin--noimg{% endif %}">
      <div>
        {%- if s.eyebrow != blank -%}<p class="ec-ab__k">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="ec-ab__h">{{ s.heading | default: page.title | escape }}</h1>
        {%- if s.intro != blank -%}<div class="ec-ab__lead">{{ s.intro }}</div>{%- endif -%}
      </div>
      {%- if s.image != blank -%}
        <div class="ec-ab__img">
          {{ s.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '500,800,1200', sizes: '(min-width: 990px) 520px, 92vw', alt: s.heading }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.story_heading != blank or s.story != blank or page.content != blank -%}
    <div class="ec-w ec-ab__story">
      {%- if s.story_heading != blank -%}<h2 class="ec-ab__h2">{{ s.story_heading | escape }}</h2>{%- endif -%}
      {%- if s.story != blank -%}<div class="ec-ab__text rte">{{ s.story }}</div>{%- endif -%}
      {%- if page.content != blank and s.show_page_content -%}<div class="ec-ab__text rte">{{ page.content }}</div>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if values_count > 0 -%}
    <div class="ec-w ec-ab__block">
      {%- if s.values_heading != blank -%}<h2 class="ec-ab__h2 ec-ab__h2--c">{{ s.values_heading | escape }}</h2>{%- endif -%}
      <ul class="ec-ab__values" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type != 'value' -%}{%- continue -%}{%- endif -%}
          <li class="ec-ab__value" {{ block.shopify_attributes }}>
            <span class="ec-ab__ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>
            <b>{{ block.settings.title | escape }}</b>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if steps_count > 0 -%}
    <div class="ec-ab__band">
      <div class="ec-w">
        {%- if s.steps_heading != blank -%}<h2 class="ec-ab__h2 ec-ab__h2--c">{{ s.steps_heading | escape }}</h2>{%- endif -%}
        <ol class="ec-ab__steps" role="list">
          {%- assign n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'step' -%}{%- continue -%}{%- endif -%}
            {%- assign n = n | plus: 1 -%}
            <li class="ec-ab__step" {{ block.shopify_attributes }}>
              <span class="ec-ab__n">{{ n }}</span>
              <div>
                <b>{{ block.settings.title | escape }}</b>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  {%- endif -%}

  <div class="ec-w ec-ab__block ec-ab__end{% unless has_company %} ec-ab__end--solo{% endunless %}">
    {%- if has_company -%}
      <div class="ec-ab__card">
        <h2 class="ec-ab__h3">{% render 'ecoms-icon', name: 'shield' %}{{ s.company_heading | default: 'Datos de la empresa' | escape }}</h2>
        <dl>
          {%- if s.legal_name != blank -%}<div><dt>Razón social</dt><dd>{{ s.legal_name | escape }}</dd></div>{%- endif -%}
          {%- if s.rut != blank -%}<div><dt>RUT</dt><dd>{{ s.rut | escape }}</dd></div>{%- endif -%}
          {%- if s.city != blank -%}<div><dt>Ubicación</dt><dd>{{ s.city | escape }}</dd></div>{%- endif -%}
          {%- if s.email != blank -%}<div><dt>Email</dt><dd><a href="mailto:{{ s.email | escape }}">{{ s.email | escape }}</a></dd></div>{%- endif -%}
        </dl>
        {%- if shop.policies.size > 0 -%}
          <p class="ec-ab__pol">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% unless forloop.last %} · {% endunless %}{%- endif -%}
            {%- endfor -%}
          </p>
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="ec-editor-note">Completa razón social, RUT, ciudad y email en la sección para mostrar la tarjeta «Datos de la empresa». Es lo que más confianza da para pagar por adelantado.</p>
    {%- endif -%}
    <div class="ec-ab__cta">
      {%- if s.cta_heading != blank -%}<h2 class="ec-ab__h2">{{ s.cta_heading | escape }}</h2>{%- endif -%}
      {%- if s.cta_text != blank -%}<p>{{ s.cta_text | escape }}</p>{%- endif -%}
      <div class="ec-ab__btns">
        {%- if s.button_1_label != blank -%}<a class="ec-btn ec-btn--primary" href="{{ s.button_1_link | default: routes.all_products_collection_url }}">{{ s.button_1_label | escape }} {% render 'ecoms-icon', name: 'arrow' %}</a>{%- endif -%}
        {%- if s.button_2_label != blank -%}<a class="ec-btn ec-ab__btn2" href="{{ s.button_2_link | default: '/pages/contact' }}">{{ s.button_2_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ECOMS · Quiénes somos",
  "tag": "section",
  "class": "ec-ab-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Quiénes somos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Una tienda chilena de soluciones simples para tu casa" },
    { "type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>Elegimos pocos productos, que resuelven problemas concretos del día a día, y te explicamos con claridad cómo funcionan, qué incluyen y cuánto demoran en llegar.</p>" },
    { "type": "image_picker", "id": "image", "label": "Foto (tuya, del equipo o del trabajo)", "info": "Una foto real da mucha más confianza que una imagen de banco." },
    { "type": "header", "content": "Historia" },
    { "type": "text", "id": "story_heading", "label": "Título", "default": "Por qué existe Ecoms" },
    { "type": "richtext", "id": "story", "label": "Texto", "default": "<p>Cuéntalo con tus palabras: quién está detrás, desde dónde trabajas y qué te motivó a crear la tienda. Dos o tres párrafos cortos bastan.</p>" },
    { "type": "checkbox", "id": "show_page_content", "label": "Mostrar también el contenido de la página", "default": false },
    { "type": "header", "content": "Bloques" },
    { "type": "text", "id": "values_heading", "label": "Título de «En qué creemos»", "default": "Lo que puedes esperar de nosotros" },
    { "type": "text", "id": "steps_heading", "label": "Título de «Cómo trabajamos»", "default": "Cómo funciona tu compra" },
    { "type": "header", "content": "Datos de la empresa" },
    { "type": "text", "id": "company_heading", "label": "Título", "default": "Datos de la empresa" },
    { "type": "text", "id": "legal_name", "label": "Razón social" },
    { "type": "text", "id": "rut", "label": "RUT" },
    { "type": "text", "id": "city", "label": "Ciudad / comuna", "info": "Ej.: Santiago, Chile" },
    { "type": "text", "id": "email", "label": "Email de contacto" },
    { "type": "header", "content": "Cierre" },
    { "type": "text", "id": "cta_heading", "label": "Título", "default": "¿Tienes alguna duda?" },
    { "type": "text", "id": "cta_text", "label": "Texto", "default": "Escríbenos antes de comprar: te respondemos por email." },
    { "type": "text", "id": "button_1_label", "label": "Botón 1", "default": "Ver productos" },
    { "type": "url", "id": "button_1_link", "label": "Enlace botón 1" },
    { "type": "text", "id": "button_2_label", "label": "Botón 2", "default": "Contáctanos" },
    { "type": "url", "id": "button_2_link", "label": "Enlace botón 2" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Compromiso",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "shield", "label": "Escudo" },
            { "value": "lock", "label": "Candado" },
            { "value": "truck", "label": "Camión" },
            { "value": "return", "label": "Devolución" },
            { "value": "chat", "label": "Mensaje" },
            { "value": "verified", "label": "Verificado" },
            { "value": "heart", "label": "Corazón" },
            { "value": "home", "label": "Casa" },
            { "value": "box", "label": "Caja" }
          ],
          "default": "verified"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Información clara" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    },
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Paso" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "ECOMS · Quiénes somos" } ]
}
{% endschema %}
