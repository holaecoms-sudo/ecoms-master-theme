{%- comment -%}
  ECOMS · Image + text row (landing style): photo/video, heading, intro, checklist and a CTA that
  scrolls to the buy box. Stack several and alternate the side for a long-form landing.
  Without an image it uses the product photo number set in "Foto del producto".
{%- endcomment -%}
{%- liquid
  assign idx = section.settings.product_image_index | minus: 1
  assign row_img = section.settings.image | default: product.images[idx] | default: product.featured_image
-%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-imgtxt-sec' %}>
  <div class="ec-w">
    <div class="ec-imgtxt ec-imgtxt--{{ section.settings.image_side }}">
      <div class="ec-imgtxt__media">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '900x' }}
        {%- elsif row_img != blank -%}
          {{ row_img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 480px, 100vw', alt: section.settings.heading }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}
        {%- endif -%}
      </div>
      <div class="ec-imgtxt__copy">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="ec-imgtxt__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="ec-imgtxt__list" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'ecoms-icon', name: 'check' %}
                <span><b>{{ block.settings.title | escape }}</b>{% if block.settings.text != blank %} – {{ block.settings.text | escape }}{% endif %}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="ec-btn ec-btn--primary ec-btn--sm ec-imgtxt__btn" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ECOMS · Imagen y texto",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "image_side",
      "label": "Imagen a la",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "range",
      "id": "product_image_index",
      "label": "Si no hay imagen, foto del producto n.º",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (opcional, reemplaza la imagen)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Un beneficio clave en una frase"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introducción",
      "default": "Describe el problema que resuelve."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Lo quiero"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace (vacío = sube a comprar)"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Punto",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Beneficio"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Detalle",
          "default": "Qué gana el cliente"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "ECOMS · Imagen y texto",
      "blocks": [
        {
          "type": "point"
        },
        {
          "type": "point"
        },
        {
          "type": "point"
        }
      ]
    }
  ]
}
{% endschema %}
