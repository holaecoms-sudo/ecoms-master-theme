{%- comment -%}
  ECOMS · Portada (home): trust-first hero. Copy + two buttons + up to 4 trust points on the left,
  a featured product on the right (photo, real «desde» price from Shopify, link to its page).
{%- endcomment -%}
{%- liquid
  assign fp = section.settings.product
  assign fp_url = fp.url | default: routes.all_products_collection_url
  assign fp_img = section.settings.image | default: fp.featured_image
  assign more_url = section.settings.button_2_link | default: fp_url
-%}
<section class="ec-hh" style="--hh-accent: {{ section.settings.accent | default: '#14B8A6' }}; --ec-pt: {{ section.settings.padding_top }}px; --ec-pb: {{ section.settings.padding_bottom }}px;">
  <div class="ec-w ec-hh__in">
    <div class="ec-hh__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="ec-hh__eyebrow"><i></i>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="ec-hh__h">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em | escape }}</em>{% endif -%}
      </h1>
      {%- if section.settings.text != blank -%}<p class="ec-hh__lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="ec-hh__btns">
        {%- if section.settings.button_1_label != blank -%}
          <a class="ec-btn ec-btn--primary ec-btn--lg" href="{{ section.settings.button_1_link | default: '#ec-home-products' }}">{{ section.settings.button_1_label | escape }} {% render 'ecoms-icon', name: 'arrow' %}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="ec-btn ec-btn--lg ec-hh__ghost" href="{{ more_url }}">{{ section.settings.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
      <ul class="ec-hh__trust" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank -%}
            <li {{ block.shopify_attributes }}>
              <span class="ec-hh__ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>
              <div>{{ block.settings.title | escape }}{%- if block.settings.text != blank -%}<small>{{ block.settings.text | escape }}</small>{%- endif -%}</div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div class="ec-hh__feat">
      <a class="ec-hh__img" href="{{ fp_url }}" tabindex="-1" aria-hidden="true">
        {%- if fp_img != blank -%}
          {{ fp_img | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,800,1100', sizes: '(min-width: 990px) 470px, 92vw', alt: '' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'ec-placeholder' }}
        {%- endif -%}
      </a>
      {%- if section.settings.tag != blank -%}<span class="ec-hh__tag">{{ section.settings.tag | escape }}</span>{%- endif -%}
      {%- if fp != blank -%}
        <a class="ec-hh__card" href="{{ fp_url }}">
          <div><b>{{ fp.title | escape }}</b>{%- if section.settings.card_text != blank -%}<span>{{ section.settings.card_text | escape }}</span>{%- endif -%}</div>
          <div class="ec-hh__price"><span>desde</span><b>{{ fp.price_min | money }}</b></div>
          <span class="ec-hh__go" aria-hidden="true">{% render 'ecoms-icon', name: 'arrow' %}</span>
          <span class="visually-hidden">Más información sobre {{ fp.title | escape }}</span>
        </a>
      {%- elsif request.design_mode -%}
        <p class="ec-editor-note">Elige el producto destacado en la configuración de la sección.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ECOMS · Portada",
  "tag": "section",
  "class": "ec-hh-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta",
      "default": "Hogar práctico"
    },
    {
      "type": "text",
      "id": "heading",
