    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Botón principal",
      "default": "Ver productos"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Enlace del botón principal",
      "info": "Vacío = baja a la sección de productos."
    },
    {
