      "default": "Soluciones simples para un hogar"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Final del título (destacado)",
      "default": "más fácil"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
