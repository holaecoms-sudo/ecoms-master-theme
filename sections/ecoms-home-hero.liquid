      "info": "Vacío = página del producto destacado."
    },
    {
      "type": "header",
      "content": "Producto destacado"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (vacío = foto principal del producto)"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Etiqueta sobre la foto",
      "default": "Nuevo"
    },
    {
      "type": "text",
      "id": "card_text",
