{%- comment -%} ECOMS · FAQ with FAQPage structured data. {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-faq-sec' %}>
  <div class="ec-w{% if section.settings.style == 'split' %} ec-faq-split{% endif %}">
    {%- if section.settings.style == 'split' -%}
      <div class="ec-faq-split__h">
        {%- if section.settings.heading != blank -%}<h2 class="ec-h3">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- elsif section.settings.heading != blank -%}
      <h2 class="ec-h3{% if section.settings.width == 'full' %} ec-h3--center{% endif %}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- comment -%}
      Per-product FAQ: product metafield ecoms.faqs (list of metaobjects "ecoms_faq" with fields
      question + answer) replaces the template questions when present.
    {%- endcomment -%}
    {%- assign faq_mf = product.metafields.ecoms.faqs.value -%}
    <div class="ec-faq{% if section.settings.width == 'full' %} ec-faq--narrow{% endif %}">
      {%- if faq_mf != blank -%}
        {%- for entry in faq_mf -%}
          <details>
            <summary>
              <span>{{ entry.question.value | escape }}</span>
              {%- if section.settings.icon == 'plus' -%}{% render 'ecoms-icon', name: 'plus' %}{%- else -%}{% render 'ecoms-icon', name: 'chev-r', class: 'chev' %}{%- endif -%}
            </summary>
            <div class="ec-faq__a rte">{{ entry.answer | metafield_tag }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
      {%- for block in section.blocks -%}
        {%- comment -%} Draft answers (not confirmed yet) only show in the Theme Editor. {%- endcomment -%}
        {%- if block.settings.draft and request.design_mode != true -%}{%- continue -%}{%- endif -%}
        {%- if block.settings.question != blank -%}
          <details {{ block.shopify_attributes }}{% if block.settings.draft %} class="ec-faq--draft"{% endif %}>
            <summary>
              <span>{{ block.settings.question | escape }}</span>
              {%- if section.settings.icon == 'plus' -%}
                {% render 'ecoms-icon', name: 'plus' %}
              {%- else -%}
                {% render 'ecoms-icon', name: 'chev-r', class: 'chev' %}
              {%- endif -%}
            </summary>
            <div class="ec-faq__a rte">
              {%- if block.settings.draft -%}<p class="ec-faq__draft">Borrador: oculto en la tienda hasta confirmar la respuesta.</p>{%- endif -%}
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
  {%- if faq_mf == blank and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign faq_n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.question != blank and block.settings.draft != true -%}
              {%- if faq_n > 0 %},{% endif -%}
              {%- assign faq_n = faq_n | plus: 1 -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
              }
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "ECOMS · FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "stack",
          "label": "Centrado"
        },
        {
          "value": "split",
          "label": "Título a la izquierda, preguntas a la derecha"
        }
      ],
      "default": "stack"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto bajo el título (estilo dividido)"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icono",
      "options": [
        {
          "value": "chev",
          "label": "Flecha"
        },
        {
          "value": "plus",
          "label": "Más"
        }
      ],
      "default": "chev"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Cuánto tarda el envío?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Completa con la política real de tu tienda.</p>"
        },
        {
          "type": "checkbox",
          "id": "draft",
          "label": "Respuesta sin confirmar (borrador)",
          "default": false,
          "info": "Oculta la pregunta en la tienda hasta tener el dato real del proveedor."
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "ECOMS · FAQ",
      "blocks": [
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        }
      ]
    }
  ]
}
{% endschema %}
