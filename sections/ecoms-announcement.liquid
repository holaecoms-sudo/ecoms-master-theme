{%- comment -%} ECOMS · Announcement bar: inline messages with separators (mockup Flex/Brand/Direct). {%- endcomment -%}
{%- capture ec_skin -%}{% render 'ecoms-skin' %}{%- endcapture -%}
{%- assign ann_style = section.settings.style -%}
{%- if ann_style == 'auto' -%}{%- assign ann_style = ec_skin -%}{%- endif -%}
<div class="ec-ann ec-ann--{{ ann_style }} ec-ann--motion-{{ section.settings.motion | default: 'static' }}" role="region" aria-label="Anuncios">
  <div class="ec-ann__inner">
    {%- capture ann_items -%}
      {%- liquid
        assign shown = 0
        assign ship_threshold = 0
        if settings.ecoms_free_shipping_live
          # Exact CLP amount (39990) or thousands (40 = $40.000), as cents.
          assign ship_threshold = settings.ecoms_free_shipping_threshold | plus: 0
          if ship_threshold < 1000
            assign ship_threshold = ship_threshold | times: 1000
          endif
          assign ship_threshold = ship_threshold | times: 100
        endif
        # Lower free-shipping amount for one zone (e.g. Región Metropolitana), when set.
        assign ship_local = 0
        if ship_threshold > 0
          assign ship_local = settings.ecoms_free_shipping_local_threshold | plus: 0 | times: 100
        endif
      -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign msg = block.settings.text | escape
          if block.type == 'cod' and settings.ecoms_cod_live != true
            # Only announced once cash on delivery is active (Theme settings → ECOMS · Carrito).
            assign msg = ''
          endif
          if block.type == 'free_shipping'
            # Only announced when a real free-shipping rate exists (Theme settings → ECOMS · Carrito).
            if ship_threshold == 0
              assign msg = ''
            else
              assign ship_amount = ship_threshold | money_without_trailing_zeros
              assign msg = msg | replace: '[amount]', ship_amount
              if ship_local > 0
                assign local_amount = ship_local | money_without_trailing_zeros
                assign local_zone = settings.ecoms_free_shipping_local_zone | escape
                assign msg = msg | replace: '[local_amount]', local_amount | replace: '[zone]', local_zone
              elsif msg contains '[local_amount]'
                assign msg = ''
              endif
            endif
          endif
        -%}
        {%- if msg == blank -%}
          {%- if request.design_mode and block.type == 'free_shipping' -%}
            <span class="ec-ann__hidden" {{ block.shopify_attributes }}>(Envío gratis oculto: actívalo en ECOMS · Carrito)</span>
          {%- endif -%}
          {%- continue -%}
        {%- endif -%}
        {%- if shown > 0 %}<span class="ec-ann__sep" aria-hidden="true">{{ section.settings.separator }}</span>{% endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <span class="ec-ann__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon == 'flag_cl' -%}
            {%- render 'ecoms-flag-cl' -%}
          {%- elsif block.settings.icon != blank and block.settings.icon != 'none' -%}
            {%- render 'ecoms-icon', name: block.settings.icon -%}
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ msg }}</a>
          {%- else -%}
            {{- msg -}}
          {%- endif -%}
        </span>
      {%- endfor -%}
    {%- endcapture -%}
    {%- capture ann_icon -%}{%- if section.settings.icon != 'none' -%}{% render 'ecoms-icon', name: section.settings.icon %}{%- endif -%}{%- endcapture -%}
    {%- assign ann_motion = section.settings.motion | default: 'static' -%}
    {%- if ann_motion == 'static' -%}
      <span class="ec-ann__msgs">{{ ann_icon }}{{ ann_items }}</span>
    {%- else -%}
      {%- comment -%} Ticker: the message group is rendered twice and the track slides by half its width, so the loop has no seam. {%- endcomment -%}
      <div class="ec-ann__marquee">
        <div class="ec-ann__track" style="--ec-ann-speed: {{ section.settings.speed | default: 25 }}s;">
          <span class="ec-ann__msgs">{{ ann_icon }}{{ ann_items }}<span class="ec-ann__sep ec-ann__sep--loop" aria-hidden="true">{{ section.settings.separator }}</span></span>
          <span class="ec-ann__msgs ec-ann__msgs--copy" aria-hidden="true">{{ ann_icon }}{{ ann_items }}<span class="ec-ann__sep ec-ann__sep--loop">{{ section.settings.separator }}</span></span>
        </div>
      </div>
    {%- endif -%}
    {%- liquid
      assign end_ts = 0
      if section.settings.end_at != blank
        assign end_clean = section.settings.end_at | remove: '"' | remove: "'" | strip
        if end_clean.size >= 10 and end_clean contains '-'
          assign end_ts = end_clean | date: '%s' | plus: 0
        endif
      endif
      assign now_ts = 'now' | date: '%s' | plus: 0
    -%}
    {%- if end_ts > now_ts -%}
      <span class="ec-ann__timer" data-ec-countdown="{{ end_ts }}">
        {{ section.settings.timer_label | escape }} <span class="ec-timer" data-ec-cd-inline>--:--:--</span>
      </span>
    {%- endif -%}
  </div>
</div>

