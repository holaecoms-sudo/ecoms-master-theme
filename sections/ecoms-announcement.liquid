{%- comment -%} ECOMS · Announcement bar: inline messages with separators (mockup Flex/Brand/Direct). {%- endcomment -%}
{%- capture ec_skin -%}{% render 'ecoms-skin' %}{%- endcapture -%}
{%- assign ann_style = section.settings.style -%}
{%- if ann_style == 'auto' -%}{%- assign ann_style = ec_skin -%}{%- endif -%}
<div class="ec-ann ec-ann--{{ ann_style }}" role="region" aria-label="Anuncios">
  <div class="ec-ann__inner">
    <span class="ec-ann__msgs">
      {%- if section.settings.icon != 'none' -%}{% render 'ecoms-icon', name: section.settings.icon %}{%- endif -%}
      {%- for block in section.blocks -%}
        {%- unless forloop.first %}<span class="ec-ann__sep" aria-hidden="true">{{ section.settings.separator }}</span>{% endunless -%}
        <span {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{- block.settings.text | escape -}}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </span>
    {%- liquid
      assign end_ts = 0
      if section.settings.end_at != blank
        assign end_clean = section.settings.end_at | remove: '"' | remove: "'" | strip
        if end_clean.size >= 10 and end_clean contains '-'
          assign end_ts = end_clean | date: '%s' | plus: 0
        endif
      endif
      assign now_ts = 'now' | date: '%s' | plus: 0
    -%}
    {%- if end_ts > now_ts -%}
      <span class="ec-ann__timer" data-ec-countdown="{{ end_ts }}">
        {{ section.settings.timer_label | escape }} <span class="ec-timer" data-ec-cd-inline>--:--:--</span>
      </span>
    {%- endif -%}
  </div>
</div>

