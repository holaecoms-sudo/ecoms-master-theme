{%- comment -%} ECOMS · Benefit strip (icons on a soft band). {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-strip' %}>
  <div class="ec-w ec-strip__grid">
    {%- for block in section.blocks -%}
      <div class="ec-strip__item" {{ block.shopify_attributes }}>
        {% render 'ecoms-icon', name: block.settings.icon %}
        <div>
          <b>{{ block.settings.heading | escape }}</b>
          {%- if block.settings.text != blank -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

