{%- comment -%} ECOMS · "Ideal para…": who / where the product fits, as icon or photo cards. {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ideal-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="ec-sec-h">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ec-ideal">
      {%- for block in section.blocks -%}
        <div class="ec-ideal__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200,350,500', sizes: '(min-width: 990px) 260px, 45vw', alt: block.settings.title, class: 'ec-ideal__img' }}
          {%- else -%}
            <span class="ec-ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>
          {%- endif -%}
          <b>{{ block.settings.title | escape }}</b>
          {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

