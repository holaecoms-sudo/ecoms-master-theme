{%- comment -%} ECOMS · Image banner with copy, CTA and claims (Brand). {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-banner-sec' %}>
  <div class="ec-bnr">
    {%- assign bnr_img = section.settings.image | default: product.images[2] | default: product.featured_image -%}
    {%- if bnr_img != blank -%}
      {{ bnr_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 33vw, 100vw', alt: '' }}
    {%- endif -%}
    <div class="ec-bnr__txt">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="ec-bnr__p">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="ec-btn ec-btn--light ec-btn--sm" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label | escape }} {% render 'ecoms-icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="ec-bnr__claims">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}><span class="ec-ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>{{ block.settings.text | escape }}</div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
