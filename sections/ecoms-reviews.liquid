{% if section.blocks.size > 0 or request.design_mode %}
<section class="ecoms-section ecoms-reviews" id="ecoms-reviews-{{ section.id }}"><div class="page-width">
 <h2 class="ecoms-section-title">{{ section.settings.heading | escape }}</h2>
 {% if section.blocks.size > 0 %}<div class="ecoms-reviews__grid">{% for block in section.blocks %}
 <figure class="ecoms-review" {{ block.shopify_attributes }}>
 {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 650 | image_tag: loading: 'lazy', widths: '240,400,650' }}{% endif %}
 <div class="ecoms-review__stars" aria-label="{{ block.settings.stars }} de 5 estrellas">{% for i in (1..5) %}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{% endfor %}</div>
 <blockquote>“{{ block.settings.quote | escape }}”</blockquote><figcaption>{{ block.settings.author | escape }}</figcaption>
 </figure>{% endfor %}</div>
 {% elsif request.design_mode %}<p class="ecoms-empty-hint">Añade reseñas auténticas y autorizadas, o integra una aplicación de reseñas con datos verificados.</p>{% endif %}
 </div></section>
{% endif %}
{% schema %}
{"name":"ECOMS · Reseñas reales","settings":[{"type":"text","id":"heading","label":"Título","default":"Lo que opinan quienes lo usan"}],"blocks":[{"type":"review","name":"Reseña verificada","settings":[{"type":"image_picker","id":"image","label":"Fotografía autorizada"},{"type":"text","id":"author","label":"Nombre del cliente"},{"type":"textarea","id":"quote","label":"Testimonio auténtico"},{"type":"range","id":"stars","label":"Calificación real","min":1,"max":5,"step":1,"default":5}]}],"max_blocks":12,"presets":[{"name":"ECOMS · Reseñas reales"}]}
{% endschema %}
