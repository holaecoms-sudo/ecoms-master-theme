{%- comment -%}
  ECOMS · Reviews. Summary from review-app metafields; cards are real, authorised reviews entered by
  the merchant, or the review app's own block (@app). Hidden on the storefront when there is nothing real.
{%- endcomment -%}
{%- liquid
  assign has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign has_rating = true
  endif
  assign real_blocks = 0
  for block in section.blocks
    unless block.type == 'review' and block.settings.example
      assign real_blocks = real_blocks | plus: 1
    endunless
  endfor
  assign style = section.settings.style | default: 'flex'
-%}
{%- if real_blocks > 0 or has_rating or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-reviews' %}>
  {%- if style == 'widget' -%}
    {%- liquid
      assign rv_n = 0
      assign rv_sum = 0
      assign c5 = 0
      assign c4 = 0
      assign c3 = 0
      assign c2 = 0
      assign c1 = 0
      for block in section.blocks
        if block.type == 'review' and block.settings.text != blank
          if block.settings.example and request.design_mode == false
            continue
          endif
          assign rv_n = rv_n | plus: 1
          assign rv_sum = rv_sum | plus: block.settings.stars
          case block.settings.stars
            when 5
              assign c5 = c5 | plus: 1
            when 4
              assign c4 = c4 | plus: 1
            when 3
              assign c3 = c3 | plus: 1
            when 2
              assign c2 = c2 | plus: 1
            else
              assign c1 = c1 | plus: 1
          endcase
        endif
      endfor
      assign rv_avg = 0
      if rv_n > 0
        assign rv_avg = rv_sum | times: 1.0 | divided_by: rv_n | round: 1
      endif
      assign rv_avg_label = rv_avg | append: '' | replace: '.', ','
      unless rv_avg_label contains ','
        assign rv_avg_label = rv_avg_label | append: ',0'
      endunless
      assign rv_avg_pct = rv_avg | times: 20
      assign rv_limit = section.settings.per_page | default: 6
    -%}
    <div class="ec-w ec-rw" id="ec-reviews" data-ec-rw{% if rv_n > 0 %} data-count="{{ rv_n }}" data-avg="{{ rv_avg_label }}" data-pct="{{ rv_avg_pct }}"{% endif %}>
      {%- if section.settings.heading != blank -%}<h2 class="ec-h3 ec-rw__h">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.source_note != blank -%}<p class="ec-rw__src">{% render 'ecoms-icon', name: 'verified' %}{{ section.settings.source_note | escape }}</p>{%- endif -%}
      {%- if rv_n > 0 -%}
        <div class="ec-rw__sum">
          <div class="ec-rw__avg">
            <span class="ec-rw__big">{% render 'ecoms-icon', name: 'star' %}{{ rv_avg_label }}</span>
            <span class="ec-stars" style="--s: 18px; --r: {{ rv_avg_pct }}%" role="img" aria-label="{{ rv_avg_label }} de 5 estrellas"></span>
            <span class="ec-rw__n">{{ rv_n }} {% if rv_n == 1 %}reseña{% else %}reseñas{% endif %}</span>
          </div>
          <ul class="ec-rw__bars" role="list">
            {%- for st in (1..5) reversed -%}
              {%- case st -%}{%- when 5 -%}{%- assign cnt = c5 -%}{%- when 4 -%}{%- assign cnt = c4 -%}{%- when 3 -%}{%- assign cnt = c3 -%}{%- when 2 -%}{%- assign cnt = c2 -%}{%- else -%}{%- assign cnt = c1 -%}{%- endcase -%}
              {%- assign bar = cnt | times: 100 | divided_by: rv_n -%}
              <li>
                <span class="ec-stars" style="--s: 14px; --r: {{ st | times: 20 }}%" role="img" aria-label="{{ st }} estrellas"></span>
                <span class="ec-rw__bar"><i style="width: {{ bar }}%"></i></span>
                <span class="ec-rw__c">({{ cnt }})</span>
              </li>
            {%- endfor -%}
          </ul>
          {%- if section.settings.write_label != blank and section.settings.write_link != blank -%}
            <a class="ec-btn ec-rw__write" href="{{ section.settings.write_link }}">{{ section.settings.write_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ec-rw__grid">
        {%- assign shown = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="ec-revs__app">{% render block %}</div>
            {%- continue -%}
          {%- endif -%}
          {%- if block.type != 'review' or block.settings.text == blank -%}{%- continue -%}{%- endif -%}
          {%- if block.settings.example and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <article class="ec-rw__card{% if block.settings.example %} ec-rev--example{% endif %}"{% if shown > rv_limit %} hidden data-ec-rw-more{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.example -%}<span class="ec-rev__example">Ejemplo · no visible en la tienda</span>{%- endif -%}
            <div class="ec-rw__top">
              <b>{{ block.settings.author | escape }}</b>
              {%- if block.settings.verified -%}<span class="ec-rw__ver">{% render 'ecoms-icon', name: 'verified' %}Verificada</span>{%- endif -%}
            </div>
            {%- if block.settings.date != blank -%}<small class="ec-rw__date">{{ block.settings.date | escape }}</small>{%- endif -%}
            <span class="ec-stars" style="--s: 15px; --r: {{ block.settings.stars | times: 20 }}%" role="img" aria-label="{{ block.settings.stars }} de 5 estrellas"></span>
            <p class="ec-rw__text">{{ block.settings.text | escape | newline_to_br }}</p>
            {%- if block.settings.image != blank or block.settings.image_2 != blank or block.settings.image_3 != blank or block.settings.video != blank -%}
              <div class="ec-rw__media">
                {%- if block.settings.video != blank -%}
                  {%- assign vprev = block.settings.video.preview_image -%}
                  <button type="button" class="ec-rw__th ec-rw__th--video" data-ec-rw-open="video" data-src="{{ block.settings.video.sources | where: 'format', 'mp4' | map: 'url' | first | default: block.settings.video.sources[0].url }}" aria-label="Ver video de {{ block.settings.author | escape }}">
                    {%- if vprev != blank -%}{{ vprev | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                    <span class="ec-rw__play">{% render 'ecoms-icon', name: 'play' %}</span>
                  </button>
                {%- endif -%}
                {%- for k in (1..3) -%}
                  {%- if k == 1 -%}{%- assign ph = block.settings.image -%}{%- else -%}{%- assign key = 'image_' | append: k -%}{%- assign ph = block.settings[key] -%}{%- endif -%}
                  {%- if ph != blank -%}
                    <button type="button" class="ec-rw__th" data-ec-rw-open="image" data-src="{{ ph | image_url: width: 1400 }}" aria-label="Ver foto de {{ block.settings.author | escape }}">
                      {{ ph | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,240', sizes: '96px', alt: '' }}
                    </button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
      {%- if shown > rv_limit -%}
        <div class="ec-rw__morewrap"><button type="button" class="ec-btn ec-rw__write" data-ec-rw-showmore>Ver más reseñas</button></div>
      {%- endif -%}
      {%- if shown == 0 and request.design_mode -%}
        <p class="ec-editor-note">Agrega reseñas reales y autorizadas (bloque «Reseña real»). El promedio y las barras se calculan solos con esas reseñas.</p>
      {%- endif -%}
      <dialog class="ec-rw__lb" data-ec-rw-lb>
        <button type="button" class="ec-rw__x" data-ec-rw-close aria-label="Cerrar">{% render 'ecoms-icon', name: 'x' %}</button>
        <div class="ec-rw__lbin" data-ec-rw-lbin></div>
      </dialog>
    </div>
    <script>
      (function () {
        var root = document.currentScript.previousElementSibling;
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var lb = root.querySelector('[data-ec-rw-lb]');
        var box = root.querySelector('[data-ec-rw-lbin]');
        root.addEventListener('click', function (e) {
          var t = e.target.closest('[data-ec-rw-open]');
          if (t && lb && lb.showModal) {
            box.innerHTML = '';
            var el = document.createElement(t.dataset.ecRwOpen === 'video' ? 'video' : 'img');
            el.src = t.dataset.src;
            if (el.tagName === 'VIDEO') { el.controls = true; el.autoplay = true; el.playsInline = true; } else { el.alt = ''; }
            box.appendChild(el);
            lb.showModal();
            return;
          }
          if (e.target.closest('[data-ec-rw-close]') || e.target === lb) { lb.close(); box.innerHTML = ''; return; }
          var more = e.target.closest('[data-ec-rw-showmore]');
          if (more) {
            root.querySelectorAll('[data-ec-rw-more]').forEach(function (c) { c.hidden = false; });
            more.parentNode.remove();
          }
        });
        if (lb) lb.addEventListener('close', function () { box.innerHTML = ''; });
      })();
    </script>
  {%- else -%}
  <div class="ec-w">
    <div class="ec-rev-head ec-rev-head--{{ style }}">
      <div class="ec-rev-head__t">
        {%- if section.settings.heading != blank -%}
          <h2 class="ec-h3">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if product != blank -%}
          {%- render 'ecoms-rating', product: product, suffix: ' de 5' -%}
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="ec-btn ec-btn--ghost ec-btn--sm" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="ec-revs ec-revs--{{ style }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="ec-revs__app">{% render block %}</div>
          {%- when 'review' -%}
            {%- liquid
              assign show_review = false
              if block.settings.text != blank
                assign show_review = true
              endif
              if block.settings.example and request.design_mode == false
                assign show_review = false
              endif
            -%}
            {%- if show_review -%}
              {%- assign initials = block.settings.author | split: ' ' -%}
              <article class="ec-rev{% if block.settings.example %} ec-rev--example{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.example -%}<span class="ec-rev__example">Ejemplo · no visible en la tienda</span>{%- endif -%}
                <div class="ec-rev__who">
                  <span class="ec-avatar ec-avatar--{{ forloop.index0 | modulo: 5 }}" aria-hidden="true">
                    {%- for word in initials limit: 2 -%}{{ word | slice: 0 | upcase }}{%- endfor -%}
                  </span>
                  <div>
                    <b>
                      {{- block.settings.author | escape -}}
                      {%- if block.settings.verified %}{% render 'ecoms-icon', name: 'verified' %}<span class="visually-hidden">Compra verificada</span>{% endif -%}
                    </b>
                    <span class="ec-rev__meta">
                      {%- assign pct = block.settings.stars | times: 20 -%}
                      <span class="ec-stars" style="--s: 12px; --r: {{ pct }}%" role="img" aria-label="{{ block.settings.stars }} de 5 estrellas"></span>
                      {%- if block.settings.date != blank -%}<small>{{ block.settings.date | escape }}</small>{%- endif -%}
                    </span>
                  </div>
                </div>
                <p>{% if style != 'flex' %}“{% endif %}{{ block.settings.text | escape }}{% if style != 'flex' %}”{% endif %}</p>
                {%- if block.settings.image != blank or block.settings.image_2 != blank -%}
                  <div class="ec-rev__ph">
                    {%- for k in (1..3) -%}
                      {%- if k == 1 -%}{%- assign ph = block.settings.image -%}{%- else -%}{%- assign key = 'image_' | append: k -%}{%- assign ph = block.settings[key] -%}{%- endif -%}
                      {%- if ph != blank -%}
                        {{ ph | image_url: width: 500 | image_tag: loading: 'lazy', widths: '160,300,500', sizes: '(min-width: 990px) 220px, 90vw', alt: block.settings.author }}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </article>
            {%- endif -%}
          {%- when 'join' -%}
            <div class="ec-join" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
              {%- if block.settings.value != blank -%}<div><b>{{ block.settings.value | escape }}</b><br><span>{{ block.settings.label | escape }}</span></div>{%- endif -%}
              {%- if block.settings.quote != blank -%}<p>“{{ block.settings.quote | escape }}”</p>{%- endif -%}
              {%- if block.settings.show_stars -%}<span class="ec-stars" style="--r: 100%; --ec-star: #FFD21F" aria-hidden="true"></span>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- else -%}
        {%- if request.design_mode -%}
          <p class="ec-editor-note">Agrega reseñas reales y autorizadas, o el bloque de tu app de reseñas.</p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Reseñas",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "flex",
          "label": "Flex"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "direct",
          "label": "Direct"
        },
        {
          "value": "masonry",
          "label": "Muro de fotos (Landing)"
        },
        {
          "value": "widget",
          "label": "Resumen + tarjetas (tipo app)"
        }
      ],
      "default": "flex"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Reseñas de nuestros clientes"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Ver todas"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    },
    {
      "type": "header",
      "content": "Estilo «Resumen + tarjetas»"
    },
    {
      "type": "textarea",
      "id": "source_note",
      "label": "Origen de las reseñas",
      "info": "Ej.: Reseñas de compradores de este mismo producto en tiendas internacionales, traducidas al español."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Reseñas visibles antes de «Ver más»",
      "min": 2,
      "max": 20,
      "step": 2,
      "default": 6
    },
    {
      "type": "text",
      "id": "write_label",
      "label": "Botón para dejar reseña",
      "default": "Escribe una reseña"
    },
    {
      "type": "url",
      "id": "write_link",
      "label": "Enlace del botón",
      "info": "Ej.: tu página de contacto. El promedio y las barras se calculan solos con las reseñas reales de esta sección."
    },
    {
      "type": "paragraph",
      "content": "El promedio viene de los metacampos de tu app de reseñas. Las reseñas manuales deben ser reales y autorizadas."
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Reseña real",
      "settings": [
        {
          "type": "checkbox",
          "id": "example",
          "label": "Reseña de ejemplo (solo visible en el editor)",
          "default": false,
          "info": "Desmárcalo cuando reemplaces el contenido por una reseña real y autorizada."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nombre",
          "default": "Nombre del cliente"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Fecha (texto)",
          "default": "Hace 3 días"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Calificación",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonio"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Compra verificada",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto autorizada 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Foto 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Foto 3"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video autorizado"
        }
      ]
    },
    {
      "type": "join",
      "name": "Tarjeta comunidad",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Únete a nuestra comunidad"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Cifra real",
          "info": "Ej.: +1.200. Solo cifras verificables."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto bajo la cifra",
          "default": "clientes felices"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Frase de un cliente real"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Mostrar estrellas",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "ECOMS · Reseñas"
    }
  ]
}
{% endschema %}
