{%- comment -%}
  ECOMS · Reviews. Summary from the review app metafields; cards are authorised, real reviews
  entered by the merchant, or replaced by the review app's own block (@app).
{%- endcomment -%}
{%- assign has_rating = false -%}
{%- if product.metafields.reviews.rating.value != blank -%}{%- assign has_rating = true -%}{%- endif -%}
{%- if section.blocks.size > 0 or has_rating or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-reviews' %}>
  <div class="ec-w">
    <div class="ec-rev-head">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="ec-h3">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if product != blank -%}
          {%- render 'ecoms-rating', product: product, suffix: ' de 5' -%}
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="ec-btn ec-btn--ghost ec-btn--sm" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="ec-revs">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="ec-revs__app">{% render block %}</div>
          {%- when 'review' -%}
            {%- if block.settings.text != blank -%}
              <article class="ec-rev" {{ block.shopify_attributes }}>
                <div class="ec-rev__who">
                  <span class="ec-avatar" aria-hidden="true">{{ block.settings.author | slice: 0 | upcase }}</span>
                  <div>
                    <b>
                      {{- block.settings.author | escape -}}
                      {%- if block.settings.verified %}{% render 'ecoms-icon', name: 'verified' %}<span class="visually-hidden">Compra verificada</span>{% endif -%}
                    </b>
                    {%- if block.settings.date != blank -%}
                      <small>{{ block.settings.date | escape }}</small>
                    {%- endif -%}
                  </div>
                </div>
                {%- assign pct = block.settings.stars | times: 20 -%}
                <span class="ec-stars" style="--s: 12px; --r: {{ pct }}%" role="img" aria-label="{{ block.settings.stars }} de 5 estrellas"></span>
                <p>{{ block.settings.text | escape }}</p>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 200px, 90vw', alt: block.settings.author
                  }}
                {%- endif -%}
              </article>
            {%- endif -%}
        {%- endcase -%}
      {%- else -%}
        {%- if request.design_mode -%}
          <p class="ec-editor-note">Agrega reseñas reales y autorizadas, o el bloque de tu app de reseñas.</p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Reseñas",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Reseñas de nuestros clientes"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Ver todas"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    },
    {
      "type": "paragraph",
      "content": "El promedio viene de los metacampos de tu app de reseñas. Las reseñas manuales deben ser reales y autorizadas."
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Reseña real",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Nombre",
          "default": "Nombre del cliente"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Fecha (texto)",
          "default": "Hace 3 días"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Calificación",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonio"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto autorizada"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Compra verificada",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "ECOMS · Reseñas"
    }
  ]
}
{% endschema %}
