{%- comment -%} ECOMS · Cross-sell with real add-to-cart (AJAX Cart API). Styles: cards (Flex), grid (Brand), rail (Direct). {%- endcomment -%}
{%- assign style = section.settings.style | default: 'cards' -%}
{%- if section.settings.products != blank or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-cross' %}>
  <div class="ec-w">
    <div class="ec-cross__wrap ec-cross--{{ style }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="ec-h3{% if style == 'grid' %} ec-h3--center{% endif %}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.products != blank -%}
        <div class="ec-xs">
          {%- assign shown = 0 -%}
          {%- assign split_at = section.settings.split | plus: 1 -%}
          {%- for item in section.settings.products -%}
            {%- if item.id == product.id or shown >= section.settings.limit -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- if style == 'rail' and section.settings.heading_2 != blank and shown == split_at -%}
              </div><h2 class="ec-h3">{{ section.settings.heading_2 | escape }}</h2><div class="ec-xs">
            {%- endif -%}
            <div class="ec-xs__card">
              <a href="{{ item.url }}" class="ec-xs__media" tabindex="-1" aria-hidden="true">
                {%- if item.featured_image != blank -%}
                  {{ item.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '120,240,400', sizes: '(min-width: 990px) 260px, 45vw', alt: '' }}
                {%- endif -%}
              </a>
              <div class="ec-xs__body">
                <a href="{{ item.url }}" class="ec-xs__name">{{ item.title | escape }}</a>
                <span class="ec-xs__p">
                  {{- item.price | money -}}
                  {%- if item.compare_at_price > item.price %} <s class="ec-strike">{{ item.compare_at_price | money }}</s>{% endif -%}
                </span>
              </div>
              {%- liquid
                assign btn_class = 'ec-btn ec-btn--ghost ec-btn--sm'
                if style != 'cards'
                  assign btn_class = 'ec-btn ec-btn--primary ec-btn--sm'
                endif
              -%}
              {%- render 'ecoms-add-button', item: item, label: section.settings.button_label, class: btn_class, source: 'cross_sell_section' -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="ec-editor-note">Selecciona productos complementarios reales del catálogo.</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Cross-sell",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "cards",
          "label": "Tarjetas (Flex)"
        },
        {
          "value": "grid",
          "label": "Grilla 4 (Brand)"
        },
        {
          "value": "rail",
          "label": "Columna destacada (Direct)"
        }
      ],
      "default": "cards"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "También te puede gustar"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Productos",
      "limit": 6
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Máximo a mostrar",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Agregar"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Segundo título (Direct)",
      "info": "Ej.: Productos relacionados"
    },
    {
      "type": "range",
      "id": "split",
      "label": "Productos antes del segundo título",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "ECOMS · Cross-sell"
    }
  ]
}
{% endschema %}
