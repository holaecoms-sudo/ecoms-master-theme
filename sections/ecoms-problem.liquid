{%- comment -%} ECOMS · Problem → solution (Direct): copy + before/after, benefit icons, real customer quote on a photo. {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-problem' %}>
  <div class="ec-w">
    <div class="ec-prob">
      <div class="ec-prob__txt">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="ec-prob__p rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.before != blank or section.settings.after != blank -%}
          <div class="ec-baimg">
            <figure>
              {%- if section.settings.before != blank -%}
                {{ section.settings.before | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 200px, 45vw', alt: section.settings.before_label }}
              {%- endif -%}
              <figcaption><b>{{ section.settings.before_label | escape }}</b>{{ section.settings.before_caption | escape }}</figcaption>
            </figure>
            <span class="ec-baimg__arrow" aria-hidden="true">{% render 'ecoms-icon', name: 'arrow' %}</span>
            <figure>
              {%- if section.settings.after != blank -%}
                {{ section.settings.after | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 200px, 45vw', alt: section.settings.after_label }}
              {%- endif -%}
              <figcaption><b>{{ section.settings.after_label | escape }}</b>{{ section.settings.after_caption | escape }}</figcaption>
            </figure>
          </div>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="ec-dben">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}><span class="ec-ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>{{ block.settings.text | escape }}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- assign hand = section.settings.image | default: product.images[1] | default: product.featured_image -%}
      {%- if hand != blank -%}
        <div class="ec-hand">
          {{ hand | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 380px, 100vw', alt: '' }}
          {%- if section.settings.quote != blank -%}
            <blockquote>“{{ section.settings.quote | escape }}”<br><span class="ec-stars" style="--s: 12px; --r: 100%" aria-hidden="true"></span></blockquote>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

