{%- comment -%} ECOMS · Comparison table. Every row must be verifiable before publishing. {%- endcomment -%}
{%- liquid
  assign cols = 1
  if section.settings.col_2 != blank
    assign cols = 2
  endif
  if section.settings.col_3 != blank
    assign cols = 3
  endif
-%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-compare' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <h2 class="ec-h3{% if section.settings.width == 'full' %} ec-h3--center{% endif %}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.style == 'vs' -%}
      {%- comment -%} VS cards: the alternative (col 2) vs this product (col 1), same verifiable rows. {%- endcomment -%}
      <div class="ec-vs">
        <div class="ec-vs__card ec-vs__card--them">
          <p class="ec-vs__h">{{ section.settings.col_2 | escape }}</p>
          <ul role="list">
            {%- for block in section.blocks -%}
              <li class="{% if block.settings.value_2 %}y{% else %}n{% endif %}">
                {%- if block.settings.value_2 -%}{% render 'ecoms-icon', name: 'check' %}{%- else -%}{% render 'ecoms-icon', name: 'x' %}{%- endif -%}
                <span>{{ block.settings.feature | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
        <span class="ec-vs__vs" aria-hidden="true">VS</span>
        <div class="ec-vs__card ec-vs__card--us">
          {%- if section.settings.show_image and product.featured_image != blank -%}
            {{ product.featured_image | image_url: width: 160 | image_tag: class: 'ec-vs__img', loading: 'lazy', width: 56, height: 56, alt: '' }}
          {%- endif -%}
          <p class="ec-vs__h">{{ section.settings.col_1 | escape }}</p>
          <ul role="list">
            {%- for block in section.blocks -%}
              <li class="{% if block.settings.value_1 %}y{% else %}n{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.value_1 -%}{% render 'ecoms-icon', name: 'check' %}{%- else -%}{% render 'ecoms-icon', name: 'x' %}{%- endif -%}
                <span>{{ block.settings.feature | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- else -%}
    <div class="ec-cmp-wrap">
      <table class="ec-cmp">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.feature_label | escape }}</th>
            <th scope="col" class="us">
              {%- if section.settings.show_image and product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 120 | image_tag: class: 'ec-cmp__img', loading: 'lazy', width: 44, height: 44, alt: '' }}
              {%- endif -%}
              {{- section.settings.col_1 | escape -}}
            </th>
            {%- if cols > 1 %}<th scope="col">{{ section.settings.col_2 | escape }}</th>{% endif -%}
            {%- if cols > 2 %}<th scope="col">{{ section.settings.col_3 | escape }}</th>{% endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature | escape }}</th>
              {%- for c in (1..cols) -%}
                {%- assign key = 'value_' | append: c -%}
                {%- assign yes = block.settings[key] -%}
                <td class="{% if yes %}y{% else %}n{% endif %}{% if c == 1 %} us{% endif %}">
                  {%- if yes -%}{% render 'ecoms-icon', name: 'check' %}{%- else -%}{% render 'ecoms-icon', name: 'x' %}{%- endif -%}
                  <span class="visually-hidden">{% if yes %}Sí{% else %}No{% endif %}</span>
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ECOMS · Tabla comparativa",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "table",
          "label": "Tabla"
        },
        {
          "value": "vs",
          "label": "Tarjetas VS (alternativa vs producto)"
        }
      ],
      "default": "table"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Por qué elegirnos?"
    },
    {
      "type": "text",
      "id": "feature_label",
      "label": "Encabezado de características",
      "default": "Característica"
    },
    {
      "type": "text",
      "id": "col_1",
      "label": "Columna 1 (tu producto)",
      "default": "Nuestro producto"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Foto del producto sobre la columna",
      "default": true
    },
    {
      "type": "text",
      "id": "col_2",
      "label": "Columna 2",
      "default": "Otras opciones"
    },
    {
      "type": "text",
      "id": "col_3",
      "label": "Columna 3 (opcional)"
    },
    {
      "type": "paragraph",
      "content": "Valida cada fila antes de publicar: solo afirmaciones comprobables."
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Fila",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Característica",
          "default": "Característica comprobable"
        },
        {
          "type": "checkbox",
          "id": "value_1",
          "label": "Columna 1",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "value_2",
          "label": "Columna 2",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "value_3",
          "label": "Columna 3",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "ECOMS · Tabla comparativa",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
