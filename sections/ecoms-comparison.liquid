{% if section.blocks.size > 0 or request.design_mode %}
<section class="ecoms-section ecoms-comparison" id="ecoms-comparison-{{ section.id }}"><div class="page-width">
 <h2 class="ecoms-section-title">{{ section.settings.heading | escape }}</h2>
 {% if section.blocks.size > 0 %}<div class="ecoms-table-scroll"><table class="ecoms-table"><thead><tr><th scope="col">Característica</th><th scope="col">{{ section.settings.us | escape }}</th><th scope="col">{{ section.settings.them | escape }}</th></tr></thead>
 <tbody>{% for block in section.blocks %}<tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.feature | escape }}</th><td class="ecoms-table__us">{% if block.settings.ours %}✓{% else %}—{% endif %}</td><td>{% if block.settings.others %}✓{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
 </div></section>
{% endif %}
{% schema %}
{"name":"ECOMS · Comparación","settings":[{"type":"text","id":"heading","label":"Título","default":"¿Por qué elegir este producto?"},{"type":"text","id":"us","label":"Nuestra columna","default":"Este producto"},{"type":"text","id":"them","label":"Columna alternativa","default":"Otras opciones"}],"blocks":[{"type":"row","name":"Característica","settings":[{"type":"text","id":"feature","label":"Característica","default":"Característica comprobable"},{"type":"checkbox","id":"ours","label":"La incluye nuestro producto","default":true},{"type":"checkbox","id":"others","label":"La incluyen otros","default":false}]}],"max_blocks":10,"presets":[{"name":"ECOMS · Comparación"}]}
{% endschema %}
