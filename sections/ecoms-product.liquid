{%- comment -%}
  ECOMS · Product hero, built 1:1 from the ECOMS MASTER mockup (Flex, Brand, Direct).
  Uses Shopify's native product form ({% form 'product' %}), real variants, real prices and the
  AJAX Cart API + Dawn's cart drawer. Without JavaScript the form still posts to /cart/add.
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'EcForm-' | append: section.id
  assign media_count = product.media.size
  assign first_media = variant.featured_media | default: product.featured_media
  assign feature_block = section.blocks | where: 'type', 'media_features' | first
  assign variants_block = section.blocks | where: 'type', 'variants' | first
  assign has_variants_block = false
  if variants_block
    assign has_variants_block = true
  endif

  # Gallery order: demo videos first when enabled (same order for slides and thumbnails).
  assign gallery_media = product.media
  if section.settings.video_first
    assign gm_videos = product.media | where: 'media_type', 'video'
    assign gm_external = product.media | where: 'media_type', 'external_video'
    assign gm_images = product.media | where: 'media_type', 'image'
    assign gm_models = product.media | where: 'media_type', 'model'
    assign gallery_media = gm_videos | concat: gm_external | concat: gm_images | concat: gm_models
  endif
  # «auto» keeps the template's own ratio (Brand 4:5, Direct 1:1.08, Flex 1:1).
  assign gal_ratio = ''
  case section.settings.media_ratio
    when 'square'
      assign gal_ratio = '1 / 1'
    when 'portrait'
      assign gal_ratio = '4 / 5'
    when 'landscape'
      assign gal_ratio = '4 / 3'
  endcase

  # Starting pack (Theme Editor «Pack seleccionado al cargar»): the form, CTA and sticky bar are
  # server-rendered with it, so the first paint and the no-JS fallback match the selected pack.
  assign start_qty = 1
  assign start_total = variant.price
  assign start_label = ''
  assign start_unit_name = ''
  assign packs_block = section.blocks | where: 'type', 'packs' | first
  assign pk_mf_pct = product.metafields.ecoms.pack2_pct.value | default: 0 | plus: 0
  if packs_block and packs_block.settings.from_metafield and pk_mf_pct == 0
    assign packs_block = nil
  endif
  if packs_block
    assign ps = packs_block.settings
    assign start_unit_name = ps.item_name | strip
    if ps.from_metafield
      assign start_unit_name = product.metafields.ecoms.unit_name.value | default: start_unit_name | strip
    endif
    assign start_tier = ps.default_tier | default: '1' | plus: 0
    if start_tier > 1
      assign start_on = 'tier' | append: start_tier | append: '_enabled'
      if ps[start_on] != true
        assign start_tier = 1
      endif
    endif
    assign start_pct = 0
    if start_tier == 1
      assign start_qty = ps.tier1_qty | default: 1
    else
      assign start_q_key = 'tier' | append: start_tier | append: '_qty'
      assign start_p_key = 'tier' | append: start_tier | append: '_pct'
      assign start_qty = ps[start_q_key] | default: start_tier
      if ps.discounts_live
        assign start_pct = ps[start_p_key] | default: 0
      endif
      if ps.from_metafield
        assign start_pct = 0
        if start_tier == 2
          assign start_pct = pk_mf_pct
        elsif start_tier == 3
          assign start_pct = product.metafields.ecoms.pack3_pct.value | default: 0 | plus: 0
        endif
      endif
    endif
    assign start_label_key = 'tier' | append: start_tier | append: '_label'
    assign start_label = ps[start_label_key]
    assign start_sub = variant.price | times: start_qty
    assign start_discount = start_sub | times: start_pct | divided_by: 10000.0 | round | times: 100
    assign start_total = start_sub | minus: start_discount
  endif
-%}
{%- comment -%} Page palette: overrides the store colors only on pages using this template (e.g. a cleaning category). {%- endcomment -%}
{%- liquid
  assign pal = section.settings.palette | default: 'store'
-%}
{%- if pal != 'store' -%}
  <style>
    :root {
      --ec-primary:       {%- case pal -%}{%- when 'agua' -%}#0B2E4F{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_primary | default: settings.ecoms_primary }}{%- endcase -%};
      --ec-primary-ink:       {%- case pal -%}{%- when 'agua' -%}#FFFFFF{%- when 'grafito' -%}#FFFFFF{%- else -%}{{ section.settings.pal_primary_ink | default: settings.ecoms_primary_ink }}{%- endcase -%};
      --ec-dark:       {%- case pal -%}{%- when 'agua' -%}#0B2E4F{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_dark | default: settings.ecoms_dark }}{%- endcase -%};
      --ec-accent:       {%- case pal -%}{%- when 'agua' -%}#14B8C9{%- when 'grafito' -%}#F2643D{%- else -%}{{ section.settings.pal_accent | default: settings.ecoms_accent }}{%- endcase -%};
      --ec-accent-ink:       {%- case pal -%}{%- when 'agua' -%}#06283A{%- when 'grafito' -%}#FFFFFF{%- else -%}{{ section.settings.pal_accent_ink | default: settings.ecoms_accent_ink }}{%- endcase -%};
      --ec-soft:       {%- case pal -%}{%- when 'agua' -%}#E9F7FA{%- when 'grafito' -%}#F5F3F0{%- else -%}{{ section.settings.pal_soft | default: settings.ecoms_soft }}{%- endcase -%};
      --ec-soft-ink:       {%- case pal -%}{%- when 'agua' -%}#0B2E4F{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_soft_ink | default: settings.ecoms_soft_ink }}{%- endcase -%};
      --ec-tag:       {%- case pal -%}{%- when 'agua' -%}#14B8C9{%- when 'grafito' -%}#F2643D{%- else -%}{{ section.settings.pal_tag | default: settings.ecoms_tag }}{%- endcase -%};
      --ec-tag-ink:       {%- case pal -%}{%- when 'agua' -%}#06283A{%- when 'grafito' -%}#FFFFFF{%- else -%}{{ section.settings.pal_tag_ink | default: settings.ecoms_tag_ink }}{%- endcase -%};
      --ec-sale-bg:       {%- case pal -%}{%- when 'agua' -%}#E0F5F8{%- when 'grafito' -%}#FDEBE5{%- else -%}{{ section.settings.pal_sale_bg | default: settings.ecoms_sale_bg }}{%- endcase -%};
      --ec-sale-ink:       {%- case pal -%}{%- when 'agua' -%}#0B4F63{%- when 'grafito' -%}#9A3412{%- else -%}{{ section.settings.pal_sale_ink | default: settings.ecoms_sale_ink }}{%- endcase -%};
      --ec-urgent:       {%- case pal -%}{%- when 'agua' -%}#B54708{%- when 'grafito' -%}#B54708{%- else -%}{{ section.settings.pal_urgent | default: settings.ecoms_urgent }}{%- endcase -%};
      --ec-urgent-bg:       {%- case pal -%}{%- when 'agua' -%}#FFF4E5{%- when 'grafito' -%}#FFF4E5{%- else -%}{{ section.settings.pal_urgent_bg | default: settings.ecoms_urgent_bg }}{%- endcase -%};
      --ec-bg:       {%- case pal -%}{%- when 'agua' -%}#FFFFFF{%- when 'grafito' -%}#FFFFFF{%- else -%}{{ section.settings.pal_bg | default: settings.ecoms_bg }}{%- endcase -%};
      --ec-ink:       {%- case pal -%}{%- when 'agua' -%}#0F1B2A{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_ink | default: settings.ecoms_ink }}{%- endcase -%};
      --ec-muted:       {%- case pal -%}{%- when 'agua' -%}#5B6B7B{%- when 'grafito' -%}#6B6B6B{%- else -%}{{ section.settings.pal_muted | default: settings.ecoms_muted }}{%- endcase -%};
      --ec-line:       {%- case pal -%}{%- when 'agua' -%}#E2E8EF{%- when 'grafito' -%}#E8E5E1{%- else -%}{{ section.settings.pal_line | default: settings.ecoms_line }}{%- endcase -%};
      --ec-deep:       {%- case pal -%}{%- when 'agua' -%}#0B2E4F{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_deep | default: settings.ecoms_deep }}{%- endcase -%};
      --ec-primary-hover: color-mix(in srgb, var(--ec-primary) 86%, #000);
    }
    body.ec-skin { background: var(--ec-bg); }
  </style>
{%- endif -%}
<section
  id="EcProduct-{{ section.id }}"
  class="ec-pdp ec-pdp--{{ section.settings.layout }} ec-pdp--thumbs-{{ section.settings.thumbs | default: 'auto' }} ec-pdp--bg-{{ section.settings.hero_bg | default: 'none' }} ec-pdp--cols-{{ section.settings.columns | default: 'auto' }} ec-pdp--gm-{{ section.settings.gallery_mobile | default: 'full' }}"
  data-ec-product
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  style="--ec-pt: {{ section.settings.padding_top }}px; --ec-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ec-w ec-pdp__grid">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="ec-pdp__media">
      <div class="ec-gal" data-ec-gal style="{% if gal_ratio != blank %}--gal-ratio: {{ gal_ratio }}; {% endif %}--gal-fit: {{ section.settings.media_fit | default: 'cover' }};">
        <div class="ec-gal__main">
          <div class="ec-gal__track" data-ec-gal-track tabindex="0" aria-label="Galería de {{ product.title | escape }}">
            {%- for media in gallery_media -%}
              <div class="ec-gal__slide" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'video' -%}
                    {{
                      media
                      | video_tag: controls: false, muted: true, playsinline: true, autoplay: section.settings.video_autoplay, loop: section.settings.video_loop, preload: 'metadata', image_size: '1200x', class: 'ec-gal__video'
                    }}
                    <button type="button" class="ec-gal__play" data-ec-play aria-label="Reproducir video con sonido"{% if section.settings.video_autoplay %} data-autoplay{% endif %}>
                      {% render 'ecoms-icon', name: 'play' %}
                    </button>
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 'ec-gal__video', loading: 'lazy' }}
                  {%- else -%}
                    {%- liquid
                      assign img_loading = 'lazy'
                      assign img_priority = 'auto'
                      if forloop.first
                        assign img_loading = 'eager'
                        assign img_priority = 'high'
                      endif
                      assign img_alt = media.alt | default: product.title
                    -%}
                    {{
                      media.preview_image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '400,600,800,1000,1200,1400',
                        sizes: '(min-width: 990px) 560px, 100vw',
                        loading: img_loading,
                        fetchpriority: img_priority,
                        alt: img_alt
                    }}
                {%- endcase -%}
              </div>
            {%- else -%}
              <div class="ec-gal__slide">{{ 'product-1' | placeholder_svg_tag: 'ec-placeholder' }}</div>
            {%- endfor -%}
          </div>
          {%- if section.settings.badge != blank -%}
            <span class="ec-gal__badge ec-tag">{{ section.settings.badge | escape }}</span>
          {%- endif -%}
          {%- if media_count > 1 -%}
            <button type="button" class="ec-gal__arrow ec-gal__arrow--prev" data-ec-gal-step="-1" aria-label="Imagen anterior">
              {% render 'ecoms-icon', name: 'chev-l' %}
            </button>
            <button type="button" class="ec-gal__arrow ec-gal__arrow--next" data-ec-gal-step="1" aria-label="Imagen siguiente">
              {% render 'ecoms-icon', name: 'chev-r' %}
            </button>
            <span class="ec-gal__count" data-ec-gal-count>1 / {{ media_count }}</span>
          {%- endif -%}
        </div>
        {%- if media_count > 1 -%}
          <ul class="ec-gal__thumbs" role="list">
            {%- for media in gallery_media -%}
              <li>
                <button
                  type="button"
                  class="ec-gal__thumb"
                  data-ec-gal-to="{{ forloop.index0 }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="Ver imagen {{ forloop.index }}"
                >
                  {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="ec-gal__thumb-play">{% render 'ecoms-icon', name: 'play' %}</span>
                  {%- endif -%}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if feature_block -%}
        {%- render 'ecoms-media-features', block: feature_block, product: product -%}
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Info + buy box ---------- {%- endcomment -%}
    <div class="ec-pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'buybox' -%}
            {%- comment -%} Everything after this block renders in the buy box (Direct: third column). {%- endcomment -%}
            </div>
            <div class="ec-pdp__buy" {{ block.shopify_attributes }}>

          {%- when 'eyebrow' -%}
            {%- comment -%} Per-product metafield ecoms.eyebrow wins over the template text. {%- endcomment -%}
            {%- assign eyebrow_text = product.metafields.ecoms.eyebrow.value | default: block.settings.text -%}
            {%- if eyebrow_text != blank -%}
              <p class="ec-eyebrow" {{ block.shopify_attributes }}>{{ eyebrow_text | escape }}</p>
            {%- endif -%}

          {%- when 'rating' -%}
            {%- render 'ecoms-rating', product: product, block: block -%}

          {%- when 'title' -%}
            <h1 class="ec-pdp__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'text' -%}
            {%- comment -%} Per-product copy: metafield ecoms.subtitle wins over the template text. {%- endcomment -%}
            {%- assign sub_mf = product.metafields.ecoms.subtitle.value -%}
            {%- if sub_mf != blank -%}
              <div class="ec-pdp__sub" {{ block.shopify_attributes }}>{{ product.metafields.ecoms.subtitle | metafield_tag }}</div>
            {%- elsif block.settings.text != blank -%}
              <div class="ec-pdp__sub" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="ec-pdp__desc rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'benefits' -%}
            {%- comment -%} Per-product list: metafield ecoms.benefits (list of single-line text) wins. {%- endcomment -%}
            {%- assign benefits_mf = product.metafields.ecoms.benefits.value -%}
            <ul class="ec-checks" role="list" {{ block.shopify_attributes }}>
              {%- if benefits_mf != blank -%}
                {%- for item in benefits_mf -%}
                  <li>{% render 'ecoms-icon', name: 'check' %}<span>{{ item | escape }}</span></li>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..6) -%}
                  {%- assign key = 'item_' | append: i -%}
                  {%- if block.settings[key] != blank -%}
                    <li>{% render 'ecoms-icon', name: 'check' %}<span>{{ block.settings[key] | escape }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>

          {%- when 'price' -%}
            <div id="EcPrice-{{ section.id }}" class="ec-pdp__price" data-ec-refresh {{ block.shopify_attributes }}>
              {%- render 'ecoms-price', variant: variant, style: block.settings.style, qty: start_qty, total: start_total, unit_name: start_unit_name -%}
            </div>
            {%- comment -%}
              Shipping line under the price: the real standard rate (block setting) and the free-shipping
              threshold (theme setting), so the delivered total is clear before the cart. ecoms.js keeps it in
              sync with the selected pack.
            {%- endcomment -%}
            {%- assign ship_cost = block.settings.shipping_cost | default: 0 | plus: 0 | times: 100 -%}
            {%- if ship_cost > 0 -%}
              {%- liquid
                assign ship_free_at = 0
                if settings.ecoms_free_shipping_live
                  assign ship_free_at = settings.ecoms_free_shipping_threshold | plus: 0
                  if ship_free_at < 1000
                    assign ship_free_at = ship_free_at | times: 1000
                  endif
                  assign ship_free_at = ship_free_at | times: 100
                endif
                assign ship_is_free = false
                if ship_free_at > 0 and start_total >= ship_free_at
                  assign ship_is_free = true
                endif
                # Lower free-shipping amount for one zone (theme setting), e.g. Región Metropolitana.
                assign ship_local_at = 0
                if ship_free_at > 0
                  assign ship_local_at = settings.ecoms_free_shipping_local_threshold | plus: 0 | times: 100
                endif
                assign ship_zone = settings.ecoms_free_shipping_local_zone | escape
                assign ship_is_local = false
                if ship_local_at > 0 and ship_is_free == false and start_total >= ship_local_at
                  assign ship_is_local = true
                endif
              -%}
              <p class="ec-shipline{% if ship_is_free or ship_is_local %} is-free{% endif %}" data-ec-shipline data-cost="{{ ship_cost }}" data-free-at="{{ ship_free_at }}" data-local-at="{{ ship_local_at }}">
                {% render 'ecoms-icon', name: 'truck' %}
                <span data-ec-shipline-paid {% if ship_is_free or ship_is_local %}hidden{% endif %}>Envío {{ ship_cost | money }} · Total <b data-ec-shipline-total>{{ start_total | plus: ship_cost | money }}</b>
                  {%- if ship_local_at > 0 -%}
                    <small>Gratis en {{ ship_zone }} desde {{ ship_local_at | money }} · regiones desde {{ ship_free_at | money }}</small>
                  {%- elsif ship_free_at > 0 -%}
                    <small>Gratis desde {{ ship_free_at | money }}</small>
                  {%- endif -%}
                </span>
                {%- if ship_local_at > 0 -%}
                  <span data-ec-shipline-local {% unless ship_is_local %}hidden{% endunless %}><b>Envío gratis en {{ ship_zone }}</b><small>Regiones: envío {{ ship_cost | money }} · gratis desde {{ ship_free_at | money }}</small></span>
                {%- endif -%}
                <span data-ec-shipline-free {% unless ship_is_free %}hidden{% endunless %}><b>Envío gratis</b> a todo Chile</span>
              </p>
              {%- if settings.ecoms_cod_live and settings.ecoms_cod_short != blank -%}
                <p class="ec-codline">{% render 'ecoms-icon', name: 'cash' %}<span><b>{{ settings.ecoms_cod_short | escape }}</b>{%- if settings.ecoms_cod_detail != blank -%}<small>{{ settings.ecoms_cod_detail | escape }}</small>{%- endif -%}</span></p>
              {%- endif -%}
            {%- endif -%}

          {%- when 'urgency' -%}
            {%- comment -%} Per-product end date (ecoms.offer_end) wins over the block date, so a shared template only times real promos {%- endcomment -%}
            {%- render 'ecoms-countdown', source: block, end_at: product.metafields.ecoms.offer_end.value, heading: product.metafields.ecoms.offer_label.value, attrs: block.shopify_attributes -%}

          {%- when 'buy' -%}
            {%- liquid
              # «Solo pago al recibir»: the cash on delivery app's button is the only way to buy here, so our
              # add-to-cart button (and the heading that explains it) is hidden; the product form stays for the app.
              assign buy_cod_only = false
              if settings.ecoms_cod_live and block.settings.cod_only
                assign buy_cod_only = true
              endif
            -%}
            <div class="ec-buy{% if buy_cod_only %} ec-buy--cod-only{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank and buy_cod_only == false -%}<p class="ec-buy__h">{{ block.settings.heading | escape }}</p>{%- endif -%}
              {%- form 'product', product, id: form_id, class: 'ec-form', novalidate: 'novalidate', data-ec-form: '' -%}
                <input type="hidden" name="id" value="{{ variant.id }}" data-ec-variant-input>
                <div class="ec-optrow">
                  {%- unless has_variants_block -%}{%- render 'ecoms-variant-picker', product: product, section_id: section.id -%}{%- endunless -%}
                  {%- if block.settings.show_quantity -%}
                    <div class="ec-qty-wrap">
                      <label class="ec-lbl" for="EcQty-{{ section.id }}">Cantidad:</label>
                      <div class="ec-qty" data-ec-qty>
                        <button type="button" data-ec-qty-step="-1" aria-label="Restar una unidad">{% render 'ecoms-icon', name: 'minus' %}</button>
                        <input
                          id="EcQty-{{ section.id }}"
                          type="number"
                          name="quantity"
                          value="{{ start_qty }}"
                          min="1"
                          {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %}
                          inputmode="numeric"
                          data-ec-qty-input
                        >
                        <button type="button" data-ec-qty-step="1" aria-label="Sumar una unidad">{% render 'ecoms-icon', name: 'plus' %}</button>
                      </div>
                    </div>
                  {%- else -%}
                    <input type="hidden" name="quantity" value="{{ start_qty }}" data-ec-qty-input>
                  {%- endif -%}
                </div>

                <div id="EcButtons-{{ section.id }}" class="ec-buy__buttons" data-ec-refresh>
                  <button
                    type="submit"
                    name="add"
                    class="ec-btn ec-btn--primary ec-btn--block ec-btn--lg"
                    data-ec-add
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {% render 'ecoms-icon', name: 'cart' %}
                    <span>
                      {%- if variant.available -%}
                        {%- if settings.ecoms_cod_live and block.settings.add_label_cod != blank -%}{{ block.settings.add_label_cod | escape }}{%- else -%}{{ block.settings.add_label | escape }}{%- endif -%}
                        {%- if block.settings.show_total %} · <span data-ec-cta-total>{{ start_total | money }}</span>{% endif -%}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {%- if block.settings.show_buy_now and variant.available -%}
                    <button type="button" class="ec-btn ec-btn--accent ec-btn--block ec-btn--lg" data-ec-buy-now data-form="{{ form_id }}">
                      {%- if block.settings.buy_now_icon != 'none' -%}{% render 'ecoms-icon', name: block.settings.buy_now_icon %}{%- endif -%}
                      {%- if settings.ecoms_cod_live and block.settings.buy_now_label_cod != blank -%}{{ block.settings.buy_now_label_cod | escape }}{%- else -%}{{ block.settings.buy_now_label | escape }}{%- endif -%}
                    </button>
                  {%- endif -%}
                </div>
                <p class="ec-form__error" role="alert" data-ec-form-error hidden></p>
              {%- endform -%}
              <script type="application/json" data-ec-product-json>
                {{ product | json }}
              </script>
            </div>

          {%- when 'chips' -%}
            {%- comment -%} Spec pills under the title (e.g. IPX7 · 90 min · USB-C). Empty pills are skipped. {%- endcomment -%}
            {%- assign chips_mf = product.metafields.ecoms.chips.value -%}
            {%- capture chips -%}
              {%- if chips_mf != blank -%}
                {%- for chip in chips_mf limit: 5 -%}<li>{{ chip | escape }}</li>{%- endfor -%}
              {%- else -%}
              {%- for i in (1..5) -%}
                {%- assign key = 'chip_' | append: i -%}
                {%- if block.settings[key] != blank -%}<li>{{ block.settings[key] | escape }}</li>{%- endif -%}
              {%- endfor -%}
              {%- endif -%}
            {%- endcapture -%}
            {%- if chips != blank -%}
              <ul class="ec-chips" role="list" {{ block.shopify_attributes }}>{{ chips }}</ul>
            {%- endif -%}

          {%- when 'includes' -%}
            {%- comment -%}
              Compact «Tu compra incluye» list for the buy box (only pieces that really ship).
              Product metafield ecoms.includes (list of «Ítem de contenido») replaces the block rows.
            {%- endcomment -%}
            {%- assign incl_mf = product.metafields.ecoms.includes.value -%}
            {%- if incl_mf != blank or block.settings.title_1 != blank -%}
            <div class="ec-incl-mini" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<p class="ec-incl-mini__h">{{ block.settings.heading | escape }}</p>{%- endif -%}
              <ul role="list">
                {%- if incl_mf != blank -%}
                  {%- for item in incl_mf limit: 6 -%}
                    {%- if item.title == blank -%}{%- continue -%}{%- endif -%}
                    <li>
                      {%- if item.image != blank -%}
                        {{ item.image.value | image_url: width: 96 | image_tag: loading: 'lazy', width: 36, height: 36, alt: '' }}
                      {%- else -%}
                        <span class="ec-incl-mini__ic">{% render 'ecoms-icon', name: item.icon.value %}</span>
                      {%- endif -%}
                      <span class="ec-incl-mini__t">
                        {%- if item.qty != blank %}<b data-ec-incl-qty="{{ item.qty.value | escape }}">{{ item.qty.value | escape }}</b> {% endif -%}
                        {{- item.title.value | escape -}}
                      </span>
                      {%- if item.badge != blank -%}<em>{{ item.badge.value | escape }}</em>{%- endif -%}
                    </li>
                  {%- endfor -%}
                {%- else -%}
                {%- for i in (1..6) -%}
                  {%- liquid
                    assign t_key = 'title_' | append: i
                    assign q_key = 'qty_' | append: i
                    assign b_key = 'badge_' | append: i
                    assign i_key = 'icon_' | append: i
                    assign img_key = 'image_' | append: i
                  -%}
                  {%- if block.settings[t_key] != blank -%}
                    <li>
                      {%- if block.settings[img_key] != blank -%}
                        {{ block.settings[img_key] | image_url: width: 96 | image_tag: loading: 'lazy', width: 36, height: 36, alt: '' }}
                      {%- else -%}
                        <span class="ec-incl-mini__ic">{% render 'ecoms-icon', name: block.settings[i_key] %}</span>
                      {%- endif -%}
                      <span class="ec-incl-mini__t">
                        {%- if block.settings[q_key] != blank %}<b data-ec-incl-qty="{{ block.settings[q_key] | escape }}">{{ block.settings[q_key] | escape }}</b> {% endif -%}
                        {{- block.settings[t_key] | escape -}}
                      </span>
                      {%- if block.settings[b_key] != blank -%}<em>{{ block.settings[b_key] | escape }}</em>{%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
            {%- endif -%}

          {%- when 'variants' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="ec-variants ec-optrow" {{ block.shopify_attributes }}>
                {%- render 'ecoms-variant-picker', product: product, section_id: section.id -%}
              </div>
            {%- endunless -%}

          {%- when 'packs' -%}
            {%- render 'ecoms-packs', product: product, source: block, uid: block.id, attrs: block.shopify_attributes -%}

          {%- when 'trust' -%}
            <div class="ec-trust4 ec-trust4--{{ block.settings.style | default: 'grid' }}" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign t_key = 'title_' | append: i -%}
                {%- assign d_key = 'text_' | append: i -%}
                {%- assign i_key = 'icon_' | append: i -%}
                {%- if block.settings[t_key] != blank -%}
                  <div>
                    {% render 'ecoms-icon', name: block.settings[i_key] %}
                    <div>
                      <b>{{ block.settings[t_key] | escape }}</b>
                      {%- if block.settings[d_key] != blank -%}<span class="ec-trust4__t">{{ block.settings[d_key] | escape }}</span>{%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'shipping' -%}
            {%- liquid
              assign ship_threshold = 0
              if settings.ecoms_free_shipping_live
                # Exact CLP amount (39990) or thousands (40 = $40.000), as cents.
                assign ship_threshold = settings.ecoms_free_shipping_threshold | plus: 0
                if ship_threshold < 1000
                  assign ship_threshold = ship_threshold | times: 1000
                endif
                assign ship_threshold = ship_threshold | times: 100
              endif
            -%}
            {%- if ship_threshold > 0 -%}
              <div class="ec-shipbar" data-ec-shipbar data-threshold="{{ ship_threshold }}" {{ block.shopify_attributes }}>
                <div class="ec-bar" aria-hidden="true"><span data-ec-shipbar-fill></span></div>
                <p data-ec-shipbar-text></p>
                <template data-ec-shipbar-progress>{{ settings.ecoms_free_shipping_progress | escape }}</template>
                <template data-ec-shipbar-success>{{ settings.ecoms_free_shipping_success | escape }}</template>
              </div>
            {%- elsif block.settings.free_text != blank -%}
              <p class="ec-shipbar ec-shipbar--free" {{ block.shopify_attributes }}><b>{{ block.settings.free_text | escape }}</b></p>
            {%- endif -%}

          {%- when 'pack_offer' -%}
            {%- comment -%}
              «Llévalo en pack»: the product in metafield ecoms.pack_product with the % of the REAL automatic
              discount in ecoms.pack_discount (Shopify → Descuentos, «Compra X y llévate Y»). Both must match:
              the price shown here is only a preview, Shopify applies the discount in the cart.
            {%- endcomment -%}
            {%- liquid
              assign po_item = product.metafields.ecoms.pack_product.value
              assign po_pct = product.metafields.ecoms.pack_discount.value | default: 0 | plus: 0
            -%}
            {%- if po_item != blank and po_item.available and po_pct > 0 -%}
              {%- liquid
                assign po_variant = po_item.selected_or_first_available_variant
                assign po_off = po_variant.price | times: po_pct | divided_by: 100
                # Fixed CLP discount (ecoms.pack_discount_amount) wins, e.g. to land the pack on $49.990.
                assign po_amount = product.metafields.ecoms.pack_discount_amount.value | default: 0 | plus: 0
                if po_amount > 0
                  assign po_off = po_amount | times: 100 | at_most: po_variant.price
                  assign po_pct = po_off | times: 100 | divided_by: po_variant.price | floor
                endif
                assign po_price = po_variant.price | minus: po_off
              -%}
              {%- if block.settings.show_total -%}
                {%- comment -%}
                  Bundle mode: a separate offer for the whole pack (main product + pack product), below the
                  main buttons, with its own total and button, so it's clear those buttons buy the main product only.
                {%- endcomment -%}
                {%- liquid
                  assign po_free_at = 0
                  if settings.ecoms_free_shipping_live
                    assign po_free_at = settings.ecoms_free_shipping_threshold | plus: 0
                    if po_free_at < 1000
                      assign po_free_at = po_free_at | times: 1000
                    endif
                    assign po_free_at = po_free_at | times: 100
                  endif
                  assign po_combo = variant.price | plus: po_price
                  # Original pack price: the main product's compare-at (when set) + the pack product's price.
                  assign po_main_was = variant.price
                  if variant.compare_at_price > variant.price
                    assign po_main_was = variant.compare_at_price
                  endif
                  assign po_was = po_main_was | plus: po_variant.price
                  assign po_save = po_was | minus: po_combo
                  assign po_name = product.metafields.ecoms.pack_name.value | default: 'el pack'
                  assign po_combo_money = po_combo | money
                  assign po_off_money = po_save | money
                  assign po_heading = block.settings.heading | replace: '[pack]', po_name | replace: '[save]', po_off_money
                  assign po_label_src = block.settings.button_label
                  assign po_open_cod = ''
                  if settings.ecoms_cod_live
                    if block.settings.button_label_cod != blank
                      assign po_label_src = block.settings.button_label_cod
                    endif
                    if block.settings.open_cod
                      assign po_open_cod = settings.ecoms_cod_app_button
                    endif
                  endif
                  assign po_label = po_label_src | replace: '[pack]', po_name | replace: '[total]', po_combo_money
                  assign po_note = product.metafields.ecoms.pack_note.value | default: block.settings.note
                -%}
                <div class="ec-packoff ec-packoff--bundle" data-ec-packoff {% if start_qty > 1 %}hidden{% endif %} {{ block.shopify_attributes }}>
                  {%- if block.settings.or_text != blank -%}<p class="ec-packoff__or"><span>{{ block.settings.or_text | escape }}</span></p>{%- endif -%}
                  {%- if po_heading != blank -%}<p class="ec-packoff__h">{{ po_heading | escape }}</p>{%- endif -%}
                  <div class="ec-packoff__pair">
                    <span class="ec-packoff__img">
                      {%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}{%- endif -%}
                    </span>
                    <span class="ec-packoff__plus" aria-hidden="true">+</span>
                    <a class="ec-packoff__img" href="{{ po_item.url }}" tabindex="-1" aria-hidden="true">
                      {%- if po_item.featured_image != blank -%}{{ po_item.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}{%- endif -%}
                    </a>
                    <ul class="ec-packoff__list" role="list">
                      {%- assign po_main_label = product.metafields.ecoms.pack_labels.value.first | default: product.title -%}
                      <li>{{ po_main_label | escape }}</li>
                      <li><a href="{{ po_item.url }}">1 {{ po_item.title | escape }}</a> <em>-{{ po_pct }}%</em></li>
                    </ul>
                  </div>
                  <p class="ec-packoff__total">{{ po_name | escape }} <b>{{ po_combo_money }}</b> <s>{{ po_was | money }}</s> <em>Ahorras {{ po_off_money }}</em></p>
                  {%- if po_free_at > 0 and po_combo >= po_free_at -%}<p class="ec-packoff__ship">{% render 'ecoms-icon', name: 'truck' %}Con el pack, envío gratis a todo Chile</p>{%- endif -%}
                  {%- render 'ecoms-add-button', item: po_item, label: po_label, class: 'ec-btn ec-btn--block ec-packoff__add', source: 'pack_offer', with_product: product, open_cod: po_open_cod -%}
                  {%- if po_note != blank -%}<p class="ec-packoff__note">{{ po_note | escape }}</p>{%- endif -%}
                </div>
              {%- else -%}
                <div class="ec-packoff" data-ec-packoff {% if start_qty > 1 %}hidden{% endif %} {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}<p class="ec-packoff__h">{{ block.settings.heading | escape }}</p>{%- endif -%}
                  <div class="ec-packoff__row">
                    <a class="ec-packoff__img" href="{{ po_item.url }}" tabindex="-1" aria-hidden="true">
                      {%- if po_item.featured_image != blank -%}
                        {{ po_item.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}
                      {%- endif -%}
                    </a>
                    <div class="ec-packoff__t">
                      <a href="{{ po_item.url }}">{{ po_item.title | escape }}</a>
                      <span><b>{{ po_price | money }}</b> <s>{{ po_variant.price | money }}</s> <em>-{{ po_pct }}%</em></span>
                      {%- liquid
                        assign po_free_at = 0
                        if settings.ecoms_free_shipping_live
                          assign po_free_at = settings.ecoms_free_shipping_threshold | plus: 0
                          if po_free_at < 1000
                            assign po_free_at = po_free_at | times: 1000
                          endif
                          assign po_free_at = po_free_at | times: 100
                        endif
                        assign po_combo = variant.price | plus: po_price
                      -%}
                      {%- if po_free_at > 0 and variant.price < po_free_at and po_combo >= po_free_at -%}<small class="ec-packoff__ship">{% render 'ecoms-icon', name: 'truck' %}Con el pack, envío gratis a todo Chile</small>{%- endif -%}
                      {%- assign po_note = product.metafields.ecoms.pack_note.value | default: block.settings.note -%}{%- if po_note != blank -%}<small>{{ po_note | escape }}</small>{%- endif -%}
                    </div>
                    {%- render 'ecoms-add-button', item: po_item, label: block.settings.button_label, class: 'ec-btn ec-btn--primary ec-btn--sm ec-packoff__add', source: 'pack_offer', with_product: product -%}
                  </div>
              {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'stock' -%}
            <div id="EcStock-{{ section.id }}" data-ec-refresh {{ block.shopify_attributes }}>
              {%- liquid
                assign stock_qty = variant.inventory_quantity | default: 0
                assign stock_max = block.settings.max_show
              -%}
              {%- if variant.available and variant.inventory_management == 'shopify' and stock_qty > 0 and stock_qty <= stock_max -%}
                {%- assign stock_pct = stock_qty | times: 100 | divided_by: stock_max -%}
                <div class="ec-stock">
                  {{ block.settings.text | replace: '[qty]', stock_qty | escape }}
                  <div class="ec-bar" aria-hidden="true"><span style="width: {{ stock_pct }}%"></span></div>
                </div>
              {%- endif -%}
            </div>

          {%- when 'payments' -%}
            <div class="ec-payments" {{ block.shopify_attributes }}>
              {%- if block.settings.text != blank -%}<p class="ec-secure">{% render 'ecoms-icon', name: 'lock' %}{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- if settings.ecoms_cod_live and settings.ecoms_cod_text != blank -%}
                <p class="ec-cod">{% render 'ecoms-icon', name: 'cash' %}<span>{{ settings.ecoms_cod_text | escape }}</span></p>
              {%- endif -%}
              <ul class="ec-payments__list" role="list">
                {%- render 'ecoms-payment-icons', class: 'ec-payments__icon' -%}
              </ul>
            </div>

          {%- when 'delivery' -%}
            {%- comment -%} Order → ready → delivered timeline. Dates are computed in the browser (no stale cached dates). {%- endcomment -%}
            <ol class="ec-delivery" data-ec-delivery {{ block.shopify_attributes }}>
              <li data-days="0"><span class="ec-delivery__ic">{% render 'ecoms-icon', name: 'bag' %}</span><b data-ec-date>Hoy</b><small>{{ block.settings.step_1 | escape }}</small></li>
              <li data-days="{{ block.settings.ready_days }}"><span class="ec-delivery__ic">{% render 'ecoms-icon', name: 'box' %}</span><b data-ec-date></b><small>{{ block.settings.step_2 | escape }}</small></li>
              <li data-days="{{ block.settings.min_days }}" data-days-max="{{ block.settings.max_days }}"><span class="ec-delivery__ic">{% render 'ecoms-icon', name: 'truck' %}</span><b data-ec-date></b><small>{{ block.settings.step_3 | escape }}</small></li>
            </ol>

          {%- when 'testimonial' -%}
            {%- if block.settings.text != blank -%}
              <figure class="ec-testi" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 44, height: 44, alt: block.settings.author, class: 'ec-testi__img' }}
                {%- endif -%}
                <div>
                  <blockquote>{{ block.settings.text | escape }}</blockquote>
                  <figcaption>
                    <b>{{ block.settings.author | escape }}</b>
                    {%- if block.settings.verified %} · <span class="ec-testi__ok">{% render 'ecoms-icon', name: 'verified' %}Compra verificada</span>{% endif -%}
                    <span class="ec-stars" style="--s: 12px; --r: {{ block.settings.stars | times: 20 }}%" role="img" aria-label="{{ block.settings.stars }} de 5 estrellas"></span>
                  </figcaption>
                </div>
              </figure>
            {%- endif -%}

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.sticky -%}
    <div
      id="EcSticky-{{ section.id }}"
      class="ec-sticky{% if section.settings.sticky_desktop %} ec-sticky--desktop{% endif %}"
      data-ec-sticky
      {% if section.settings.sticky_early %}data-ec-sticky-early{% endif %}
      data-ec-refresh
      aria-hidden="true"
      inert
    >
      {%- if first_media != blank -%}
        {{ first_media.preview_image | image_url: width: 120 | image_tag: class: 'ec-sticky__img', loading: 'lazy', width: 48, height: 48, alt: '' }}
      {%- endif -%}
      <div class="ec-sticky__txt">
        <p class="ec-sticky__name">{{ product.title | escape }}</p>
        <p class="ec-sticky__price">
          <span class="ec-sticky__pack" data-ec-sticky-pack {% if start_label == blank %}hidden{% endif %}>{{ start_label | escape }}</span>
          <span class="ec-sticky__row">
            <span data-ec-sticky-price>{{ start_total | money }}</span>
            {%- if section.settings.sticky_save -%}
              {%- comment -%} Without a pack selector, the savings come from the product's compare-at price. {%- endcomment -%}
              {%- liquid
                assign st_unit_save = 0
                if variant.compare_at_price > variant.price
                  assign st_unit_save = variant.compare_at_price | minus: variant.price
                endif
                assign st_save = st_unit_save | times: start_qty
              -%}
              <span class="ec-sticky__save" data-ec-sticky-save data-unit-save="{{ st_unit_save }}" {% if st_save <= 0 %}hidden{% endif %}>Ahorras <span data-ec-sticky-save-amount>{{ st_save | money }}</span></span>
            {%- endif -%}
            {%- if section.settings.sticky_ship -%}
              {%- liquid
                assign st_free_at = 0
                if settings.ecoms_free_shipping_live
                  assign st_free_at = settings.ecoms_free_shipping_threshold | plus: 0
                  if st_free_at < 1000
                    assign st_free_at = st_free_at | times: 1000
                  endif
                  assign st_free_at = st_free_at | times: 100
                endif
                assign st_local_at = 0
                if st_free_at > 0
                  assign st_local_at = settings.ecoms_free_shipping_local_threshold | plus: 0 | times: 100
                endif
                assign st_all = false
                assign st_local = false
                if st_free_at > 0 and start_total >= st_free_at
                  assign st_all = true
                elsif st_local_at > 0 and start_total >= st_local_at
                  assign st_local = true
                endif
              -%}
              {%- if st_free_at > 0 -%}
                <span class="ec-sticky__ship" data-ec-sticky-ship data-free-at="{{ st_free_at }}" data-local-at="{{ st_local_at }}" {% unless st_all or st_local %}hidden{% endunless %}>
                  {%- render 'ecoms-icon', name: 'truck' -%}
                  <span data-ec-sticky-ship-all {% unless st_all %}hidden{% endunless %}>Envío gratis</span>
                  <span data-ec-sticky-ship-local {% unless st_local %}hidden{% endunless %}>Envío gratis {{ settings.ecoms_free_shipping_local_short | default: 'RM' | escape }}</span>
                </span>
              {%- endif -%}
            {%- endif -%}
          </span>
        </p>
      </div>
      <button
        type="submit"
        form="{{ form_id }}"
        name="add"
        class="ec-btn ec-btn--primary"
        data-ec-add
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        {% render 'ecoms-icon', name: 'cart' %}
        <span>
          {%- if variant.available -%}
            {%- if settings.ecoms_cod_live and section.settings.sticky_label_cod != blank -%}{{ section.settings.sticky_label_cod | escape }}{%- else -%}{{ section.settings.sticky_label | escape }}{%- endif -%}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
    </div>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

{% schema %}
{
  "name": "ECOMS · Producto",
  "tag": "div",
  "class": "ec-pdp-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Plantilla",
      "options": [
        {
          "value": "flex",
          "label": "Flex"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "direct",
          "label": "Direct"
        }
      ],
      "default": "flex"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas en escritorio",
      "options": [
        {
          "value": "auto",
          "label": "Según la plantilla"
        },
        {
          "value": "two",
          "label": "Dos columnas (caja de compra bajo la información)"
        }
      ],
      "default": "auto",
      "info": "En Direct, «Según la plantilla» usa tres columnas en pantallas anchas."
    },
    {
      "type": "select",
      "id": "gallery_mobile",
      "label": "Galería en celular",
      "options": [
        {
          "value": "full",
          "label": "Ancho completo"
        },
        {
          "value": "inset",
          "label": "Con margen y miniaturas debajo"
        },
        {
          "value": "compact",
          "label": "Compacta: foto más baja y sin miniaturas"
        }
      ],
      "default": "full",
      "info": "«Compacta» deja el precio y el título en la primera pantalla del celular. Las fotos se recorren deslizando o con las flechas."
    },
    {
      "type": "select",
      "id": "thumbs",
      "label": "Miniaturas de la galería",
      "options": [
        {
          "value": "auto",
          "label": "Según la plantilla"
        },
        {
          "value": "below",
          "label": "Debajo de la foto"
        }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta sobre la foto",
      "info": "Ej.: Más vendido. Solo si es real."
    },
    {
      "type": "select",
      "id": "hero_bg",
      "label": "Fondo de la ficha",
      "options": [
        {
          "value": "none",
          "label": "Liso"
        },
        {
          "value": "glow",
          "label": "Degradado suave con el color de acento"
        },
        {
          "value": "split",
          "label": "Galería sobre bloque de color suave"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Formato de las fotos",
      "options": [
        {
          "value": "auto",
          "label": "Según la plantilla"
        },
        {
          "value": "square",
          "label": "Cuadrado 1:1 (menos scroll en móvil)"
        },
        {
          "value": "portrait",
          "label": "Vertical 4:5"
        },
        {
          "value": "landscape",
          "label": "Horizontal 4:3"
        }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Ajuste de la foto",
      "options": [
        {
          "value": "cover",
          "label": "Rellenar (puede recortar bordes)"
        },
        {
          "value": "contain",
          "label": "Completa (sin recortes)"
        }
      ],
      "default": "cover",
      "info": "«Completa» muestra fotos verticales enteras dentro del formato elegido."
    },
    {
      "type": "checkbox",
      "id": "video_first",
