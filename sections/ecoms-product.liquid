{%- comment -%}
  ECOMS · Product hero, built 1:1 from the ECOMS MASTER mockup (Flex, Brand, Direct).
  Uses Shopify's native product form ({% form 'product' %}), real variants, real prices and the
  AJAX Cart API + Dawn's cart drawer. Without JavaScript the form still posts to /cart/add.
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'EcForm-' | append: section.id
  assign media_count = product.media.size
  assign first_media = variant.featured_media | default: product.featured_media
  assign feature_block = section.blocks | where: 'type', 'media_features' | first
-%}
<section
  id="EcProduct-{{ section.id }}"
  class="ec-pdp ec-pdp--{{ section.settings.layout }}"
  data-ec-product
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  style="--ec-pt: {{ section.settings.padding_top }}px; --ec-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ec-w ec-pdp__grid">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="ec-pdp__media">
      <div class="ec-gal" data-ec-gal>
        <div class="ec-gal__main">
          <div class="ec-gal__track" data-ec-gal-track tabindex="0" aria-label="Galería de {{ product.title | escape }}">
            {%- for media in product.media -%}
              <div class="ec-gal__slide" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'video' -%}
                    {{
                      media
                      | video_tag: controls: false, muted: true, playsinline: true, loop: section.settings.video_loop, preload: 'metadata', image_size: '1200x', class: 'ec-gal__video'
                    }}
                    <button type="button" class="ec-gal__play" data-ec-play aria-label="Reproducir video">
                      {% render 'ecoms-icon', name: 'play' %}
                    </button>
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 'ec-gal__video', loading: 'lazy' }}
                  {%- else -%}
                    {%- liquid
                      assign img_loading = 'lazy'
                      assign img_priority = 'auto'
                      if forloop.first
                        assign img_loading = 'eager'
                        assign img_priority = 'high'
                      endif
                      assign img_alt = media.alt | default: product.title
                    -%}
                    {{
                      media.preview_image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '400,600,800,1000,1200,1400',
                        sizes: '(min-width: 990px) 560px, 100vw',
                        loading: img_loading,
                        fetchpriority: img_priority,
                        alt: img_alt
                    }}
                {%- endcase -%}
              </div>
            {%- else -%}
              <div class="ec-gal__slide">{{ 'product-1' | placeholder_svg_tag: 'ec-placeholder' }}</div>
            {%- endfor -%}
          </div>
          {%- if section.settings.badge != blank -%}
            <span class="ec-gal__badge ec-tag">{{ section.settings.badge | escape }}</span>
          {%- endif -%}
          {%- if media_count > 1 -%}
            <button type="button" class="ec-gal__arrow ec-gal__arrow--prev" data-ec-gal-step="-1" aria-label="Imagen anterior">
              {% render 'ecoms-icon', name: 'chev-l' %}
            </button>
            <button type="button" class="ec-gal__arrow ec-gal__arrow--next" data-ec-gal-step="1" aria-label="Imagen siguiente">
              {% render 'ecoms-icon', name: 'chev-r' %}
            </button>
            <span class="ec-gal__count" data-ec-gal-count>1 / {{ media_count }}</span>
          {%- endif -%}
        </div>
        {%- if media_count > 1 -%}
          <ul class="ec-gal__thumbs" role="list">
            {%- for media in product.media -%}
              <li>
                <button
                  type="button"
                  class="ec-gal__thumb"
                  data-ec-gal-to="{{ forloop.index0 }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="Ver imagen {{ forloop.index }}"
                >
                  {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="ec-gal__thumb-play">{% render 'ecoms-icon', name: 'play' %}</span>
                  {%- endif -%}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if feature_block -%}
        {%- render 'ecoms-media-features', block: feature_block -%}
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Info + buy box ---------- {%- endcomment -%}
    <div class="ec-pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="ec-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}

          {%- when 'rating' -%}
            {%- render 'ecoms-rating', product: product, block: block -%}

          {%- when 'title' -%}
            <h1 class="ec-pdp__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="ec-pdp__sub" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="ec-pdp__desc rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'benefits' -%}
            <ul class="ec-checks" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign key = 'item_' | append: i -%}
                {%- if block.settings[key] != blank -%}
                  <li>{% render 'ecoms-icon', name: 'check' %}<span>{{ block.settings[key] | escape }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'price' -%}
            <div id="EcPrice-{{ section.id }}" class="ec-pdp__price" data-ec-refresh {{ block.shopify_attributes }}>
              {%- render 'ecoms-price', variant: variant -%}
            </div>

          {%- when 'urgency' -%}
            {%- render 'ecoms-countdown', source: block, attrs: block.shopify_attributes -%}

          {%- when 'buy' -%}
            <div class="ec-buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'ec-form', novalidate: 'novalidate', data-ec-form: '' -%}
                <input type="hidden" name="id" value="{{ variant.id }}" data-ec-variant-input>
                <div class="ec-optrow">
                  {%- unless product.has_only_default_variant -%}
                    {%- for option in product.options_with_values -%}
                      <fieldset class="ec-opt" data-ec-option="{{ forloop.index0 }}">
                        <legend class="ec-lbl">
                          {{- option.name | escape }}:
                          <span class="ec-opt__value" data-ec-option-label>{{ option.selected_value | escape }}</span>
                        </legend>
                        <div class="ec-opt__values">
                          {%- for value in option.values -%}
                            {%- assign swatch = value.swatch -%}
                            <label class="ec-opt__v{% if swatch %} ec-opt__v--swatch{% endif %}" title="{{ value | escape }}">
                              <input
                                type="radio"
                                name="ec-option-{{ section.id }}-{{ forloop.parentloop.index0 }}"
                                value="{{ value | escape }}"
                                {% if value.selected %}
                                  checked
                                {% endif %}
                                {% unless value.available %}
                                  data-unavailable
                                {% endunless %}
                              >
                              {%- if swatch -%}
                                <span
                                  class="ec-swatch"
                                  style="{% if swatch.image %}--c: url({{ swatch.image | image_url: width: 60 }}) center / cover;{% elsif swatch.color %}--c: {{ swatch.color }};{% endif %}"
                                ></span>
                                <span class="visually-hidden">{{ value | escape }}</span>
                              {%- else -%}
                                <span class="ec-pill">{{ value | escape }}</span>
                              {%- endif -%}
                            </label>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  {%- endunless -%}
                  {%- if block.settings.show_quantity -%}
                    <div class="ec-qty-wrap">
                      <label class="ec-lbl" for="EcQty-{{ section.id }}">Cantidad:</label>
                      <div class="ec-qty" data-ec-qty>
                        <button type="button" data-ec-qty-step="-1" aria-label="Restar una unidad">{% render 'ecoms-icon', name: 'minus' %}</button>
                        <input
                          id="EcQty-{{ section.id }}"
                          type="number"
                          name="quantity"
                          value="1"
                          min="1"
                          {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %}
                          inputmode="numeric"
                          data-ec-qty-input
                        >
                        <button type="button" data-ec-qty-step="1" aria-label="Sumar una unidad">{% render 'ecoms-icon', name: 'plus' %}</button>
                      </div>
                    </div>
                  {%- else -%}
                    <input type="hidden" name="quantity" value="1" data-ec-qty-input>
                  {%- endif -%}
                </div>

                <div id="EcButtons-{{ section.id }}" class="ec-buy__buttons" data-ec-refresh>
                  <button
                    type="submit"
                    name="add"
                    class="ec-btn ec-btn--primary ec-btn--block ec-btn--lg"
                    data-ec-add
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {% render 'ecoms-icon', name: 'cart' %}
                    <span>
                      {%- if variant.available -%}
                        {{ block.settings.add_label | escape }}
                        {%- if block.settings.show_total %} - <span data-ec-cta-total>{{ variant.price | money }}</span>{% endif -%}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {%- if block.settings.show_buy_now and variant.available -%}
                    <button type="button" class="ec-btn ec-btn--accent ec-btn--block ec-btn--lg" data-ec-buy-now data-form="{{ form_id }}">
                      {{ block.settings.buy_now_label | escape }}
                    </button>
                  {%- endif -%}
                </div>
                <p class="ec-form__error" role="alert" data-ec-form-error hidden></p>
              {%- endform -%}
              <script type="application/json" data-ec-product-json>
                {{ product | json }}
              </script>
            </div>

          {%- when 'packs' -%}
            {%- render 'ecoms-packs', product: product, source: block, uid: block.id, attrs: block.shopify_attributes -%}

          {%- when 'trust' -%}
            <div class="ec-trust4" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign t_key = 'title_' | append: i -%}
                {%- assign d_key = 'text_' | append: i -%}
                {%- assign i_key = 'icon_' | append: i -%}
                {%- if block.settings[t_key] != blank -%}
                  <div>
                    {% render 'ecoms-icon', name: block.settings[i_key] %}
                    <div>
                      <b>{{ block.settings[t_key] | escape }}</b>
                      {{- block.settings[d_key] | escape -}}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.sticky -%}
    <div class="ec-sticky{% if section.settings.sticky_desktop %} ec-sticky--desktop{% endif %}" data-ec-sticky aria-hidden="true" inert>
      {%- if first_media != blank -%}
        {{ first_media.preview_image | image_url: width: 120 | image_tag: class: 'ec-sticky__img', loading: 'lazy', width: 48, height: 48, alt: '' }}
      {%- endif -%}
      <div class="ec-sticky__txt">
        <p class="ec-sticky__name">{{ product.title | escape }}</p>
        <p class="ec-sticky__price" data-ec-sticky-price>{{ variant.price | money }}</p>
      </div>
      <button type="submit" form="{{ form_id }}" name="add" class="ec-btn ec-btn--primary" data-ec-add>
        {% render 'ecoms-icon', name: 'cart' %}
        <span>{{ section.settings.sticky_label | escape }}</span>
      </button>
    </div>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

{% schema %}
{
  "name": "ECOMS · Producto",
  "tag": "div",
  "class": "ec-pdp-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Plantilla",
      "options": [
        {
          "value": "flex",
          "label": "Flex"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "direct",
          "label": "Direct"
        }
      ],
      "default": "flex"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta sobre la foto",
      "info": "Ej.: Más vendido. Solo si es real."
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Repetir videos",
      "default": true
    },
    {
      "type": "header",
      "content": "Botón fijo de compra"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Mostrar botón fijo al bajar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_desktop",
      "label": "También en escritorio (tarjeta flotante)",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_label",
      "label": "Texto del botón fijo",
      "default": "Agregar"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "eyebrow",
      "name": "Etiqueta superior",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Belleza • Cuidado personal"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Calificación",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Promedio y n.º de reseñas desde la app de reseñas (metacampos reviews.rating). Sin datos no se muestra."
        }
      ]
    },
    {
      "type": "title",
      "name": "Título",
      "limit": 1,
      "settings": []
    },
    {
      "type": "text",
      "name": "Texto / subtítulo",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Beneficio principal del producto en una o dos frases.</p>"
        }
      ]
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1,
      "settings": []
    },
    {
      "type": "benefits",
      "name": "Lista de beneficios",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "item_1",
          "label": "Beneficio 1"
        },
        {
          "type": "text",
          "id": "item_2",
          "label": "Beneficio 2"
        },
        {
          "type": "text",
          "id": "item_3",
