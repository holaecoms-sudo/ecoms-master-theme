{%- comment -%}
  ECOMS · Product hero, built 1:1 from the ECOMS MASTER mockup (Flex, Brand, Direct).
  Uses Shopify's native product form ({% form 'product' %}), real variants, real prices and the
  AJAX Cart API + Dawn's cart drawer. Without JavaScript the form still posts to /cart/add.
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'EcForm-' | append: section.id
  assign media_count = product.media.size
  assign first_media = variant.featured_media | default: product.featured_media
  assign feature_block = section.blocks | where: 'type', 'media_features' | first
  assign variants_block = section.blocks | where: 'type', 'variants' | first
  assign has_variants_block = false
  if variants_block
    assign has_variants_block = true
  endif

  # Gallery order: demo videos first when enabled (same order for slides and thumbnails).
  assign gallery_media = product.media
  if section.settings.video_first
    assign gm_videos = product.media | where: 'media_type', 'video'
    assign gm_external = product.media | where: 'media_type', 'external_video'
    assign gm_images = product.media | where: 'media_type', 'image'
    assign gm_models = product.media | where: 'media_type', 'model'
    assign gallery_media = gm_videos | concat: gm_external | concat: gm_images | concat: gm_models
  endif
  # «auto» keeps the template's own ratio (Brand 4:5, Direct 1:1.08, Flex 1:1).
  assign gal_ratio = ''
  case section.settings.media_ratio
    when 'square'
      assign gal_ratio = '1 / 1'
    when 'portrait'
      assign gal_ratio = '4 / 5'
    when 'landscape'
      assign gal_ratio = '4 / 3'
  endcase

  # Starting pack (Theme Editor «Pack seleccionado al cargar»): the form, CTA and sticky bar are
  # server-rendered with it, so the first paint and the no-JS fallback match the selected pack.
  assign start_qty = 1
  assign start_total = variant.price
  assign start_label = ''
  assign packs_block = section.blocks | where: 'type', 'packs' | first
  if packs_block
    assign ps = packs_block.settings
    assign start_tier = ps.default_tier | default: '1' | plus: 0
    if start_tier > 1
      assign start_on = 'tier' | append: start_tier | append: '_enabled'
      if ps[start_on] != true
        assign start_tier = 1
      endif
    endif
    assign start_pct = 0
    if start_tier == 1
      assign start_qty = ps.tier1_qty | default: 1
    else
      assign start_q_key = 'tier' | append: start_tier | append: '_qty'
      assign start_p_key = 'tier' | append: start_tier | append: '_pct'
      assign start_qty = ps[start_q_key] | default: start_tier
      if ps.discounts_live
        assign start_pct = ps[start_p_key] | default: 0
      endif
    endif
    assign start_label_key = 'tier' | append: start_tier | append: '_label'
    assign start_label = ps[start_label_key]
    assign start_sub = variant.price | times: start_qty
    assign start_discount = start_sub | times: start_pct | divided_by: 10000.0 | round | times: 100
    assign start_total = start_sub | minus: start_discount
  endif
-%}
{%- comment -%} Page palette: overrides the store colors only on pages using this template (e.g. a cleaning category). {%- endcomment -%}
{%- liquid
  assign pal = section.settings.palette | default: 'store'
-%}
{%- if pal != 'store' -%}
  <style>
    :root {
      --ec-primary:       {%- case pal -%}{%- when 'agua' -%}#0B2E4F{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_primary | default: settings.ecoms_primary }}{%- endcase -%};
      --ec-primary-ink:       {%- case pal -%}{%- when 'agua' -%}#FFFFFF{%- when 'grafito' -%}#FFFFFF{%- else -%}{{ section.settings.pal_primary_ink | default: settings.ecoms_primary_ink }}{%- endcase -%};
      --ec-dark:       {%- case pal -%}{%- when 'agua' -%}#0B2E4F{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_dark | default: settings.ecoms_dark }}{%- endcase -%};
      --ec-accent:       {%- case pal -%}{%- when 'agua' -%}#14B8C9{%- when 'grafito' -%}#F2643D{%- else -%}{{ section.settings.pal_accent | default: settings.ecoms_accent }}{%- endcase -%};
      --ec-accent-ink:       {%- case pal -%}{%- when 'agua' -%}#06283A{%- when 'grafito' -%}#FFFFFF{%- else -%}{{ section.settings.pal_accent_ink | default: settings.ecoms_accent_ink }}{%- endcase -%};
      --ec-soft:       {%- case pal -%}{%- when 'agua' -%}#E9F7FA{%- when 'grafito' -%}#F5F3F0{%- else -%}{{ section.settings.pal_soft | default: settings.ecoms_soft }}{%- endcase -%};
      --ec-soft-ink:       {%- case pal -%}{%- when 'agua' -%}#0B2E4F{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_soft_ink | default: settings.ecoms_soft_ink }}{%- endcase -%};
      --ec-tag:       {%- case pal -%}{%- when 'agua' -%}#14B8C9{%- when 'grafito' -%}#F2643D{%- else -%}{{ section.settings.pal_tag | default: settings.ecoms_tag }}{%- endcase -%};
      --ec-tag-ink:       {%- case pal -%}{%- when 'agua' -%}#06283A{%- when 'grafito' -%}#FFFFFF{%- else -%}{{ section.settings.pal_tag_ink | default: settings.ecoms_tag_ink }}{%- endcase -%};
      --ec-sale-bg:       {%- case pal -%}{%- when 'agua' -%}#E0F5F8{%- when 'grafito' -%}#FDEBE5{%- else -%}{{ section.settings.pal_sale_bg | default: settings.ecoms_sale_bg }}{%- endcase -%};
      --ec-sale-ink:       {%- case pal -%}{%- when 'agua' -%}#0B4F63{%- when 'grafito' -%}#9A3412{%- else -%}{{ section.settings.pal_sale_ink | default: settings.ecoms_sale_ink }}{%- endcase -%};
      --ec-urgent:       {%- case pal -%}{%- when 'agua' -%}#B54708{%- when 'grafito' -%}#B54708{%- else -%}{{ section.settings.pal_urgent | default: settings.ecoms_urgent }}{%- endcase -%};
      --ec-urgent-bg:       {%- case pal -%}{%- when 'agua' -%}#FFF4E5{%- when 'grafito' -%}#FFF4E5{%- else -%}{{ section.settings.pal_urgent_bg | default: settings.ecoms_urgent_bg }}{%- endcase -%};
      --ec-bg:       {%- case pal -%}{%- when 'agua' -%}#FFFFFF{%- when 'grafito' -%}#FFFFFF{%- else -%}{{ section.settings.pal_bg | default: settings.ecoms_bg }}{%- endcase -%};
      --ec-ink:       {%- case pal -%}{%- when 'agua' -%}#0F1B2A{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_ink | default: settings.ecoms_ink }}{%- endcase -%};
      --ec-muted:       {%- case pal -%}{%- when 'agua' -%}#5B6B7B{%- when 'grafito' -%}#6B6B6B{%- else -%}{{ section.settings.pal_muted | default: settings.ecoms_muted }}{%- endcase -%};
      --ec-line:       {%- case pal -%}{%- when 'agua' -%}#E2E8EF{%- when 'grafito' -%}#E8E5E1{%- else -%}{{ section.settings.pal_line | default: settings.ecoms_line }}{%- endcase -%};
      --ec-deep:       {%- case pal -%}{%- when 'agua' -%}#0B2E4F{%- when 'grafito' -%}#141414{%- else -%}{{ section.settings.pal_deep | default: settings.ecoms_deep }}{%- endcase -%};
      --ec-primary-hover: color-mix(in srgb, var(--ec-primary) 86%, #000);
    }
    body.ec-skin { background: var(--ec-bg); }
  </style>
{%- endif -%}
<section
  id="EcProduct-{{ section.id }}"
  class="ec-pdp ec-pdp--{{ section.settings.layout }} ec-pdp--thumbs-{{ section.settings.thumbs | default: 'auto' }} ec-pdp--bg-{{ section.settings.hero_bg | default: 'none' }} ec-pdp--cols-{{ section.settings.columns | default: 'auto' }}"
  data-ec-product
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  style="--ec-pt: {{ section.settings.padding_top }}px; --ec-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ec-w ec-pdp__grid">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="ec-pdp__media">
      <div class="ec-gal" data-ec-gal style="{% if gal_ratio != blank %}--gal-ratio: {{ gal_ratio }}; {% endif %}--gal-fit: {{ section.settings.media_fit | default: 'cover' }};">
        <div class="ec-gal__main">
          <div class="ec-gal__track" data-ec-gal-track tabindex="0" aria-label="Galería de {{ product.title | escape }}">
            {%- for media in gallery_media -%}
              <div class="ec-gal__slide" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'video' -%}
                    {{
                      media
                      | video_tag: controls: false, muted: true, playsinline: true, autoplay: section.settings.video_autoplay, loop: section.settings.video_loop, preload: 'metadata', image_size: '1200x', class: 'ec-gal__video'
                    }}
                    <button type="button" class="ec-gal__play" data-ec-play aria-label="Reproducir video con sonido"{% if section.settings.video_autoplay %} data-autoplay{% endif %}>
                      {% render 'ecoms-icon', name: 'play' %}
                    </button>
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 'ec-gal__video', loading: 'lazy' }}
                  {%- else -%}
                    {%- liquid
                      assign img_loading = 'lazy'
                      assign img_priority = 'auto'
                      if forloop.first
                        assign img_loading = 'eager'
                        assign img_priority = 'high'
                      endif
                      assign img_alt = media.alt | default: product.title
                    -%}
                    {{
                      media.preview_image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '400,600,800,1000,1200,1400',
                        sizes: '(min-width: 990px) 560px, 100vw',
                        loading: img_loading,
                        fetchpriority: img_priority,
                        alt: img_alt
                    }}
                {%- endcase -%}
              </div>
            {%- else -%}
              <div class="ec-gal__slide">{{ 'product-1' | placeholder_svg_tag: 'ec-placeholder' }}</div>
            {%- endfor -%}
          </div>
          {%- if section.settings.badge != blank -%}
            <span class="ec-gal__badge ec-tag">{{ section.settings.badge | escape }}</span>
          {%- endif -%}
          {%- if media_count > 1 -%}
            <button type="button" class="ec-gal__arrow ec-gal__arrow--prev" data-ec-gal-step="-1" aria-label="Imagen anterior">
              {% render 'ecoms-icon', name: 'chev-l' %}
            </button>
            <button type="button" class="ec-gal__arrow ec-gal__arrow--next" data-ec-gal-step="1" aria-label="Imagen siguiente">
              {% render 'ecoms-icon', name: 'chev-r' %}
            </button>
            <span class="ec-gal__count" data-ec-gal-count>1 / {{ media_count }}</span>
          {%- endif -%}
        </div>
        {%- if media_count > 1 -%}
          <ul class="ec-gal__thumbs" role="list">
            {%- for media in gallery_media -%}
              <li>
                <button
                  type="button"
                  class="ec-gal__thumb"
                  data-ec-gal-to="{{ forloop.index0 }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="Ver imagen {{ forloop.index }}"
                >
                  {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="ec-gal__thumb-play">{% render 'ecoms-icon', name: 'play' %}</span>
                  {%- endif -%}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if feature_block -%}
        {%- render 'ecoms-media-features', block: feature_block -%}
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Info + buy box ---------- {%- endcomment -%}
    <div class="ec-pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'buybox' -%}
            {%- comment -%} Everything after this block renders in the buy box (Direct: third column). {%- endcomment -%}
            </div>
            <div class="ec-pdp__buy" {{ block.shopify_attributes }}>

          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="ec-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}

          {%- when 'rating' -%}
            {%- render 'ecoms-rating', product: product, block: block -%}

          {%- when 'title' -%}
            <h1 class="ec-pdp__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'text' -%}
            {%- comment -%} Per-product copy: metafield ecoms.subtitle wins over the template text. {%- endcomment -%}
            {%- assign sub_mf = product.metafields.ecoms.subtitle.value -%}
            {%- if sub_mf != blank -%}
              <div class="ec-pdp__sub" {{ block.shopify_attributes }}>{{ product.metafields.ecoms.subtitle | metafield_tag }}</div>
            {%- elsif block.settings.text != blank -%}
              <div class="ec-pdp__sub" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="ec-pdp__desc rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'benefits' -%}
            {%- comment -%} Per-product list: metafield ecoms.benefits (list of single-line text) wins. {%- endcomment -%}
            {%- assign benefits_mf = product.metafields.ecoms.benefits.value -%}
            <ul class="ec-checks" role="list" {{ block.shopify_attributes }}>
              {%- if benefits_mf != blank -%}
                {%- for item in benefits_mf -%}
                  <li>{% render 'ecoms-icon', name: 'check' %}<span>{{ item | escape }}</span></li>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..4) -%}
                  {%- assign key = 'item_' | append: i -%}
                  {%- if block.settings[key] != blank -%}
                    <li>{% render 'ecoms-icon', name: 'check' %}<span>{{ block.settings[key] | escape }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>

          {%- when 'price' -%}
            <div id="EcPrice-{{ section.id }}" class="ec-pdp__price" data-ec-refresh {{ block.shopify_attributes }}>
              {%- render 'ecoms-price', variant: variant, style: block.settings.style -%}
            </div>

          {%- when 'urgency' -%}
            {%- render 'ecoms-countdown', source: block, attrs: block.shopify_attributes -%}

          {%- when 'buy' -%}
            <div class="ec-buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'ec-form', novalidate: 'novalidate', data-ec-form: '' -%}
                <input type="hidden" name="id" value="{{ variant.id }}" data-ec-variant-input>
                <div class="ec-optrow">
                  {%- unless has_variants_block -%}{%- render 'ecoms-variant-picker', product: product, section_id: section.id -%}{%- endunless -%}
                  {%- if block.settings.show_quantity -%}
                    <div class="ec-qty-wrap">
                      <label class="ec-lbl" for="EcQty-{{ section.id }}">Cantidad:</label>
                      <div class="ec-qty" data-ec-qty>
                        <button type="button" data-ec-qty-step="-1" aria-label="Restar una unidad">{% render 'ecoms-icon', name: 'minus' %}</button>
                        <input
                          id="EcQty-{{ section.id }}"
                          type="number"
                          name="quantity"
                          value="{{ start_qty }}"
                          min="1"
                          {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %}
                          inputmode="numeric"
                          data-ec-qty-input
                        >
                        <button type="button" data-ec-qty-step="1" aria-label="Sumar una unidad">{% render 'ecoms-icon', name: 'plus' %}</button>
                      </div>
                    </div>
                  {%- else -%}
                    <input type="hidden" name="quantity" value="{{ start_qty }}" data-ec-qty-input>
                  {%- endif -%}
                </div>

                <div id="EcButtons-{{ section.id }}" class="ec-buy__buttons" data-ec-refresh>
                  <button
                    type="submit"
                    name="add"
                    class="ec-btn ec-btn--primary ec-btn--block ec-btn--lg"
                    data-ec-add
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {% render 'ecoms-icon', name: 'cart' %}
                    <span>
                      {%- if variant.available -%}
                        {{ block.settings.add_label | escape }}
                        {%- if block.settings.show_total %} · <span data-ec-cta-total>{{ start_total | money }}</span>{% endif -%}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {%- if block.settings.show_buy_now and variant.available -%}
                    <button type="button" class="ec-btn ec-btn--accent ec-btn--block ec-btn--lg" data-ec-buy-now data-form="{{ form_id }}">
                      {%- if block.settings.buy_now_icon != 'none' -%}{% render 'ecoms-icon', name: block.settings.buy_now_icon %}{%- endif -%}
                      {{ block.settings.buy_now_label | escape }}
                    </button>
                  {%- endif -%}
                </div>
                <p class="ec-form__error" role="alert" data-ec-form-error hidden></p>
              {%- endform -%}
              <script type="application/json" data-ec-product-json>
                {{ product | json }}
              </script>
            </div>

          {%- when 'chips' -%}
            {%- comment -%} Spec pills under the title (e.g. IPX7 · 90 min · USB-C). Empty pills are skipped. {%- endcomment -%}
            {%- capture chips -%}
              {%- for i in (1..5) -%}
                {%- assign key = 'chip_' | append: i -%}
                {%- if block.settings[key] != blank -%}<li>{{ block.settings[key] | escape }}</li>{%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if chips != blank -%}
              <ul class="ec-chips" role="list" {{ block.shopify_attributes }}>{{ chips }}</ul>
            {%- endif -%}

          {%- when 'includes' -%}
            {%- comment -%} Compact «Tu compra incluye» list for the buy box (only pieces that really ship). {%- endcomment -%}
            <div class="ec-incl-mini" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<p class="ec-incl-mini__h">{{ block.settings.heading | escape }}</p>{%- endif -%}
              <ul role="list">
                {%- for i in (1..6) -%}
                  {%- liquid
                    assign t_key = 'title_' | append: i
                    assign q_key = 'qty_' | append: i
                    assign b_key = 'badge_' | append: i
                    assign i_key = 'icon_' | append: i
                    assign img_key = 'image_' | append: i
                  -%}
                  {%- if block.settings[t_key] != blank -%}
                    <li>
                      {%- if block.settings[img_key] != blank -%}
                        {{ block.settings[img_key] | image_url: width: 96 | image_tag: loading: 'lazy', width: 36, height: 36, alt: '' }}
                      {%- else -%}
                        <span class="ec-incl-mini__ic">{% render 'ecoms-icon', name: block.settings[i_key] %}</span>
                      {%- endif -%}
                      <span class="ec-incl-mini__t">
                        {%- if block.settings[q_key] != blank %}<b>{{ block.settings[q_key] | escape }}</b> {% endif -%}
                        {{- block.settings[t_key] | escape -}}
                      </span>
                      {%- if block.settings[b_key] != blank -%}<em>{{ block.settings[b_key] | escape }}</em>{%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'variants' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="ec-variants ec-optrow" {{ block.shopify_attributes }}>
                {%- render 'ecoms-variant-picker', product: product, section_id: section.id -%}
              </div>
            {%- endunless -%}

          {%- when 'packs' -%}
            {%- render 'ecoms-packs', product: product, source: block, uid: block.id, attrs: block.shopify_attributes -%}

          {%- when 'trust' -%}
            <div class="ec-trust4 ec-trust4--{{ block.settings.style | default: 'grid' }}" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign t_key = 'title_' | append: i -%}
                {%- assign d_key = 'text_' | append: i -%}
                {%- assign i_key = 'icon_' | append: i -%}
                {%- if block.settings[t_key] != blank -%}
                  <div>
                    {% render 'ecoms-icon', name: block.settings[i_key] %}
                    <div>
                      <b>{{ block.settings[t_key] | escape }}</b>
                      {%- if block.settings[d_key] != blank -%}<span class="ec-trust4__t">{{ block.settings[d_key] | escape }}</span>{%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'shipping' -%}
            {%- liquid
              assign ship_threshold = 0
              if settings.ecoms_free_shipping_live
                assign ship_threshold = settings.ecoms_free_shipping_threshold | plus: 0 | times: 100000
              endif
            -%}
            {%- if ship_threshold > 0 -%}
              <div class="ec-shipbar" data-ec-shipbar data-threshold="{{ ship_threshold }}" {{ block.shopify_attributes }}>
                <div class="ec-bar" aria-hidden="true"><span data-ec-shipbar-fill></span></div>
                <p data-ec-shipbar-text></p>
                <template data-ec-shipbar-progress>{{ settings.ecoms_free_shipping_progress | escape }}</template>
                <template data-ec-shipbar-success>{{ settings.ecoms_free_shipping_success | escape }}</template>
              </div>
            {%- elsif block.settings.free_text != blank -%}
              <p class="ec-shipbar ec-shipbar--free" {{ block.shopify_attributes }}><b>{{ block.settings.free_text | escape }}</b></p>
            {%- endif -%}

          {%- when 'stock' -%}
            <div id="EcStock-{{ section.id }}" data-ec-refresh {{ block.shopify_attributes }}>
              {%- liquid
                assign stock_qty = variant.inventory_quantity | default: 0
                assign stock_max = block.settings.max_show
              -%}
              {%- if variant.available and variant.inventory_management == 'shopify' and stock_qty > 0 and stock_qty <= stock_max -%}
                {%- assign stock_pct = stock_qty | times: 100 | divided_by: stock_max -%}
                <div class="ec-stock">
                  {{ block.settings.text | replace: '[qty]', stock_qty | escape }}
                  <div class="ec-bar" aria-hidden="true"><span style="width: {{ stock_pct }}%"></span></div>
                </div>
              {%- endif -%}
            </div>

          {%- when 'payments' -%}
            <div class="ec-payments" {{ block.shopify_attributes }}>
              {%- if block.settings.text != blank -%}<p class="ec-secure">{% render 'ecoms-icon', name: 'lock' %}{{ block.settings.text | escape }}</p>{%- endif -%}
              <ul class="ec-payments__list" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'ec-payments__icon' }}</li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'delivery' -%}
            {%- comment -%} Order → ready → delivered timeline. Dates are computed in the browser (no stale cached dates). {%- endcomment -%}
            <ol class="ec-delivery" data-ec-delivery {{ block.shopify_attributes }}>
              <li data-days="0"><span class="ec-delivery__ic">{% render 'ecoms-icon', name: 'bag' %}</span><b data-ec-date>Hoy</b><small>{{ block.settings.step_1 | escape }}</small></li>
              <li data-days="{{ block.settings.ready_days }}"><span class="ec-delivery__ic">{% render 'ecoms-icon', name: 'box' %}</span><b data-ec-date></b><small>{{ block.settings.step_2 | escape }}</small></li>
              <li data-days="{{ block.settings.min_days }}" data-days-max="{{ block.settings.max_days }}"><span class="ec-delivery__ic">{% render 'ecoms-icon', name: 'truck' %}</span><b data-ec-date></b><small>{{ block.settings.step_3 | escape }}</small></li>
            </ol>

          {%- when 'testimonial' -%}
            {%- if block.settings.text != blank -%}
              <figure class="ec-testi" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 44, height: 44, alt: block.settings.author, class: 'ec-testi__img' }}
                {%- endif -%}
                <div>
                  <blockquote>{{ block.settings.text | escape }}</blockquote>
                  <figcaption>
                    <b>{{ block.settings.author | escape }}</b>
                    {%- if block.settings.verified %} · <span class="ec-testi__ok">{% render 'ecoms-icon', name: 'verified' %}Compra verificada</span>{% endif -%}
                    <span class="ec-stars" style="--s: 12px; --r: {{ block.settings.stars | times: 20 }}%" role="img" aria-label="{{ block.settings.stars }} de 5 estrellas"></span>
                  </figcaption>
                </div>
              </figure>
            {%- endif -%}

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.sticky -%}
    <div
      id="EcSticky-{{ section.id }}"
      class="ec-sticky{% if section.settings.sticky_desktop %} ec-sticky--desktop{% endif %}"
      data-ec-sticky
      data-ec-refresh
      aria-hidden="true"
      inert
    >
      {%- if first_media != blank -%}
        {{ first_media.preview_image | image_url: width: 120 | image_tag: class: 'ec-sticky__img', loading: 'lazy', width: 48, height: 48, alt: '' }}
      {%- endif -%}
      <div class="ec-sticky__txt">
        <p class="ec-sticky__name">{{ product.title | escape }}</p>
        <p class="ec-sticky__price">
          <span class="ec-sticky__pack" data-ec-sticky-pack {% if start_label == blank %}hidden{% endif %}>{{ start_label | escape }}</span>
          <span data-ec-sticky-price>{{ start_total | money }}</span>
        </p>
      </div>
      <button
        type="submit"
        form="{{ form_id }}"
        name="add"
        class="ec-btn ec-btn--primary"
        data-ec-add
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        {% render 'ecoms-icon', name: 'cart' %}
        <span>
          {%- if variant.available -%}
            {{ section.settings.sticky_label | escape }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
    </div>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

