{%- comment -%}
  ECOMS · Moving review cards (auto-scroll, pauses on touch/hover). Only real, authorised reviews: the
  section stays hidden on the storefront until a review has text or a video. Optional real customer count on top.
{%- endcomment -%}
{%- liquid
  assign real = 0
  for block in section.blocks
    if block.settings.text != blank or block.settings.video != blank
      assign real = real | plus: 1
    endif
  endfor
-%}
{%- if real > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-rs-sec' %}>
  <div class="ec-w ec-sec-h">
    {%- if section.settings.count != blank -%}
      <p class="ec-rs__count"><b>{{ section.settings.count | escape }}</b> {{ section.settings.count_label | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if product.metafields.reviews.rating.value != blank -%}
      {%- assign rs_r = product.metafields.reviews.rating.value.rating | times: 20 -%}
      <p class="ec-rs__avg"><span class="ec-stars" style="--s: 17px; --r: {{ rs_r }}%" aria-hidden="true"></span>{{ product.metafields.reviews.rating.value.rating | round: 1 }} · {{ product.metafields.reviews.rating_count.value }} reseñas</p>
    {%- endif -%}
  </div>
  <div class="ec-rs ec-mq__view">
    <div class="ec-mq__track" style="--ec-mq-speed: {{ section.settings.speed | default: 40 }}s;">
      {%- for pass in (1..2) -%}
        <ul class="ec-mq__list ec-rs__list" role="list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- if block.settings.text == blank and block.settings.video == blank -%}
              {%- if request.design_mode and pass == 1 -%}<li class="ec-rs__card ec-rs__card--ph" {{ block.shopify_attributes }}>Reseña vacía: escribe una reseña real o sube un video.</li>{%- endif -%}
              {%- continue -%}
            {%- endif -%}
            <li class="ec-rs__card" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '480x', class: 'ec-rs__img ec-rs__vid' }}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', class: 'ec-rs__img', alt: '' }}
              {%- endif -%}
              <span class="ec-stars" style="--s: 15px; --r: {{ block.settings.stars | times: 20 }}%" role="img" aria-label="{{ block.settings.stars }} de 5 estrellas"></span>
              {%- if block.settings.text != blank -%}<p class="ec-rs__t">{{ block.settings.text | escape }}</p>{%- endif -%}
              <p class="ec-rs__a">
                <b>{{ block.settings.author | escape }}</b>{% if block.settings.place != blank %} · {{ block.settings.place | escape }}{% endif %}
                {%- if block.settings.verified -%}<span class="ec-rs__v">{% render 'ecoms-icon', name: 'verified' %}Compra verificada</span>{%- endif -%}
              </p>
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Reseñas móviles",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Solo reseñas reales y autorizadas. Sin reseñas, la sección no se muestra en la tienda."
    },
    {
      "type": "text",
      "id": "count",
      "label": "Cifra de clientas",
      "info": "Ej.: +350. Solo una cifra real (pedidos entregados). Vacío: no se muestra."
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Texto de la cifra",
      "default": "clientas ya lo usan en Chile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo que dicen nuestras clientas"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duración de una vuelta",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "s",
      "default": 40
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho",
      "options": [
        { "value": "full", "label": "Completo" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio abajo",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "text", "id": "author", "label": "Nombre", "info": "Ej.: Camila R." },
        { "type": "text", "id": "place", "label": "Comuna o ciudad" },
        { "type": "range", "id": "stars", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Reseña" },
        { "type": "image_picker", "id": "image", "label": "Foto de la clienta (con permiso)" },
        { "type": "video", "id": "video", "label": "Video de la clienta (con permiso)", "info": "Corto y vertical. Se reproduce solo, sin sonido, en lugar de la foto." },
        { "type": "checkbox", "id": "verified", "label": "Compra verificada", "default": true }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "ECOMS · Reseñas móviles" }
  ]
}
{% endschema %}
