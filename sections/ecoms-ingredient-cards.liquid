{%- comment -%}
  ECOMS · Ingredientes en tarjetas: one card per ingredient (photo tile, name, one line) that opens to a longer note.
  Items come from the section blocks, or from the product metafield «Contenido desde metacampo» (list of «Ítem de contenido»:
  title, text, value = detail, image or icon). Appearance/function language only; every line must be verifiable.
{%- endcomment -%}
{%- liquid
  assign ec_src = section.blocks
  if section.settings.metafield != blank and product
    assign ec_mfp = section.settings.metafield | strip | split: '.'
    if ec_mfp.size == 2
      assign ec_mfl = product.metafields[ec_mfp[0]][ec_mfp[1]].value
      if ec_mfl != blank
        assign ec_src = ec_mfl
      endif
    endif
  endif
-%}
{%- if ec_src.size > 0 or request.design_mode -%}
{{ 'ecoms-ritual-sections.css' | asset_url | stylesheet_tag }}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ing-sec' %}>
  <div class="ec-w">
    {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h">{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}</div>
    {%- endif -%}
    <div class="ec-ing" role="list">
      {%- for block in ec_src -%}
        {%- liquid
          assign it_title = block.settings.title | default: block.title.value | default: block.label.value
          assign it_text = block.settings.text | default: block.text.value
          assign it_detail = block.settings.detail | default: block.value.value
          assign it_img = block.settings.image | default: block.image.value
          assign it_icon = block.settings.icon | default: block.icon.value | default: 'leaf'
        -%}
        {%- if it_title != blank -%}
          {%- capture it_head -%}
            <span class="ec-ing__ph">
              {%- if it_img != blank -%}{{ it_img | image_url: width: 300 | image_tag: loading: 'lazy', width: 110, height: 110, alt: it_title }}{%- else -%}{% render 'ecoms-icon', name: it_icon %}{%- endif -%}
            </span>
            <span class="ec-ing__t"><b>{{ it_title | escape }}</b>{%- if it_text != blank -%}<span>{{ it_text | escape }}</span>{%- endif -%}</span>
          {%- endcapture -%}
          {%- if it_detail != blank -%}
            <details class="ec-ing__c" role="listitem" {{ block.shopify_attributes }}>
              <summary>{{ it_head }}<span class="ec-ing__plus" aria-hidden="true"></span></summary>
              <p class="ec-ing__d">{{ it_detail | escape }}</p>
            </details>
          {%- else -%}
            <div class="ec-ing__c" role="listitem" {{ block.shopify_attributes }}><div class="ec-ing__s">{{ it_head }}</div></div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="ec-ing__note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Ingredientes en tarjetas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "metafield", "label": "Contenido desde metacampo del producto", "info": "Ej.: ecoms.ingredients. Cada ítem: título, texto corto, «valor» = detalle que se abre, imagen o ícono." },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Ingredientes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Qué hay *adentro.*" },
    { "type": "text", "id": "note", "label": "Nota pequeña" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrediente",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Ingrediente" },
        { "type": "text", "id": "text", "label": "Línea corta" },
        { "type": "textarea", "id": "detail", "label": "Detalle (se abre con el +)" },
        { "type": "image_picker", "id": "image", "label": "Foto (cuadrada, 400 x 400 px)" },
        { "type": "select", "id": "icon", "label": "Ícono (si no hay foto)", "default": "leaf", "options": [
          { "value": "leaf", "label": "Hoja" }, { "value": "drop", "label": "Gota" }, { "value": "sparkle", "label": "Brillo" },
          { "value": "bolt", "label": "Rayo" }, { "value": "heart", "label": "Corazón" }, { "value": "sun", "label": "Sol" }
        ] }
      ]
    }
  ],
  "presets": [ { "name": "ECOMS · Ingredientes en tarjetas" } ]
}
{% endschema %}
