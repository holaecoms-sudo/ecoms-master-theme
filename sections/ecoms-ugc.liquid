{%- comment -%}
  ECOMS · Customer photos and videos (UGC). Styles: grid (Flex) or quotes (Brand: photo/video + quote + handle).
  Only content shared with the customer's permission.
{%- endcomment -%}
{%- assign style = section.settings.style | default: 'grid' -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ugc-sec' %}>
  <div class="ec-w">
    {%- if style == 'quotes' -%}
      <div class="ec-sec-h">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- else -%}
      {%- if section.settings.heading != blank -%}<h2 class="ec-h3 ec-h3--tight">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="ec-sub ec-ugc__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- endif -%}
    <div class="ec-ugc ec-ugc--{{ style }}">
      {%- for block in section.blocks -%}
        <figure class="ec-ugc__fig" {{ block.shopify_attributes }}>
          <div class="ec-ugc__item">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: false, controls: false, muted: true, playsinline: true, preload: 'none', image_size: '600x' }}
              <button type="button" class="ec-gal__play" data-ec-play aria-label="Reproducir video">{% render 'ecoms-icon', name: 'play' %}</button>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,450,600', sizes: '(min-width: 990px) 280px, 45vw', alt: block.settings.caption }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}
            {%- endif -%}
            {%- if style == 'grid' and block.settings.caption != blank -%}<span class="ec-ugc__cap">{{ block.settings.caption | escape }}</span>{%- endif -%}
          </div>
          {%- if style == 'quotes' -%}
            {%- if block.settings.quote != blank -%}<blockquote>“{{ block.settings.quote | escape }}”</blockquote>{%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Clientes (UGC)",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "grid",
          "label": "Grilla de fotos (Flex)"
        },
        {
          "value": "quotes",
          "label": "Fotos con cita (Brand)"
        }
      ],
      "default": "grid"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Clientes reales"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtítulo",
      "default": "Personas reales usando el producto."
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Foto o video",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (opcional)"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Cita del cliente (real)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Usuario o nombre"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "ECOMS · Clientes (UGC)",
      "blocks": [
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        }
      ]
    }
  ]
}
{% endschema %}
