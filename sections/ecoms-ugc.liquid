{%- comment -%}
  ECOMS · Customer photos and videos (UGC). Styles: grid (Flex) or quotes (Brand: photo/video + quote + handle).
  Only content shared with the customer's permission.
{%- endcomment -%}
{%- liquid
  # Items come from the section blocks, or from a product metafield (list of metaobjects «ecoms_item»)
  # when «Contenido desde metacampo» is set and the product has it. One template then serves every product.
  assign ec_src = section.blocks
  if section.settings.metafield != blank and product
    assign ec_mfp = section.settings.metafield | strip | split: '.'
    if ec_mfp.size == 2
      assign ec_mfl = product.metafields[ec_mfp[0]][ec_mfp[1]].value
      if ec_mfl != blank
        assign ec_src = ec_mfl
      endif
    endif
  endif
-%}
{%- liquid
  assign style = section.settings.style | default: 'grid'
  # Only photos or videos actually uploaded are published; empty blocks are editor placeholders.
  assign real_items = 0
  for block in ec_src
    assign bk_caption = block.settings.caption | default: block.caption.value
    assign bk_image = block.settings.image | default: block.image.value
    assign bk_quote = block.settings.quote | default: block.quote.value
    assign bk_video = block.settings.video | default: block.video.value
    if bk_image != blank or bk_video != blank
      assign real_items = real_items | plus: 1
    endif
  endfor
-%}
{%- if real_items > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ugc-sec' %}>
  <div class="ec-w">
    {%- if style == 'quotes' -%}
      <div class="ec-sec-h">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- else -%}
      {%- if section.settings.heading != blank -%}<h2 class="ec-h3 ec-h3--tight">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="ec-sub ec-ugc__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- endif -%}
    <div class="ec-ugc ec-ugc--{{ style }}">
      {%- for block in ec_src -%}
        {%- liquid
          assign bk_caption = block.settings.caption | default: block.caption.value
          assign bk_image = block.settings.image | default: block.image.value
          assign bk_quote = block.settings.quote | default: block.quote.value
          assign bk_video = block.settings.video | default: block.video.value
        -%}
        {%- if bk_image == blank and bk_video == blank and request.design_mode != true -%}{%- continue -%}{%- endif -%}
        <figure class="ec-ugc__fig" {{ block.shopify_attributes }}>
          <div class="ec-ugc__item">
            {%- if bk_video != blank -%}
              {{ bk_video | video_tag: autoplay: false, controls: false, muted: true, playsinline: true, preload: 'none', image_size: '600x' }}
              <button type="button" class="ec-gal__play" data-ec-play aria-label="Reproducir video">{% render 'ecoms-icon', name: 'play' %}</button>
            {%- elsif bk_image != blank -%}
              {{ bk_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,450,600', sizes: '(min-width: 990px) 280px, 45vw', alt: bk_caption }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}
            {%- endif -%}
            {%- if style == 'grid' and bk_caption != blank -%}<span class="ec-ugc__cap">{{ bk_caption | escape }}</span>{%- endif -%}
          </div>
          {%- if style == 'quotes' -%}
            {%- if bk_quote != blank -%}<blockquote>“{{ bk_quote | escape }}”</blockquote>{%- endif -%}
            {%- if bk_caption != blank -%}<figcaption>{{ bk_caption | escape }}</figcaption>{%- endif -%}
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Clientes (UGC)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "metafield",
      "label": "Contenido desde metacampo del producto",
      "info": "Opcional. Ej.: ecoms.stats. Si el producto tiene ese metacampo (lista de «Ítem de contenido»), reemplaza los bloques. Así una plantilla sirve para todos los productos."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        {
          "value": "grid",
          "label": "Grilla de fotos (Flex)"
        },
        {
          "value": "quotes",
          "label": "Fotos con cita (Brand)"
        }
      ],
      "default": "grid"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Clientes reales"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtítulo",
      "default": "Personas reales usando el producto."
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Foto o video",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (opcional)"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Cita del cliente (real)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Usuario o nombre"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "ECOMS · Clientes (UGC)",
      "blocks": [
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        }
      ]
    }
  ]
}
{% endschema %}
