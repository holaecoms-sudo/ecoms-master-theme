{%- comment -%} ECOMS · Customer photos and videos (UGC). Only use content with the customer's permission. {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ugc-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <h2 class="ec-h3 ec-h3--tight">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="ec-sub ec-ugc__sub">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="ec-ugc">
      {%- for block in section.blocks -%}
        <figure class="ec-ugc__item" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{
              block.settings.video
              | video_tag: autoplay: false, controls: true, muted: true, playsinline: true, preload: 'none', image_size: '600x'
            }}
          {%- elsif block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag: loading: 'lazy', widths: '200,300,450,600', sizes: '(min-width: 990px) 16vw, 33vw', alt: block.settings.caption
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption>{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ECOMS · Clientes (UGC)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Clientes reales"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtítulo",
      "default": "Personas reales usando el producto."
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Foto o video",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (opcional)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Texto / usuario"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "ECOMS · Clientes (UGC)",
      "blocks": [
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "media"
        }
      ]
    }
  ]
}
{% endschema %}
