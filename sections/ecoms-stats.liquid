{%- comment -%}
  ECOMS · Key figures. Store numbers (Direct) or product specs (e.g. «90 min», «IPX7»). Only real,
  verifiable values: blocks without a value are hidden, and so is the section when none is filled.
{%- endcomment -%}
{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.value != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-stats-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ec-stats">
      {%- for block in section.blocks -%}
        {%- if block.settings.value == blank and request.design_mode != true -%}{%- continue -%}{%- endif -%}
        <div {{ block.shopify_attributes }}>
          {% render 'ecoms-icon', name: block.settings.icon %}
          <div>
            <b>{{ block.settings.value | default: '—' | escape }}</b>
            <span>{{ block.settings.label | escape }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

