{%- comment -%} ECOMS · How it works: numbered steps with photos (style "photos") or icons (style "icons", compact). {%- endcomment -%}
{%- liquid
  # Items come from the section blocks, or from a product metafield (list of metaobjects «ecoms_item»)
  # when «Contenido desde metacampo» is set and the product has it. One template then serves every product.
  assign ec_src = section.blocks
  if section.settings.metafield != blank and product
    assign ec_mfp = section.settings.metafield | strip | split: '.'
    if ec_mfp.size == 2
      assign ec_mfl = product.metafields[ec_mfp[0]][ec_mfp[1]].value
      if ec_mfl != blank
        assign ec_src = ec_mfl
      endif
    endif
  endif
-%}
{%- liquid
  assign style = section.settings.style | default: 'photos'
  # «photos» needs real photos: with none it falls back to cards, so the section never shows grey placeholders.
  assign st_has_img = false
  for block in ec_src
    if block.settings.image != blank or block.image.value != blank
      assign st_has_img = true
    endif
  endfor
  if style == 'photos' and st_has_img == false
    assign style = 'cards'
  endif
-%}
{%- assign steps_class = 'ec-steps-sec ec-steps-sec--' | append: style -%}
{%- if ec_src.size > 0 or request.design_mode -%}
<section {% render 'ecoms-section-style', section: section, class: steps_class %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="ec-sec-h">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ec-steps ec-steps--{{ style }}">
      {%- for block in ec_src -%}
        {%- liquid
          assign bk_icon = block.settings.icon | default: block.icon.value
          assign bk_heading = block.settings.heading | default: block.title.value | default: block.label.value
          assign bk_text = block.settings.text | default: block.text.value
        -%}
        <figure {{ block.shopify_attributes }}>
          {%- if style == 'cards' or style == 'numbers' -%}
            <span class="ec-num">{% if style == 'cards' and forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <figcaption><b>{{ bk_heading | escape }}</b>{% if bk_text != blank %}<span>{{ bk_text | escape }}</span>{% endif %}</figcaption>
          {%- elsif style == 'icons' -%}
            <span class="ec-steps__ic">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 64, alt: '' }}
              {%- else -%}
                {% render 'ecoms-icon', name: bk_icon %}
              {%- endif -%}
              <span class="ec-num">{{ forloop.index }}</span>
            </span>
            <figcaption><b>{{ bk_heading | escape }}</b>{% if bk_text != blank %}<span>{{ bk_text | escape }}</span>{% endif %}</figcaption>
          {%- else -%}
            {%- assign st_img = block.settings.image | default: block.image.value -%}
            {%- if st_img != blank -%}
              {{ st_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,500,700,900', sizes: '(min-width: 990px) 33vw, 92vw', alt: bk_heading }}
            {%- endif -%}
            <figcaption><span class="ec-num">{{ forloop.index }}</span><span><b>{{ bk_heading | escape }}</b>{% if bk_text != blank %} {{ bk_text | escape }}{% endif %}</span></figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <p class="ec-steps__cta"><a class="ec-btn ec-btn--primary" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label | escape }} {% render 'ecoms-icon', name: 'arrow' %}</a></p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

