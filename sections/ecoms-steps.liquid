{%- comment -%} ECOMS · How to use, numbered steps with photos. {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-steps-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}<div class="ec-sec-h"><h2>{{ section.settings.heading | escape }}</h2></div>{%- endif -%}
    <div class="ec-steps">
      {%- for block in section.blocks -%}
        <figure {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '250,400,600', sizes: '(min-width: 990px) 25vw, 50vw' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}
          {%- endif -%}
          <figcaption><span class="ec-num">{{ forloop.index }}</span><span><b>{{ block.settings.heading | escape }}</b>{% if block.settings.text != blank %} {{ block.settings.text | escape }}{% endif %}</span></figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ECOMS · Cómo se usa",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Así de fácil es usarlo"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Paso sencillo"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Detalle",
          "default": "Explica qué debe hacer el cliente."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "ECOMS · Cómo se usa",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ],
  "tag": "section"
}
{% endschema %}
