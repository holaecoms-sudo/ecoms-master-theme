{%- comment -%}
  ECOMS · Store lines (verticals) for the home page. Each block is one line of the store: a live one links to its
  collection and shows its real product count; a «Próximamente» one is shown muted and is not a link.
{%- endcomment -%}
{%- assign vt_layout = section.settings.layout | default: 'grid' -%}
<section class="ec-sec ec-vt ec-vt--{{ vt_layout }}" id="{{ section.settings.anchor | default: 'lineas' | handleize }}" style="--ec-pt: {{ section.settings.padding_top }}px; --ec-pb: {{ section.settings.padding_bottom }}px;">
  <div class="ec-w">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="ec-sec-h">
        {%- if section.settings.eyebrow != blank -%}<p class="ec-vt__k">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="ec-vt__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign live = false
          if b.status == 'live' and b.collection != blank
            assign live = true
          endif
          # «Solo próximas» layout: live lines are already sold above, so only upcoming ones are listed.
          if vt_layout == 'soon' and live
            continue
          endif
          assign count = 0
          if live
            assign count = b.collection.products_count
          endif
        -%}
        <li class="ec-vt__item{% unless live %} ec-vt__item--soon{% endunless %}" style="--vt-accent: {{ b.accent | default: '#3B82F6' }};" {{ block.shopify_attributes }}>
          {%- if live -%}<a class="ec-vt__card" href="{{ b.collection.url }}">{%- else -%}<div class="ec-vt__card" aria-disabled="true">{%- endif -%}
            {%- if b.image != blank -%}
              <span class="ec-vt__img">{{ b.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320,480,640', sizes: '(min-width: 990px) 280px, (min-width: 750px) 45vw, 92vw', alt: '' }}</span>
            {%- endif -%}
            <span class="ec-vt__body">
              <span class="ec-vt__top">
                <span class="ec-vt__ic">{% render 'ecoms-icon', name: b.icon %}</span>
                <span class="ec-vt__pill">
                  {%- if live -%}
                    {%- if count > 0 -%}{{ count }} {% if count == 1 %}producto{% else %}productos{% endif %}{%- else -%}{{ section.settings.live_label | escape }}{%- endif -%}
                  {%- else -%}
                    {{ section.settings.soon_label | escape }}
                  {%- endif -%}
                </span>
              </span>
              <span class="ec-vt__name">{{ b.name | escape }}</span>
              {%- if b.text != blank -%}<span class="ec-vt__text">{{ b.text | escape }}</span>{%- endif -%}
              {%- if live == false and section.settings.show_notify -%}
                {%- assign nf_id = 'ec-notify-' | append: block.id -%}
                {%- assign nf_tag = b.notify_tag | default: b.name | handleize -%}
                {%- form 'customer', id: nf_id -%}<div class="ec-vt__form">
                  <input type="hidden" name="contact[tags]" value="newsletter,interes-{{ nf_tag | escape }}">
                  <label class="visually-hidden" for="{{ nf_id }}-email">Email</label>
                  <input id="{{ nf_id }}-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.notify_placeholder | escape }}">
                  <button type="submit">{{ section.settings.notify_button | escape }}</button>
                  {{ form.errors | default_errors }}
                  <p class="ec-vt__ok" hidden>{{ section.settings.notify_success | escape }}</p>
                </div>{%- endform -%}
              {%- endif -%}
              {%- if live -%}
                <span class="ec-vt__cta">{{ b.button_label | default: section.settings.button_label | escape }} {% render 'ecoms-icon', name: 'arrow' %}</span>
              {%- endif -%}
            </span>
          {%- if live -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- if section.settings.show_notify -%}
    <script>
      (function () {
        // Shopify returns to the page with ?customer_posted=true#<form id>: confirm on that card only.
        if (!/customer_posted=true/.test(location.search) || !location.hash) return;
        var f = document.getElementById(location.hash.slice(1));
        var box = f && f.querySelector('.ec-vt__form');
        if (!box) return;
        box.classList.add('is-done');
        f = box;
        var ok = f.querySelector('.ec-vt__ok');
        if (ok) ok.hidden = false;
      })();
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "ECOMS · Líneas",
  "tag": "div",
  "class": "ec-vt-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestras líneas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Encuentra lo que necesitas" },
    { "type": "text", "id": "text", "label": "Texto" },
    {
      "type": "select",
      "id": "layout",
      "label": "Mostrar",
      "options": [
        { "value": "grid", "label": "Todas las líneas" },
        { "value": "soon", "label": "Solo las próximas (franja «Próximamente»)" }
      ],
      "default": "grid"
    },
    { "type": "text", "id": "anchor", "label": "Ancla del enlace", "default": "lineas", "info": "Para enlazar desde el menú, ej.: /#proximamente." },
    { "type": "text", "id": "button_label", "label": "Botón de las líneas disponibles", "default": "Ver productos" },
    { "type": "text", "id": "live_label", "label": "Etiqueta de línea disponible", "default": "Disponible" },
    { "type": "text", "id": "soon_label", "label": "Etiqueta de línea próxima", "default": "Próximamente" },
    { "type": "header", "content": "Avísame cuando llegue" },
    { "type": "checkbox", "id": "show_notify", "label": "Formulario en las líneas próximas", "default": true, "info": "Guarda el email como cliente suscrito con la etiqueta interes-<línea> (Clientes en Shopify)." },
    { "type": "text", "id": "notify_placeholder", "label": "Texto del campo", "default": "Tu email" },
    { "type": "text", "id": "notify_button", "label": "Botón", "default": "Avísame" },
    { "type": "text", "id": "notify_success", "label": "Mensaje al enviar", "default": "¡Listo! Te avisaremos cuando llegue." },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Línea",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Ecoms Clean" },
        { "type": "text", "id": "text", "label": "Descripción corta" },
        {
          "type": "select",
          "id": "status",
          "label": "Estado",
          "options": [
            { "value": "live", "label": "Disponible (enlaza a la colección)" },
            { "value": "soon", "label": "Próximamente" }
          ],
          "default": "soon"
        },
        { "type": "collection", "id": "collection", "label": "Colección", "info": "Obligatoria para «Disponible»." },
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "sparkle", "label": "Brillo" },
            { "value": "home", "label": "Casa" },
            { "value": "paw", "label": "Huella" },
            { "value": "gem", "label": "Gema" },
            { "value": "heart", "label": "Corazón" },
            { "value": "leaf", "label": "Hoja" },
            { "value": "drop", "label": "Gota" },
            { "value": "washer", "label": "Lavadora" },
            { "value": "sun", "label": "Sol" }
          ],
          "default": "sparkle"
        },
        { "type": "color", "id": "accent", "label": "Color de la línea", "default": "#3B82F6" },
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional)", "info": "Recomendado 4:3, 800 × 600." },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "info": "Vacío = el de la sección." },
        { "type": "text", "id": "notify_tag", "label": "Etiqueta de interesados", "info": "Vacío = el nombre de la línea. Ej.: belleza → interes-belleza." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ECOMS · Líneas",
      "blocks": [
        { "type": "line", "settings": { "name": "Ecoms Clean", "status": "live", "icon": "sparkle" } },
        { "type": "line", "settings": { "name": "Hogar y mascotas", "icon": "paw" } },
        { "type": "line", "settings": { "name": "Belleza", "icon": "gem" } },
        { "type": "line", "settings": { "name": "Bienestar", "icon": "leaf" } }
      ]
    }
  ]
}
{% endschema %}
