{%- comment -%} ECOMS · Brand story: copy + lifestyle image. {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-story-sec' %}>
  <div class="ec-story">
    <div class="ec-story__txt">
      {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.link != blank and section.settings.link_label != blank -%}
        <a class="ec-btn ec-btn--ghost ec-btn--sm" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'ecoms-icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="ec-story__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,600,900,1200,1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'ec-placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ECOMS · Historia visual",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "DESCUBRE LA EXPERIENCIA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Un producto pensado para tu día a día"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Historia",
      "default": "<p>Explica con claridad qué problema resuelve el producto y qué cambia para el cliente.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fotografía lifestyle"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto enlace"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        {
          "value": "full",
          "label": "Completo"
        },
        {
          "value": "left",
          "label": "Mitad izquierda"
        },
        {
          "value": "right",
          "label": "Mitad derecha"
        },
        {
          "value": "t1",
          "label": "Tercio 1"
        },
        {
          "value": "t2",
          "label": "Tercio 2"
        },
        {
          "value": "t3",
          "label": "Tercio 3"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "ECOMS · Historia visual"
    }
  ],
  "tag": "section"
}
{% endschema %}
