<section class="ecoms-section ecoms-story" id="ecoms-story-{{ section.id }}">
 <div class="page-width"><div class="ecoms-story__grid">
  <div class="ecoms-story__copy">
   {% if section.settings.eyebrow != blank %}<span class="ecoms-eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
   <h2>{{ section.settings.heading | escape }}</h2>
   <div class="ecoms-story__text rte">{{ section.settings.text }}</div>
   {% if section.settings.link != blank and section.settings.link_label != blank %}<a class="ecoms-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} →</a>{% endif %}
  </div>
  <div class="ecoms-story__media">
   {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,600,900,1200,1400', class: 'ecoms-story__image' }}
   {% elsif request.design_mode %}<div class="ecoms-photo-placeholder">Agrega una imagen lifestyle aquí</div>{% endif %}
  </div>
 </div></div>
</section>
{% schema %}
{"name":"ECOMS · Historia visual","settings":[{"type":"text","id":"eyebrow","label":"Texto superior","default":"DESCUBRE LA EXPERIENCIA"},{"type":"text","id":"heading","label":"Título","default":"Un producto pensado para tu día a día"},{"type":"richtext","id":"text","label":"Historia","default":"<p>Explica con claridad qué problema resuelve el producto y qué cambia para el cliente.</p>"},{"type":"image_picker","id":"image","label":"Fotografía lifestyle"},{"type":"text","id":"link_label","label":"Texto enlace"},{"type":"url","id":"link","label":"Enlace"}],"presets":[{"name":"ECOMS · Historia visual"}]}
{% endschema %}
