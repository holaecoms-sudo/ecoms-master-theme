{%- comment -%} ECOMS · Header (mockup): logo, centered menu, search / account / cart, mobile menu. {%- endcomment -%}
{%- liquid
  assign store_name = settings.ecoms_store_name | default: shop.name
  # Vertical (sub-brand): its own logo, menu and home link on its pages; the rest of the store is untouched.
  capture ec_vslot
    render 'ecoms-vertical'
  endcapture
  assign hdr_menu = section.settings.menu
  assign hdr_home = routes.root_url
  if ec_vslot != blank
    assign vk = 'ecoms_v' | append: ec_vslot | append: '_menu'
    if settings[vk] != blank
      assign hdr_menu = settings[vk]
    endif
    assign vk = 'ecoms_v' | append: ec_vslot | append: '_key'
    assign vkey = settings[vk]
    if settings.ecoms_vertical_default == blank
      assign hdr_home = routes.collections_url | append: '/' | append: vkey
    endif
  endif
  # Focus mode: hide the menu on product pages (or everywhere) so shoppers stay on the offer.
  assign show_menu = true
  if section.settings.menu_visibility == 'never'
    assign show_menu = false
  elsif section.settings.menu_visibility == 'not_product' and template.name == 'product'
    assign show_menu = false
  endif
  # Same focus rule for the logo: on product pages it can stay as a plain logo, not a link out of the offer.
  assign logo_link = true
  if section.settings.logo_link == 'never'
    assign logo_link = false
  elsif section.settings.logo_link == 'not_product' and template.name == 'product'
    assign logo_link = false
  endif
-%}
<header class="ec-hdr" role="banner">
  <div class="ec-w ec-hdr__bar">
    {%- if show_menu and hdr_menu.links.size > 0 -%}
      <details class="ec-hdr__mobile">
        <summary class="ec-icon-btn" aria-label="Abrir menú">{% render 'ecoms-icon', name: 'menu' %}</summary>
        <nav class="ec-hdr__drawer" aria-label="Menú móvil">
          {%- for link in hdr_menu.links -%}
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- for child in link.links -%}
              <a class="ec-hdr__sub" href="{{ child.url }}">{{ child.title | escape }}</a>
            {%- endfor -%}
          {%- endfor -%}
        </nav>
      </details>
    {%- endif -%}
    {%- if logo_link -%}<a href="{{ hdr_home }}" class="ec-logo{% if ec_vslot != blank %} ec-logo--vertical{% endif %}">{%- else -%}<span class="ec-logo{% if ec_vslot != blank %} ec-logo--vertical{% endif %}">{%- endif -%}
      {%- if ec_vslot != blank -%}
        {%- assign vk = 'ecoms_v' | append: ec_vslot | append: '_logo_height' -%}
        {%- render 'ecoms-vertical-logo', slot: ec_vslot, height: settings[vk], eager: true -%}
      {%- elsif settings.logo != blank -%}
        {%- assign logo_h = section.settings.logo_height -%}
        {{ settings.logo | image_url: height: 120 | image_tag: height: logo_h, alt: store_name, loading: 'eager' }}
      {%- else -%}
        {%- comment -%} No logo uploaded in the theme settings: the built-in ecoms beauty logo (SVG). {%- endcomment -%}
        <img src="{{ 'ecoms-beauty-logo.png' | asset_url }}" alt="{{ store_name | escape }}" height="{{ section.settings.logo_height | default: 32 }}" style="height: {{ section.settings.logo_height | default: 32 }}px; width: auto;">
      {%- endif -%}
    {%- if logo_link -%}</a>{%- else -%}</span>{%- endif -%}
    <nav class="ec-nav" aria-label="Principal">
      {%- if show_menu -%}
        {%- for link in hdr_menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="ec-nav__dd">
              <a href="{{ link.url }}" class="{% if link.active or link.child_active %}on{% endif %}" aria-haspopup="true">{{ link.title | escape }} <span class="ec-nav__caret" aria-hidden="true"></span></a>
              <div class="ec-nav__menu">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}"{% if child.active %} class="on" aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="{% if link.active or link.child_active %}on{% endif %}">{{ link.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>
    {%- if section.settings.social_text != blank -%}
      <div class="ec-hdr__social">{% render 'ecoms-icon', name: 'star' %}{{ section.settings.social_text | escape }}</div>
    {%- endif -%}
    <div class="ec-hdr__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="ec-icon-btn" aria-label="Buscar">{% render 'ecoms-icon', name: 'search' %}</a>
      {%- endif -%}
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="ec-icon-btn" aria-label="Mi cuenta">{% render 'ecoms-icon', name: 'user' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="ec-icon-btn ec-hdr__cart" id="cart-icon-bubble">
        {%- render 'ecoms-cart-icon' -%}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "ECOMS · Header",
  "tag": "section",
  "class": "ec-hdr-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "menu_visibility",
      "label": "Mostrar menú",
      "options": [
        {
          "value": "always",
          "label": "En todas las páginas"
        },
        {
          "value": "not_product",
          "label": "Ocultar en páginas de producto"
        },
        {
          "value": "never",
          "label": "Nunca (solo logo y carrito)"
        }
      ],
      "default": "always",
      "info": "Ocultarlo en las páginas de producto evita que el cliente se distraiga de la compra."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Mostrar buscador",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Mostrar inicio de sesión",
      "default": true
    },
    {
      "type": "select",
      "id": "logo_icon",
      "label": "Ícono junto al nombre (sin logo)",
      "options": [
        {
          "value": "none",
          "label": "Sin icono"
        },
        {
          "value": "truck",
          "label": "Camión / envío"
        },
        {
          "value": "lock",
          "label": "Candado / pago seguro"
        },
        {
          "value": "shield",
          "label": "Escudo / garantía"
        },
        {
          "value": "return",
          "label": "Devolución"
        },
        {
          "value": "chat",
          "label": "Soporte"
        },
        {
          "value": "cash",
          "label": "Pago / efectivo"
        },
        {
          "value": "gift",
          "label": "Regalo"
        },
        {
          "value": "star",
          "label": "Estrella"
        },
        {
          "value": "heart",
          "label": "Corazón"
        },
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "clock",
          "label": "Reloj"
        },
        {
          "value": "fire",
          "label": "Fuego / oferta"
        },
        {
          "value": "bolt",
          "label": "Rayo / potencia"
        },
        {
          "value": "sparkle",
          "label": "Brillo"
        },
        {
          "value": "leaf",
          "label": "Hoja / natural"
        },
        {
          "value": "drop",
          "label": "Gota / agua"
        },
        {
          "value": "snow",
          "label": "Frío"
        },
        {
          "value": "thermo",
          "label": "Temperatura"
        },
        {
          "value": "sun",
          "label": "Sol / luz"
        },
        {
          "value": "gem",
          "label": "Gema / premium"
        },
        {
          "value": "hand",
          "label": "Mano / fácil"
        },
        {
          "value": "users",
          "label": "Personas"
        },
        {
          "value": "box",
          "label": "Caja / paquete"
        },
        {
          "value": "grid",
          "label": "Accesorios"
        },
        {
          "value": "battery",
          "label": "Batería"
        },
        {
          "value": "home",
          "label": "Hogar"
        },
        {
          "value": "verified",
          "label": "Verificado"
        },
        {
          "value": "bag",
          "label": "Bolsa / tienda"
        },
        {
          "value": "cart",
          "label": "Carrito"
        }
      ],
      "default": "bag"
    },
    {
      "type": "select",
      "id": "logo_link",
      "label": "Logo con enlace",
      "options": [
        { "value": "always", "label": "En todas las páginas" },
        { "value": "not_product", "label": "Sin enlace en páginas de producto" },
        { "value": "never", "label": "Nunca" }
      ],
      "default": "always",
      "info": "Sin enlace, el comprador no sale de la ficha por el logo."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Alto del logo",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "social_text",
      "label": "Prueba social (cifra real)",
      "info": "Ej.: +1.200 clientes. Opcional."
    }
  ],
  "presets": [
    {
      "name": "ECOMS · Header"
    }
  ]
