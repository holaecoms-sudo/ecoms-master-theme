        },
        {
          "value": "chat",
          "label": "Soporte"
        },
        {
          "value": "cash",
          "label": "Pago / efectivo"
        },
        {
          "value": "gift",
          "label": "Regalo"
        },
        {
          "value": "star",
          "label": "Estrella"
        },
        {
          "value": "heart",
          "label": "Corazón"
        },
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "clock",
          "label": "Reloj"
        },
        {
          "value": "fire",
          "label": "Fuego / oferta"
        },
        {
          "value": "bolt",
          "label": "Rayo / potencia"
        },
        {
          "value": "sparkle",
          "label": "Brillo"
        },
        {
          "value": "leaf",
          "label": "Hoja / natural"
        },
        {
          "value": "drop",
          "label": "Gota / agua"
        },
        {
          "value": "snow",
          "label": "Frío"
        },
        {
          "value": "thermo",
          "label": "Temperatura"
        },
        {
          "value": "sun",
          "label": "Sol / luz"
        },
        {
          "value": "gem",
