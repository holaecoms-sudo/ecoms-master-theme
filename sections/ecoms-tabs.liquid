{%- comment -%}
  ECOMS · Uso por zona: tabs (Baño, Cocina, Pisos…) with photo + copy. CSS-only (radio inputs), works
  without JavaScript. Image falls back to a product photo by position.
{%- endcomment -%}
{%- liquid
  # Items come from the section blocks, or from a product metafield (list of metaobjects «ecoms_item»)
  # when «Contenido desde metacampo» is set and the product has it. One template then serves every product.
  assign ec_src = section.blocks
  assign ec_from_mf = false
  if section.settings.metafield != blank and product
    assign ec_mfp = section.settings.metafield | strip | split: '.'
    if ec_mfp.size == 2
      assign ec_mfl = product.metafields[ec_mfp[0]][ec_mfp[1]].value
      if ec_mfl != blank
        assign ec_src = ec_mfl
        assign ec_from_mf = true
      endif
    endif
  endif
-%}
{%- liquid
  if ec_from_mf
    assign tabs = ec_src
  else
    assign tabs = ec_src | where: 'type', 'tab'
  endif
-%}
{%- if tabs.size > 0 -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-tabs-sec' %}>
  <div class="ec-w">
    <div class="ec-sec-h">
      {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="ec-tabs">
      {%- for block in tabs limit: 6 -%}
        {%- liquid
          assign bk_heading = block.settings.heading | default: block.heading.value
          assign bk_icon = block.settings.icon | default: block.icon.value
          assign bk_image = block.settings.image | default: block.image.value
          assign bk_label = block.settings.label | default: block.label.value
          assign bk_product_image_index = block.settings.product_image_index | default: block.product_image_index.value
          assign bk_text = block.settings.text | default: block.text.value
        -%}
        <input class="ec-tabs__r" type="radio" name="ec-tabs-{{ section.id }}" id="ec-tab-{{ section.id }}-{{ forloop.index }}" {% if forloop.first %}checked{% endif %}>
      {%- endfor -%}
      <div class="ec-tabs__nav">
        {%- for block in tabs limit: 6 -%}
          {%- liquid
            assign bk_heading = block.settings.heading | default: block.heading.value
            assign bk_icon = block.settings.icon | default: block.icon.value
            assign bk_image = block.settings.image | default: block.image.value
            assign bk_label = block.settings.label | default: block.label.value
            assign bk_product_image_index = block.settings.product_image_index | default: block.product_image_index.value
            assign bk_text = block.settings.text | default: block.text.value
          -%}
          <label for="ec-tab-{{ section.id }}-{{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- if bk_icon != 'none' -%}{% render 'ecoms-icon', name: bk_icon %}{%- endif -%}
            {{- bk_label | escape -}}
          </label>
        {%- endfor -%}
      </div>
      <div class="ec-tabs__panels">
        {%- for block in tabs limit: 6 -%}
          {%- liquid
            assign bk_heading = block.settings.heading | default: block.heading.value
            assign bk_icon = block.settings.icon | default: block.icon.value
            assign bk_image = block.settings.image | default: block.image.value
            assign bk_label = block.settings.label | default: block.label.value
            assign bk_product_image_index = block.settings.product_image_index | default: block.product_image_index.value
            assign bk_text = block.settings.text | default: block.text.value
          -%}
          {%- liquid
            assign idx = bk_product_image_index | default: 1 | minus: 1
            assign pic = bk_image | default: product.images[idx] | default: product.featured_image
          -%}
          <div class="ec-tabs__p">
            <div class="ec-tabs__img">
              {%- if pic != blank -%}
                {{ pic | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 560px, 100vw', alt: bk_heading }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}
              {%- endif -%}
            </div>
            <div class="ec-tabs__copy">
              {%- if bk_heading != blank -%}<h3>{{ bk_heading | escape }}</h3>{%- endif -%}
              {%- if bk_text != blank -%}<p>{{ bk_text | escape }}</p>{%- endif -%}
              <ul role="list">
                {%- for i in (1..3) -%}
                  {%- assign key = 'point_' | append: i -%}
                  {%- if block.settings[key] != blank -%}<li>{% render 'ecoms-icon', name: 'check' %}<span>{{ block.settings[key] | escape }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>
              {%- if section.settings.button_label != blank -%}
                <a href="#" class="ec-btn ec-btn--primary" data-ec-scroll-buy{% if settings.ecoms_cod_live %} data-ec-open-cod="{{ settings.ecoms_cod_app_button | escape }}"{% endif %}>{{ section.settings.button_label | escape }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
