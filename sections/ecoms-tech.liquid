{%- comment -%} ECOMS · Technology / how it works (Brand): image + heading + list of features. {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-tech-sec' %}>
  <div class="ec-w">
    <div class="ec-tech">
      {%- assign tech_img = section.settings.image | default: product.images[1] | default: product.featured_image -%}
      {%- if tech_img != blank -%}
        {{ tech_img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 500px, 100vw', alt: section.settings.heading }}
      {%- endif -%}
      <div>
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="ec-tech__text">{{ section.settings.text }}</div>{%- endif -%}
        <ul role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="ec-ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>
              <div><b>{{ block.settings.heading | escape }}</b><span>{{ block.settings.text | escape }}</span></div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

