{%- comment -%}
  ECOMS · Diferencia: a statement plus a grid of small icon badges (what the product is / what it leaves out), with an optional photo.
  Only badges that are true on the label. The photo column disappears when there is no image.
{%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
{{ 'ecoms-ritual-sections.css' | asset_url | stylesheet_tag }}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ds-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h">{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}</div>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<p class="ec-ds__t">{{ section.settings.text | escape }}</p>{%- endif -%}
    <div class="ec-ds{% if section.settings.image == blank %} ec-ds--solo{% endif %}">
    {%- if section.settings.image != blank -%}
      <div class="ec-ds__media">{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 480px, 100vw', alt: section.settings.heading | strip_html }}</div>
    {%- endif -%}
    <div class="ec-ds__copy">
      <ul class="ec-ds__grid" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span class="ec-ds__ic">{% render 'ecoms-icon', name: block.settings.icon %}</span><b>{{ block.settings.label | escape }}</b></li>
        {%- endfor -%}
      </ul>
    </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Diferencia",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "La fórmula, *en claro.*" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "image_picker", "id": "image", "label": "Foto (opcional, cuadrada 1000 x 1000 px)" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Distintivo",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Vegano" },
        { "type": "select", "id": "icon", "label": "Ícono", "default": "check", "options": [
          { "value": "check", "label": "Check" }, { "value": "leaf", "label": "Hoja" }, { "value": "heart", "label": "Corazón" },
          { "value": "drop", "label": "Gota" }, { "value": "shield", "label": "Escudo" }, { "value": "box", "label": "Caja" },
          { "value": "sparkle", "label": "Brillo" }, { "value": "bolt", "label": "Rayo" }, { "value": "verified", "label": "Verificado" }
        ] }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "ECOMS · Diferencia" } ]
}
{% endschema %}
