{%- comment -%} ECOMS · Benefit icons (4 columns on desktop, 2 on mobile). {%- endcomment -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-features' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h"><h2>{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <div class="ec-feat ec-feat--{{ section.settings.style }}">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <span class="ec-ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>
          <div>
            <b>{{ block.settings.heading | escape }}</b>
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

