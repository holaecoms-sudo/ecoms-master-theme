{%- comment -%} ECOMS · Benefit icons (4 columns on desktop, 2 on mobile). {%- endcomment -%}
{%- liquid
  # Items come from the section blocks, or from a product metafield (list of metaobjects «ecoms_item»)
  # when «Contenido desde metacampo» is set and the product has it. One template then serves every product.
  assign ec_src = section.blocks
  if section.settings.metafield != blank and product
    assign ec_mfp = section.settings.metafield | strip | split: '.'
    if ec_mfp.size == 2
      assign ec_mfl = product.metafields[ec_mfp[0]][ec_mfp[1]].value
      if ec_mfl != blank
        assign ec_src = ec_mfl
      endif
    endif
  endif
-%}
{%- if ec_src.size > 0 or request.design_mode -%}
{%- assign ft_class = 'ec-features ec-features--' | append: section.settings.style -%}
<section {% render 'ecoms-section-style', section: section, class: ft_class %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h">{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}</div>
    {%- endif -%}
    <div class="ec-feat ec-feat--{{ section.settings.style }}">
      {%- for block in ec_src -%}
        {%- liquid
          assign bk_icon = block.settings.icon | default: block.icon.value
          assign bk_heading = block.settings.heading | default: block.title.value | default: block.label.value
          assign bk_text = block.settings.text | default: block.text.value
          assign bk_tag = block.tag.value
        -%}
        <div {{ block.shopify_attributes }}>
          {%- if section.settings.style == 'editorial' -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width: 750px) 33vw, 100vw', class: 'ec-feat__img', alt: bk_heading }}
            {%- endif -%}
            <span class="ec-feat__n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          {%- else -%}
          <span class="ec-ic">{% render 'ecoms-icon', name: bk_icon %}</span>
          {%- endif -%}
          <div>
            <b>{{ bk_heading | escape }}</b>
            {%- if bk_tag != blank -%}<em class="ec-feat__tag">{{ bk_tag | escape }}</em>{%- endif -%}
            {%- if bk_text != blank -%}
              <span>{{ bk_text | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

