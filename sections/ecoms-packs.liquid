      "info": "Resumen bajo los packs con la cantidad, el ahorro y el envío gratis del pack elegido."
    },
    {
      "type": "text",
      "id": "summary_label",
      "label": "Título del resumen",
      "default": "Tu pack incluye"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping",
