{%- comment -%}
  ECOMS · Pain → gain: what the shopper lives with today (left) against what changes with the product (right).
  One item per line. Only sensations and claims the product can honestly support.
{%- endcomment -%}
{%- assign pg_pain = section.settings.pain_items | newline_to_br | split: '<br />' -%}
{%- assign pg_gain = section.settings.gain_items | newline_to_br | split: '<br />' -%}
{%- if section.settings.pain_items != blank and section.settings.gain_items != blank -%}
{{ 'ecoms-ritual-sections.css' | asset_url | stylesheet_tag }}
<section {% render 'ecoms-section-style', section: section, class: 'ec-pg-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h">{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}</div>
    {%- endif -%}
    <div class="ec-pg">
      {%- if section.settings.intro != blank -%}<p class="ec-pg__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
      <div class="ec-pg__col ec-pg__col--pain">
        <b>{{ section.settings.pain_title | default: 'Te pasa que…' | escape }}</b>
        <ul role="list">{%- for it in pg_pain -%}{%- assign it_t = it | strip -%}{%- if it_t != blank -%}<li>{{ it_t | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
      </div>
      <div class="ec-pg__col ec-pg__col--gain">
        <b>{{ section.settings.gain_title | default: 'Con este producto…' | escape }}</b>
        <ul role="list">{%- for it in pg_gain -%}{%- assign it_t = it | strip -%}{%- if it_t != blank -%}<li>{{ it_t | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
      </div>
      {%- if section.settings.closing != blank -%}<p class="ec-pg__close">{{ section.settings.closing | escape }}</p>{%- endif -%}
      {%- if section.settings.note != blank -%}<p class="ec-pg__note">{{ section.settings.note | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="ec-pg__cta-wrap"><a href="#" class="ec-btn ec-btn--accent ec-btn--lg ec-pg__cta" data-ec-scroll-buy>{{ section.settings.button_label | escape }}</a></div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Dolor y beneficio",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Te pasa que… | Cuando la piel se siente *incómoda,* se nota." },
    { "type": "textarea", "id": "intro", "label": "Texto de apertura" },
    { "type": "text", "id": "pain_title", "label": "Título columna «dolor»", "default": "Te pasa que…" },
    { "type": "textarea", "id": "pain_items", "label": "Dolores (una línea por punto)" },
    { "type": "text", "id": "gain_title", "label": "Título columna «beneficio»", "default": "Con este producto…" },
    { "type": "textarea", "id": "gain_items", "label": "Beneficios (una línea por punto)" },
    { "type": "text", "id": "closing", "label": "Frase de cierre" },
    { "type": "text", "id": "note", "label": "Nota pequeña", "default": "Resultados cosméticos de apariencia; varían según cada piel y la constancia de uso." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Quiero probarlo" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 }
  ],
  "presets": [ { "name": "ECOMS · Dolor y beneficio" } ]
}
{% endschema %}
