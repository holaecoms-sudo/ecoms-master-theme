{%- comment -%}
  ECOMS · Beneficios con +: a list of benefit pills that open one at a time, next to a photo (or a product photo by position).
  Appearance/function language only; every line must be verifiable.
{%- endcomment -%}
{%- liquid
  assign sec_alt = section.settings.heading | strip_html | replace: '*', ''
  assign bl_img = section.settings.image
  if bl_img == blank and section.settings.product_image_index > 0
    assign bl_i = section.settings.product_image_index | minus: 1
    assign bl_img = product.images[bl_i]
    if bl_img == blank
      assign bl_img = product.media[bl_i].preview_image
    endif
    if bl_img == blank
      assign bl_img = product.featured_image
    endif
  endif
-%}
{%- if section.blocks.size > 0 or request.design_mode -%}
{{ 'ecoms-ritual-sections.css' | asset_url | stylesheet_tag }}
<section {% render 'ecoms-section-style', section: section, class: 'ec-bl-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="ec-sec-h">
        {%- if section.settings.eyebrow != blank -%}<p class="ec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}{%- endif -%}
      </div>
    {%- endif -%}
    <!-- ec-bl image: idx={{ section.settings.product_image_index }} images={{ product.images.size }} media={{ product.media.size }} found={% if bl_img != blank %}yes{% else %}no{% endif %} -->
    <div class="ec-bl{% if bl_img == blank %} ec-bl--solo{% endif %}">
    <div class="ec-bl__copy">
      <div class="ec-bl__list" data-ec-bl>
        {%- for block in section.blocks -%}
          <details class="ec-bl__i" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
            <summary><span>{{ block.settings.title | escape }}</span><i class="ec-bl__plus" aria-hidden="true"></i></summary>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </details>
        {%- endfor -%}
      </div>
      {%- if section.settings.note != blank -%}<p class="ec-bl__note">{{ section.settings.note | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="#" class="ec-btn ec-btn--accent ec-btn--lg ec-bl__cta" data-ec-scroll-buy>{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    {%- if bl_img != blank -%}
      <div class="ec-bl__media">{{ bl_img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 480px, 100vw', alt: sec_alt }}</div>
    {%- endif -%}
    </div>
  </div>
  <script>
    (function () {
      var box = document.currentScript.parentNode.querySelector('[data-ec-bl]');
      if (!box || box.__ecBl) return;
      box.__ecBl = true;
      box.addEventListener('toggle', function (e) {
        var d = e.target;
        if (!d.open) return;
        box.querySelectorAll('details[open]').forEach(function (o) { if (o !== d) o.open = false; });
      }, true);
    })();
  </script>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Beneficios con +",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Beneficios" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que aporta a *tu rutina.*" },
    { "type": "image_picker", "id": "image", "label": "Foto (opcional, cuadrada 1000 x 1000 px)" },
    { "type": "range", "id": "product_image_index", "label": "O usar la foto N° de la galería del producto", "min": 0, "max": 20, "step": 1, "default": 0, "info": "0 = no usar." },
    { "type": "text", "id": "note", "label": "Nota pequeña" },
    { "type": "text", "id": "button_label", "label": "Botón" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        { "type": "text", "id": "title", "label": "Beneficio", "default": "Apoya tu metabolismo energético" },
        { "type": "textarea", "id": "text", "label": "Detalle (se abre con el +)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "ECOMS · Beneficios con +" } ]
}
{% endschema %}
