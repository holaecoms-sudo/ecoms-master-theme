{%- comment -%}
  ECOMS · Zonas y efecto: where the product can be used (a tile per body area, optional photo) and what it does (three numbered effects).
  Appearance language only. Tiles/effects without a title are skipped.
{%- endcomment -%}
{%- liquid
  assign ze_zones = 0
  assign ze_effects = 0
  for block in section.blocks
    if block.type == 'zone' and block.settings.label != blank
      assign ze_zones = ze_zones | plus: 1
    elsif block.type == 'effect' and block.settings.title != blank
      assign ze_effects = ze_effects | plus: 1
    endif
  endfor
-%}
{%- if ze_zones > 0 or ze_effects > 0 or request.design_mode -%}
{%- render 'ecoms-css-defer', href: 'ecoms-ritual-sections.css' -%}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ze-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h">{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}</div>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<p class="ec-ze__intro">{{ section.settings.text | escape }}</p>{%- endif -%}
    <div class="ec-ze__zones" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'zone' and block.settings.label != blank -%}
          <article class="ec-ze__zone" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="ec-ze__ph">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 750px) 22vw, 46vw', alt: block.settings.label }}</div>
            {%- else -%}
              <span class="ec-ze__ic">{% render 'ecoms-icon', name: block.settings.icon %}</span>
            {%- endif -%}
            <b>{{ block.settings.label | escape }}</b>
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if ze_effects > 0 -%}
      {%- if section.settings.effects_heading != blank -%}
        <div class="ec-sec-h ec-ze__h2">{% render 'ecoms-heading', text: section.settings.effects_heading, tag: 'h2' %}</div>
      {%- endif -%}
      <ol class="ec-ze__effects" role="list">
        {%- assign ze_n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'effect' and block.settings.title != blank -%}
            {%- assign ze_n = ze_n | plus: 1 -%}
            <li {{ block.shopify_attributes }}>
              <span class="ec-ze__n">{{ ze_n }}</span>
              <div><b>{{ block.settings.title | escape }}</b><span>{{ block.settings.text | escape }}</span></div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<p class="ec-ze__note">{{ section.settings.note | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="#" class="ec-btn ec-btn--accent ec-btn--lg ec-ze__cta" data-ec-scroll-buy>{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Zonas y efecto",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Dónde usarlo | Un spray para *todo el cuerpo.*" },
    { "type": "textarea", "id": "text", "label": "Texto de apertura" },
    { "type": "text", "id": "effects_heading", "label": "Título de los efectos", "default": "Qué hace | Lo que hace en *tu piel.*" },
    { "type": "text", "id": "note", "label": "Nota pequeña", "default": "Resultados cosméticos de apariencia; varían según cada piel y la constancia de uso." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Elegir mi pack" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Zona",
      "settings": [
        { "type": "text", "id": "label", "label": "Zona", "default": "Codos y rodillas" },
        { "type": "textarea", "id": "text", "label": "Texto corto" },
        { "type": "select", "id": "icon", "label": "Ícono (si no hay foto)", "default": "drop", "options": [
          { "value": "drop", "label": "Gota" }, { "value": "hand", "label": "Mano" }, { "value": "sparkle", "label": "Brillo" },
          { "value": "sun", "label": "Sol" }, { "value": "leaf", "label": "Hoja" }, { "value": "heart", "label": "Corazón" }, { "value": "check", "label": "Check" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Foto de la zona (opcional, cuadrada 1000 x 1000 px)" }
      ]
    },
    {
      "type": "effect",
      "name": "Efecto",
      "settings": [
        { "type": "text", "id": "title", "label": "Efecto", "default": "Exfolia suavemente" },
        { "type": "textarea", "id": "text", "label": "Cómo ayuda" }
      ]
    }
  ],
  "presets": [ { "name": "ECOMS · Zonas y efecto" } ]
}
{% endschema %}
