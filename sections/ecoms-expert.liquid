{%- comment -%}
  ECOMS · Opinión experta: one real quote from a professional, with photo, name and role.
  Only publish with that person's written permission. Hidden until quote, name and photo are all filled.
{%- endcomment -%}
{%- if section.settings.quote != blank and section.settings.name != blank and section.settings.image != blank -%}
{{ 'ecoms-ritual-sections.css' | asset_url | stylesheet_tag }}
<section {% render 'ecoms-section-style', section: section, class: 'ec-ex-sec' %}>
  <div class="ec-w">
    {%- if section.settings.heading != blank -%}
      <div class="ec-sec-h">{% render 'ecoms-heading', text: section.settings.heading, tag: 'h2' %}</div>
    {%- endif -%}
    <div class="ec-ex">
    <div class="ec-ex__ph">{{ section.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 750px) 240px, 40vw', alt: section.settings.name }}</div>
    <div class="ec-ex__copy">
      <blockquote>{{ section.settings.quote | escape }}</blockquote>
      <p class="ec-ex__n"><b>{{ section.settings.name | escape }}</b>{%- if section.settings.role != blank -%}<span>{{ section.settings.role | escape }}</span>{%- endif -%}</p>
    </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "ECOMS · Opinión experta",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Opinión de una *profesional.*" },
    { "type": "textarea", "id": "quote", "label": "Cita textual", "info": "Solo con el permiso por escrito de la persona." },
    { "type": "text", "id": "name", "label": "Nombre" },
    { "type": "text", "id": "role", "label": "Cargo o especialidad" },
    { "type": "image_picker", "id": "image", "label": "Foto (cuadrada, 600 x 600 px)" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [ { "name": "ECOMS · Opinión experta" } ]
}
{% endschema %}
