{%- comment -%}
  ECOMS · Promotion countdown with a real end date.
  The end date is written in the store's time zone ("2026-12-31 23:59") or as ISO 8601 with offset
  ("2026-12-31T23:59:00-03:00"). It can be connected to a product metafield (date_time) from the
  editor. Nothing renders without a valid future date, and the script hides it once it expires:
  the timer never restarts or invents urgency.

  Accepts:
  - source: {Object} block or section with settings: end_at, heading, text, show_days, style
  - attrs: {String} optional editor attributes
{%- endcomment -%}
{%- liquid
  assign s = source.settings
  assign end_ts = 0
  if s.end_at != blank
    assign end_clean = s.end_at | remove: '"' | remove: "'" | strip
    # A full date is required: a bare time ("23:59") would restart every day, i.e. fake urgency.
    if end_clean.size >= 10 and end_clean contains '-'
      assign end_ts = end_clean | date: '%s' | plus: 0
    endif
  endif
  assign now_ts = 'now' | date: '%s' | plus: 0
  # Long promos always show days (never «2001 horas»), whatever «show_days» says.
  assign cd_days = s.show_days
  assign cd_left = end_ts | minus: now_ts
  if cd_left >= 172800
    assign cd_days = true
  endif
  assign style = s.style | default: 'boxes'
-%}
{%- if end_ts > now_ts -%}
  <div class="ec-urg ec-urg--{{ style }}" data-ec-countdown="{{ end_ts }}" {{ attrs }}>
    <div class="ec-urg__copy">
      {%- if s.heading != blank -%}
        <p class="ec-urg__t">{% render 'ecoms-icon', name: s.icon %}<span>{{ s.heading | escape }}</span></p>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="ec-urg__s">{{ s.text | escape }}</p>
      {%- endif -%}
    </div>
    {%- if style == 'inline' -%}
      <span class="ec-timer" data-ec-cd-inline>--:--:--</span>
    {%- else -%}
      <div class="ec-cd" role="timer" aria-live="off">
        {%- if cd_days -%}
          <div><b data-u="d">00</b><small>Días</small></div>
        {%- endif -%}
        <div><b data-u="h">00</b><small>Horas</small></div>
        <div><b data-u="m">00</b><small>Minutos</small></div>
        <div><b data-u="s">00</b><small>Segundos</small></div>
      </div>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <p class="ec-editor-note" {{ attrs }}>
    Cuenta regresiva oculta: ingresa una fecha de término futura que corresponda a una promoción real.
  </p>
{%- endif -%}
