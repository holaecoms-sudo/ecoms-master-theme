{%- comment -%}
  ECOMS · Quantity packs (1 / 2 / 3 units) wired to Dawn's product form.

  Selecting a pack sets the real quantity of the main product form. Pack prices only show a
  discount when "discounts_live" is checked, which confirms that matching automatic discounts
  exist in Shopify Admin (Descuentos → Monto de descuento en productos, cantidad mínima 2 / 3).
  Shopify applies the best eligible discount in cart and checkout; this snippet only mirrors it.

  Accepts:
  - product: {Object}
  - source: {Object} block or section whose settings configure the packs
  - uid: {String} unique id (block.id or section.id)
  - attrs: {String} optional editor attributes
  - section_url_id: {String} optional, set when rendered from a standalone section so the
    script can re-render it through the Section Rendering API on variant change
{%- endcomment -%}
{%- liquid
  assign s = source.settings
  assign variant = product.selected_or_first_available_variant
  assign unit = variant.price
  assign unit_compare = variant.compare_at_price | default: 0
  if unit_compare < unit
    assign unit_compare = unit
  endif
  assign live = s.discounts_live
  assign layout = s.layout | default: 'cards'
  assign has_pending_discount = false
-%}
{%- capture tiers_json -%}
  [{"q":1,"pct":0}
  {%- for i in (2..3) -%}
    {%- assign q_key = 'tier' | append: i | append: '_qty' -%}
    {%- assign p_key = 'tier' | append: i | append: '_pct' -%}
    {%- assign on_key = 'tier' | append: i | append: '_enabled' -%}
    {%- if s[on_key] -%}
      {%- assign pct = s[p_key] | default: 0 -%}
      {%- unless live -%}{%- assign pct = 0 -%}{%- endunless -%}
      ,{"q":{{ s[q_key] | default: i }},"pct":{{ pct }}}
    {%- endif -%}
  {%- endfor -%}]
{%- endcapture -%}

<div
  id="EcPacks-{{ uid }}"
  class="ec-packs ec-packs--{{ layout }}"
  data-ec-packs
  data-ec-refresh
  {% if section_url_id %}
    data-ec-refresh-section="{{ section_url_id }}"
  {% endif %}
  data-tiers="{{ tiers_json | strip_newlines | replace: ' ', '' | escape }}"
  data-unit="{{ unit }}"
  {% if s.show_cta_total %}
    data-cta-total
  {% endif %}
  {{ attrs }}
>
  <fieldset class="ec-packs__set">
    {%- if s.heading != blank -%}
      <legend class="ec-packs__h">{{ s.heading | escape }}</legend>
    {%- endif -%}
    <div class="ec-packs__grid">
      {%- for i in (1..3) -%}
        {%- liquid
          assign on_key = 'tier' | append: i | append: '_enabled'
          assign show_tier = true
          if i > 1 and s[on_key] != true
            assign show_tier = false
          endif
          if i == 1
            assign q = 1
            assign pct = 0
          else
            assign q_key = 'tier' | append: i | append: '_qty'
            assign p_key = 'tier' | append: i | append: '_pct'
            assign q = s[q_key] | default: i
            assign pct = s[p_key] | default: 0
            if pct > 0 and live != true
              assign has_pending_discount = true
              assign pct = 0
            endif
          endif
          assign tag_key = 'tier' | append: i | append: '_tag'
          assign img_key = 'tier' | append: i | append: '_image'
          assign label_key = 'tier' | append: i | append: '_label'
          assign tag = s[tag_key]
          assign pack_image = s[img_key] | default: product.featured_image

          assign subtotal = unit | times: q
          assign discount = subtotal | times: pct | divided_by: 10000.0 | round | times: 100
          assign total = subtotal | minus: discount
          assign per_unit = total | divided_by: q | floor
          assign strike = unit_compare | times: q
          assign save_pct = 0
          if strike > total
            assign save_pct = strike | minus: total | times: 100 | divided_by: strike | floor
          endif
          assign pack_save_pct = 0
          if discount > 0
            assign pack_save_pct = discount | times: 100 | divided_by: subtotal | floor
          endif
        -%}
        {%- unless show_tier -%}{%- continue -%}{%- endunless -%}
        <label class="ec-pack">
          {%- if tag == blank and layout == 'list' and discount > 0 -%}
            {%- capture tag -%}Ahorras {{ discount | money }}{%- endcapture -%}
          {%- endif -%}
          {%- if tag != blank -%}
            <span class="ec-pack__tag ec-tag">{{ tag | escape }}</span>
          {%- endif -%}
          <input
            type="radio"
            name="ec-pack-{{ uid }}"
            value="{{ q }}"
            data-pct="{{ pct }}"
            {% if i == 1 %}
              checked
            {% endif %}
            {% unless variant.available %}
              disabled
            {% endunless %}
          >
          <span class="ec-pack__card">
            <span class="ec-radio" aria-hidden="true"></span>
            {%- if layout == 'cards' and pack_image != blank -%}
              {{
                pack_image
                | image_url: width: 160
                | image_tag: class: 'ec-pack__img', loading: 'lazy', width: 72, height: 72, alt: ''
              }}
            {%- endif -%}
            <span class="ec-pack__body">
              <span class="ec-pack__q">
                {%- if s[label_key] != blank -%}
                  {{ s[label_key] | escape }}
                {%- elsif q == 1 -%}
                  1&nbsp;unidad
                {%- else -%}
                  {{ q }}&nbsp;unidades
                {%- endif -%}
              </span>
              {%- if layout == 'rows' -%}
                <span class="ec-pack__r">
                  <b>
                    {{- per_unit | money }} c/u
                    {%- if pack_save_pct > 0 %} <span class="ec-badge-sale">-{{ pack_save_pct }}%</span>{% endif -%}
                  </b>
                  {%- if pack_save_pct > 0 -%}
                    <s>{{ unit | money }} c/u</s>
                  {%- endif -%}
                </span>
              {%- else -%}
                <span class="ec-pack__p">{{ total | money }}</span>
                {%- if save_pct > 0 -%}
                  <s class="ec-strike ec-pack__s">{{ strike | money }}</s>
                  {%- if layout == 'cards' -%}
                    <span class="ec-pill-save">Ahorras {{ save_pct }}%</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            </span>
          </span>
        </label>
      {%- endfor -%}
    </div>
    {%- if s.help != blank -%}
      <p class="ec-packs__help">{{ s.help | escape }}</p>
    {%- endif -%}
  </fieldset>
  {%- if has_pending_discount and request.design_mode -%}
    <p class="ec-editor-note">
      Los porcentajes de los packs están ocultos: crea los descuentos automáticos en Shopify y luego marca
      «Los descuentos ya existen en Shopify».
    </p>
  {%- endif -%}
</div>
