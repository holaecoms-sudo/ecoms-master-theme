{%- comment -%}
  ECOMS · Icon set (stroke icons, 24x24). Ported from the ECOMS MASTER mockup.
  Usage: {% render 'ecoms-icon', name: 'truck', class: 'ec-i--lg' %}
  Unknown names render nothing.
{%- endcomment -%}
{%- liquid
  case name
    when 'bag'
      assign ec_path = '<path d="M4.5 8h15l-1.3 13H5.8z" fill="currentColor" stroke="none"/><path d="M8.5 9.5V7a3.5 3.5 0 0 1 7 0v2.5" stroke-width="2"/>'
    when 'search'
      assign ec_path = '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>'
    when 'user'
      assign ec_path = '<circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.2-4 4-6 7.5-6s6.3 2 7.5 6"/>'
    when 'cart'
      assign ec_path = '<path d="M2.5 4h2.2l2.2 11h11l2-8H6"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/>'
    when 'menu'
      assign ec_path = '<path d="M4 7h16M4 12h16M4 17h16"/>'
    when 'truck'
      assign ec_path = '<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.5v2.5h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>'
    when 'gift'
      assign ec_path = '<rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8.5h14V12M12 8v12.5M12 8c-1.5-3-5.5-3.5-5.5-1.2S10 8 12 8zm0 0c1.5-3 5.5-3.5 5.5-1.2S14 8 12 8z"/>'
    when 'shield'
      assign ec_path = '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>'
    when 'lock'
      assign ec_path = '<rect x="5" y="11" width="14" height="9.5" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>'
    when 'check'
      assign ec_path = '<path d="M5 12.5l4.5 4.5L19 7.5"/>'
    when 'x'
      assign ec_path = '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>'
    when 'chat'
      assign ec_path = '<path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3.5" y="13" width="4" height="6" rx="1.5"/><rect x="16.5" y="13" width="4" height="6" rx="1.5"/>'
    when 'snow'
      assign ec_path = '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5"/>'
    when 'drop'
      assign ec_path = '<path d="M12 3.5c3.5 4.4 6 7.8 6 10.8a6 6 0 0 1-12 0c0-3 2.5-6.4 6-10.8z"/>'
    when 'leaf'
      assign ec_path = '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19l7-7"/>'
    when 'gem'
      assign ec_path = '<path d="M6.5 4h11l3.5 5-9 11L3 9z"/><path d="M3 9h18M9 4l3 16 3-16"/>'
    when 'thermo'
      assign ec_path = '<path d="M10 14.5V5a2 2 0 0 1 4 0v9.5a4 4 0 1 1-4 0z"/><path d="M12 9v7"/>'
    when 'bolt'
      assign ec_path = '<path d="M13 3L5 14h6l-1 7 8-11h-6z"/>'
    when 'sun'
      assign ec_path = '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>'
    when 'clock'
      assign ec_path = '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'
    when 'heart'
      assign ec_path = '<path d="M12 20s-7.5-4.5-7.5-10A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7.5 3c0 5.5-7.5 10-7.5 10z"/>'
    when 'sparkle'
      assign ec_path = '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM18.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>'
    when 'hand'
      assign ec_path = '<path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V11M11 10V4.5a1.5 1.5 0 0 1 3 0V11M14 10.5V6a1.5 1.5 0 0 1 3 0v8c0 4-2.5 7-6.5 7-3 0-4.5-1.5-6-4l-1.8-3.2a1.4 1.4 0 0 1 2.4-1.4L8 15"/>'
    when 'return'
      assign ec_path = '<path d="M4 9h11a5 5 0 0 1 0 10H9"/><path d="M8 5L4 9l4 4"/>'
    when 'users'
      assign ec_path = '<circle cx="9" cy="8" r="3.5" fill="currentColor"/><path d="M2.5 20c.8-3.6 3.3-5.5 6.5-5.5s5.7 1.9 6.5 5.5z" fill="currentColor"/><circle cx="17" cy="9" r="2.6" fill="currentColor"/><path d="M15.5 14.6c2.8.1 4.9 1.9 5.8 5.4h-4" fill="currentColor"/>'
    when 'box'
      assign ec_path = '<path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5z" fill="currentColor" fill-opacity=".15"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9"/>'
    when 'grid'
      assign ec_path = '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="8" cy="16" r="3"/><circle cx="16" cy="16" r="3"/>'
    when 'battery'
      assign ec_path = '<rect x="3" y="7.5" width="16" height="9" rx="2"/><path d="M21 10.5v3M6 10.5v3M9 10.5v3M12 10.5v3"/>'
    when 'home'
      assign ec_path = '<path d="M4 11l8-6.5 8 6.5v9H4z"/><path d="M10 20v-5h4v5"/>'
    when 'cash'
      assign ec_path = '<rect x="2.5" y="6.5" width="19" height="11" rx="2"/><circle cx="12" cy="12" r="2.5"/>'
    when 'play'
      assign ec_path = '<path d="M7 4.5v15l12.5-7.5z" fill="currentColor" stroke="none"/>'
    when 'star'
      assign ec_path = '<path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.5 1.3 6.6L12 17.2l-5.9 3.3 1.3-6.6-4.9-4.5 6.6-.8z" fill="currentColor" stroke="none"/>'
    when 'fire'
      assign ec_path = '<path d="M12 21c-4 0-7-2.7-7-6.5 0-3.2 2.2-5.3 3.7-7.2.2 2 1.2 3.2 2.3 3.7C11 7.5 12.5 5 14.5 3c.3 3 4.5 5.5 4.5 11.2C19 18.2 16 21 12 21z" fill="currentColor" stroke="none"/>'
    when 'verified'
      assign ec_path = '<circle cx="12" cy="12" r="10" fill="currentColor" stroke="none"/><path d="M7.5 12.3l3 3 6-6" stroke="#fff" stroke-width="2.4"/>'
    when 'chev-l'
      assign ec_path = '<path d="M15 5l-7 7 7 7"/>'
    when 'chev-r'
      assign ec_path = '<path d="M9 5l7 7-7 7"/>'
    when 'plus'
      assign ec_path = '<path d="M12 5v14M5 12h14"/>'
    when 'minus'
      assign ec_path = '<path d="M5 12h14"/>'
    when 'arrow'
      assign ec_path = '<path d="M5 12h14M13 6l6 6-6 6"/>'
    else
      assign ec_path = blank
  endcase
-%}
{%- if ec_path != blank -%}
<svg class="ec-i{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ ec_path }}</svg>
{%- endif -%}
