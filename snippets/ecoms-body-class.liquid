{%- comment -%} ECOMS · Body classes for the active skin. Rendered inside <body class="…">. {%- endcomment -%}
{%- capture ec_skin -%}{% render 'ecoms-skin' %}{%- endcapture -%}
{%- if ec_skin != 'none' %} ec-skin ec-skin--{{ ec_skin }}{% if settings.ecoms_skin_chrome %} ec-chrome{% endif %}{% if settings.ecoms_use_skin_fonts and ec_skin == 'flex' and settings.ecoms_flex_font.family != blank %} ec-fonts{% endif %}{% endif -%}
