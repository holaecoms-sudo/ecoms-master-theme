{%- comment -%}
  ECOMS · Cart drawer extras, rendered inside Dawn's cart drawer so they refresh with it.
  Accepts:
  - part: {String} 'shipping' | 'suggestion' | 'savings' | 'trust'
{%- endcomment -%}
{%- if cart != empty -%}
  {%- case part -%}
    {%- when 'shipping' -%}
      {%- comment -%} Setting is in thousands of CLP (Shopify ranges must stay below 10000). {%- endcomment -%}
      {%- comment -%} Hidden until «El envío gratis ya existe en Shopify» is checked (no promise the checkout won't keep). {%- endcomment -%}
      {%- assign threshold = 0 -%}
      {%- if settings.ecoms_free_shipping_live -%}
        {%- assign threshold = settings.ecoms_free_shipping_threshold | plus: 0 | times: 100000 -%}
      {%- endif -%}
      {%- if threshold > 0 -%}
        {%- liquid
          assign left = threshold | minus: cart.total_price
          assign progress = cart.total_price | times: 100 | divided_by: threshold
          if progress > 100
            assign progress = 100
          endif
        -%}
        <div class="ec-ship{% if left <= 0 %} ec-ship--done{% endif %}" role="status">
          <p>
            {% render 'ecoms-icon', name: 'truck' %}<span>
            {%- if left > 0 -%}
              {%- capture amount -%}<b>{{ left | money }}</b>{%- endcapture -%}
              {{ settings.ecoms_free_shipping_progress | escape | replace: '[amount]', amount }}
            {%- else -%}
              {{ settings.ecoms_free_shipping_success | escape }}
            {%- endif -%}
          </span></p>
          <div class="ec-ship__track" aria-hidden="true">
            <div class="ec-bar"><span style="width: {{ progress }}%"></span></div>
            <span class="ec-ship__goal">{% render 'ecoms-icon', name: 'truck' %}</span>
          </div>
        </div>
      {%- endif -%}

    {%- when 'suggestion' -%}
      {%- liquid
        assign in_cart = cart.items | map: 'product_id'
        assign suggest_from = collections.all.products
        if settings.ecoms_cart_collection != blank
          assign suggest_from = collections[settings.ecoms_cart_collection].products
        endif
        assign max_suggest = settings.ecoms_cart_suggest_count | default: 4
        assign shown = 0
      -%}
      {%- capture cards -%}
        {%- for item in suggest_from limit: 24 -%}
          {%- if in_cart contains item.id or item.available == false -%}{%- continue -%}{%- endif -%}
          {%- if shown >= max_suggest -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="ec-cart-xs__card">
            <a href="{{ item.url }}" class="ec-cart-xs__img" tabindex="-1" aria-hidden="true">
              {%- if item.featured_image != blank -%}
                {{ item.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', width: 96, height: 96, alt: '' }}
              {%- endif -%}
            </a>
            <a href="{{ item.url }}" class="ec-cart-xs__name">{{ item.title | escape }}</a>
            <span class="ec-cart-xs__price">
              {%- if item.price_varies -%}Desde {% endif -%}{{ item.price | money }}
              {%- if item.compare_at_price > item.price %} <s>{{ item.compare_at_price | money }}</s>{%- endif -%}
            </span>
            {%- render 'ecoms-add-button', item: item, label: '+ Agregar', class: 'ec-btn ec-btn--primary ec-btn--sm ec-cart-xs__add', source: 'cart_drawer' -%}
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if shown > 0 -%}
        <div class="ec-cart-xs">
          {%- if settings.ecoms_cart_products_heading != blank -%}
            <p class="ec-cart-xs__h">{{ settings.ecoms_cart_products_heading | escape }}</p>
          {%- endif -%}
          <ul class="ec-cart-xs__list{% if shown == 1 %} ec-cart-xs__list--one{% endif %}" role="list">{{ cards }}</ul>
        </div>
      {%- endif -%}

    {%- when 'trust' -%}
      {%- if shop.enabled_payment_types.size > 0 and settings.ecoms_cart_show_payments -%}
        <ul class="ec-cart-pay" role="list" aria-label="Medios de pago">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'ec-cart-pay__icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if settings.ecoms_cart_trust_1 != blank or settings.ecoms_cart_trust_2 != blank or settings.ecoms_cart_trust_3 != blank -%}
        <ul class="ec-cart-trust" role="list">
          {%- if settings.ecoms_cart_trust_1 != blank -%}<li>{% render 'ecoms-icon', name: 'lock' %}{{ settings.ecoms_cart_trust_1 | escape }}</li>{%- endif -%}
          {%- if settings.ecoms_cart_trust_2 != blank -%}<li>{% render 'ecoms-icon', name: 'truck' %}{{ settings.ecoms_cart_trust_2 | escape }}</li>{%- endif -%}
          {%- if settings.ecoms_cart_trust_3 != blank -%}<li>{% render 'ecoms-icon', name: 'return' %}{{ settings.ecoms_cart_trust_3 | escape }}</li>{%- endif -%}
        </ul>
      {%- endif -%}

    {%- when 'savings' -%}
      {%- if settings.ecoms_cart_show_savings and cart.total_discount > 0 -%}
        <p class="ec-cart-save">Ahorras {{ cart.total_discount | money }} en este pedido</p>
      {%- endif -%}
      {%- if settings.ecoms_cart_note != blank -%}
        <p class="ec-cart-note">{{ settings.ecoms_cart_note | escape }}</p>
      {%- endif -%}
  {%- endcase -%}
{%- endif -%}
