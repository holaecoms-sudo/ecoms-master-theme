{%- comment -%}
  ECOMS · Cart drawer extras, rendered inside Dawn's cart drawer so they refresh with it.
  Accepts:
  - part: {String} 'shipping' | 'suggestion' | 'savings' | 'trust'
{%- endcomment -%}
{%- if cart != empty -%}
  {%- case part -%}
    {%- when 'shipping' -%}
      {%- comment -%} Setting is in thousands of CLP (Shopify ranges must stay below 10000). {%- endcomment -%}
      {%- comment -%} Hidden until «El envío gratis ya existe en Shopify» is checked (no promise the checkout won't keep). {%- endcomment -%}
      {%- assign threshold = 0 -%}
      {%- if settings.ecoms_free_shipping_live -%}
        {%- liquid
          # Exact CLP amount (39990) or thousands (40 = $40.000), as cents.
          assign threshold = settings.ecoms_free_shipping_threshold | plus: 0
          if threshold < 1000
            assign threshold = threshold | times: 1000
          endif
          assign threshold = threshold | times: 100
        -%}
      {%- endif -%}
      {%- if threshold > 0 -%}
        {%- liquid
          # Optional lower amount for one zone (e.g. Región Metropolitana): the bar first aims at it,
          # then at the amount for the rest of the country.
          assign local_at = settings.ecoms_free_shipping_local_threshold | plus: 0 | times: 100
          assign zone = settings.ecoms_free_shipping_local_zone | escape
          assign goal = threshold
          if local_at > 0 and local_at < threshold and cart.total_price < local_at
            assign goal = local_at
          endif
          assign left = goal | minus: cart.total_price
          assign progress = cart.total_price | times: 100 | divided_by: goal
          if progress > 100
            assign progress = 100
          endif
        -%}
        <div class="ec-ship{% if left <= 0 %} ec-ship--done{% endif %}" role="status">
          <p>
            {% render 'ecoms-icon', name: 'truck' %}<span>
            {%- if left > 0 and goal == local_at -%}
              {%- capture amount -%}<b>{{ left | money }}</b>{%- endcapture -%}
              {{ settings.ecoms_free_shipping_progress | escape | replace: '[amount]', amount }} en {{ zone }}
            {%- elsif left > 0 and local_at > 0 and local_at < threshold -%}
              <b>Envío gratis en {{ zone }}.</b> Para regiones te faltan <b>{{ left | money }}</b>
            {%- elsif left > 0 -%}
              {%- capture amount -%}<b>{{ left | money }}</b>{%- endcapture -%}
              {{ settings.ecoms_free_shipping_progress | escape | replace: '[amount]', amount }}
            {%- else -%}
              {{ settings.ecoms_free_shipping_success | escape }}
            {%- endif -%}
          </span></p>
          <div class="ec-ship__track" aria-hidden="true">
            <div class="ec-bar"><span style="width: {{ progress }}%"></span></div>
            <span class="ec-ship__goal">{% render 'ecoms-icon', name: 'truck' %}</span>
          </div>
        </div>
      {%- endif -%}

    {%- when 'suggestion' -%}
      {%- comment -%}
        Only the products chosen per product in the metafield ecoms.cart_suggestions (list of products)
        of the items in the cart. Empty metafield = no suggestions, unless «completar con otros productos»
        is on (then: collection from theme settings, or other store products).
        Never repeats a product and never suggests one already in the cart or sold out.
      {%- endcomment -%}
      {%- liquid
        assign in_cart = cart.items | map: 'product_id'
        assign max_suggest = settings.ecoms_cart_suggest_count | default: 4
        assign shown = 0
        assign used = ','
        assign fallback = collections.all.products
        if settings.ecoms_cart_collection != blank
          assign fallback = collections[settings.ecoms_cart_collection].products
        endif
      -%}
      {%- comment -%}
        Pack upsell: the first cart product whose pack (metafields ecoms.pack_product + ecoms.pack_discount,
        the same real «Compra X y llévate Y» discount as on the product page) is not complete yet.
      {%- endcomment -%}
      {%- assign pack_main = nil -%}
      {%- for line in cart.items -%}
        {%- assign pk_item = line.product.metafields.ecoms.pack_product.value -%}
        {%- assign pk_pct = line.product.metafields.ecoms.pack_discount.value | default: 0 | plus: 0 -%}
        {%- if pk_item != blank and pk_pct > 0 and pk_item.available and pk_item.has_only_default_variant -%}
          {%- unless in_cart contains pk_item.id -%}
            {%- assign pack_main = line.product -%}
            {%- assign pack_item = pk_item -%}
            {%- assign pack_pct = pk_pct -%}
            {%- break -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if pack_main != nil -%}
        {%- liquid
          assign used = used | append: pack_item.id | append: ','
          assign pk_variant = pack_item.selected_or_first_available_variant
          assign pk_off = pk_variant.price | times: pack_pct | divided_by: 100
          assign pk_amount = pack_main.metafields.ecoms.pack_discount_amount.value | default: 0 | plus: 0
          if pk_amount > 0
            assign pk_off = pk_amount | times: 100 | at_most: pk_variant.price
            assign pack_pct = pk_off | times: 100 | divided_by: pk_variant.price | floor
          endif
          assign pk_price = pk_variant.price | minus: pk_off
          assign pk_name = pack_main.metafields.ecoms.pack_name.value | default: 'tu pack'
        -%}
        <div class="ec-cart-pack">
          <span class="ec-cart-pack__img">
            {%- if pack_item.featured_image != blank -%}{{ pack_item.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}{%- endif -%}
          </span>
          <div class="ec-cart-pack__t">
            <p class="ec-cart-pack__h">Completa el {{ pk_name | escape }}</p>
            <p>{{ pack_item.title | escape }}</p>
            <p><b>{{ pk_price | money }}</b> <s>{{ pk_variant.price | money }}</s> <em>-{{ pack_pct }}%</em></p>
          </div>
          {%- render 'ecoms-add-button', item: pack_item, label: '+ Agregar', class: 'ec-btn ec-btn--primary ec-btn--sm ec-cart-pack__add', source: 'cart_pack' -%}
        </div>
      {%- endif -%}
      {%- capture cards -%}
        {%- for line in cart.items -%}
          {%- assign picks = line.product.metafields.ecoms.cart_suggestions.value -%}
          {%- for item in picks -%}
            {%- assign key = ',' | append: item.id | append: ',' -%}
            {%- if shown >= max_suggest or in_cart contains item.id or item.available == false or used contains key -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign used = used | append: item.id | append: ',' -%}
            {%- render 'ecoms-cart-suggestion', item: item -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- if settings.ecoms_cart_fill_others -%}
          {%- for item in fallback limit: 24 -%}
            {%- assign key = ',' | append: item.id | append: ',' -%}
            {%- if shown >= max_suggest -%}{%- break -%}{%- endif -%}
            {%- if in_cart contains item.id or item.available == false or used contains key -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign used = used | append: item.id | append: ',' -%}
            {%- render 'ecoms-cart-suggestion', item: item -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if shown > 0 -%}
        <div class="ec-cart-xs">
          {%- if settings.ecoms_cart_products_heading != blank -%}
            <p class="ec-cart-xs__h">{{ settings.ecoms_cart_products_heading | escape }}</p>
          {%- endif -%}
          <ul class="ec-cart-xs__list{% if shown == 1 %} ec-cart-xs__list--one{% endif %}" role="list">{{ cards }}</ul>
        </div>
      {%- endif -%}

    {%- when 'trust' -%}
      {%- if settings.ecoms_cod_live and settings.ecoms_cod_text != blank -%}
        <p class="ec-cod ec-cod--cart">{% render 'ecoms-icon', name: 'cash' %}<span>{{ settings.ecoms_cod_text | escape }}</span></p>
      {%- endif -%}
      {%- if settings.ecoms_cart_show_payments -%}
        <ul class="ec-cart-pay" role="list" aria-label="Medios de pago">
          {%- render 'ecoms-payment-icons', class: 'ec-cart-pay__icon' -%}
        </ul>
      {%- endif -%}
      {%- if settings.ecoms_cart_trust_1 != blank or settings.ecoms_cart_trust_2 != blank or settings.ecoms_cart_trust_3 != blank -%}
        <ul class="ec-cart-trust" role="list">
          {%- if settings.ecoms_cart_trust_1 != blank -%}<li>{% render 'ecoms-icon', name: 'lock' %}{{ settings.ecoms_cart_trust_1 | escape }}</li>{%- endif -%}
          {%- if settings.ecoms_cart_trust_2 != blank -%}<li>{% render 'ecoms-icon', name: 'truck' %}{{ settings.ecoms_cart_trust_2 | escape }}</li>{%- endif -%}
          {%- if settings.ecoms_cart_trust_3 != blank -%}<li>{% render 'ecoms-icon', name: 'return' %}{{ settings.ecoms_cart_trust_3 | escape }}</li>{%- endif -%}
        </ul>
      {%- endif -%}

    {%- when 'savings' -%}
      {%- if settings.ecoms_cart_show_savings and cart.total_discount > 0 -%}
        <p class="ec-cart-save">Ahorras {{ cart.total_discount | money }} en este pedido</p>
      {%- endif -%}
      {%- if settings.ecoms_cart_note != blank -%}
        <p class="ec-cart-note">{{ settings.ecoms_cart_note | escape }}</p>
      {%- endif -%}
  {%- endcase -%}
{%- endif -%}
