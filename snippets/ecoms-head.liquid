{%- comment -%}
  ECOMS · Head assets: brand tokens, skin fonts and stylesheets. Rendered from layout/theme.liquid.
  Brand colors come from Theme settings → "ECOMS · Plantilla y marca", so every store keeps
  the same templates with its own palette.
{%- endcomment -%}
{%- capture ec_skin -%}{% render 'ecoms-skin' %}{%- endcapture -%}
{%- liquid
  assign ec_head_font = blank
  assign ec_body_font = blank
  assign ec_head_weight = 800
  if settings.ecoms_use_skin_fonts
    case ec_skin
      when 'flex'
        assign ec_head_font = settings.ecoms_flex_font
        assign ec_body_font = settings.ecoms_flex_font
      when 'direct'
        assign ec_head_font = settings.ecoms_direct_font
        assign ec_body_font = settings.ecoms_direct_font
      when 'brand'
        assign ec_head_font = settings.ecoms_brand_heading_font
        assign ec_body_font = settings.ecoms_brand_body_font
        assign ec_head_weight = 500
    endcase
  endif
  if ec_head_font.family == blank or ec_body_font.family == blank
    assign ec_head_font = blank
    assign ec_body_font = blank
  endif
-%}
{%- style -%}
  {%- if ec_body_font != blank -%}
    {%- liquid
      assign ec_v1 = ec_body_font | font_modify: 'weight', '600'
      assign ec_v2 = ec_body_font | font_modify: 'weight', '700'
      if ec_head_font.family == ec_body_font.family
        assign ec_v3 = ec_head_font | font_modify: 'weight', '800'
        assign ec_v4 = ec_head_font | font_modify: 'weight', '900'
      else
        assign ec_v3 = ec_head_font
        assign ec_v4 = ec_head_font | font_modify: 'weight', '500'
      endif
    -%}
    {{ ec_body_font | font_face: font_display: 'swap' }}
    {%- if ec_v1 %}{{ ec_v1 | font_face: font_display: 'swap' }}{% endif -%}
    {%- if ec_v2 %}{{ ec_v2 | font_face: font_display: 'swap' }}{% endif -%}
    {%- if ec_v3 %}{{ ec_v3 | font_face: font_display: 'swap' }}{% endif -%}
    {%- if ec_v4 %}{{ ec_v4 | font_face: font_display: 'swap' }}{% endif -%}
  {%- endif -%}
  :root {
    --ec-primary: {{ settings.ecoms_primary }};
    --ec-primary-hover: {{ settings.ecoms_primary | color_darken: 8 }};
    --ec-primary-ink: {{ settings.ecoms_primary_ink }};
    --ec-dark: {{ settings.ecoms_dark }};
    --ec-accent: {{ settings.ecoms_accent }};
    --ec-accent-ink: {{ settings.ecoms_accent_ink }};
    --ec-soft: {{ settings.ecoms_soft }};
    --ec-soft-ink: {{ settings.ecoms_soft_ink }};
    --ec-tag: {{ settings.ecoms_tag }};
    --ec-tag-ink: {{ settings.ecoms_tag_ink }};
    --ec-sale-bg: {{ settings.ecoms_sale_bg }};
    --ec-sale-ink: {{ settings.ecoms_sale_ink }};
    --ec-urgent: {{ settings.ecoms_urgent }};
    --ec-urgent-bg: {{ settings.ecoms_urgent_bg }};
    --ec-star: {{ settings.ecoms_star }};
    --ec-deep: {{ settings.ecoms_deep }};
    --ec-bg: {{ settings.ecoms_bg }};
    --ec-ink: {{ settings.ecoms_ink }};
    --ec-muted: {{ settings.ecoms_muted }};
    --ec-line: {{ settings.ecoms_line }};
    --ec-rb: {{ settings.ecoms_radius_button }}px;
    --ec-rm: {{ settings.ecoms_radius_card }}px;
  }
  {%- if ec_body_font != blank %}
    body.ec-fonts {
      --font-body-family: {{ ec_body_font.family }}, {{ ec_body_font.fallback_families | default: 'sans-serif' }};
      --font-body-style: normal;
      --font-body-weight: 400;
      --font-body-weight-bold: 700;
      --font-heading-family: {{ ec_head_font.family }}, {{ ec_head_font.fallback_families | default: 'sans-serif' }};
      --font-heading-style: normal;
      --font-heading-weight: {{ ec_head_weight }};
    }
  {%- endif %}
{%- endstyle -%}
{{ 'ecoms-base.css' | asset_url | stylesheet_tag }}
{{ 'ecoms-components.css' | asset_url | stylesheet_tag }}
{%- if ec_skin != 'none' -%}
  {{ 'ecoms-skin-' | append: ec_skin | append: '.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'ecoms.js' | asset_url }}" defer="defer"></script>
{%- if settings.ecoms_protect_images and request.design_mode != true -%}
  <style>
    img, video, picture, svg image { -webkit-user-drag: none; user-drag: none; -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; }
  </style>
  <script>
    (function () {
      var editable = function (el) { return el && el.closest && el.closest('input, textarea, select, [contenteditable="true"]'); };
      document.addEventListener('contextmenu', function (e) { if (!editable(e.target)) e.preventDefault(); });
      document.addEventListener('dragstart', function (e) { if (e.target && /^(IMG|VIDEO|PICTURE)$/.test(e.target.tagName)) e.preventDefault(); });
      document.addEventListener('keydown', function (e) {
        var k = (e.key || '').toLowerCase();
        if ((e.ctrlKey || e.metaKey) && (k === 's' || k === 'u')) e.preventDefault();
      });
    })();
  </script>
{%- endif -%}
