{%- comment -%} ECOMS · One before/after pair. Params: before, after (images), before_caption, after_caption, style. {%- endcomment -%}
{%- if style != 'side' -%}
  <div class="ec-cmpr" style="--pos: 50%" data-ec-cmpr>
    {%- if after != blank -%}
      {{ after | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 990px) 560px, 100vw', class: 'ec-cmpr__img', alt: after_caption }}
    {%- else -%}{{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}{%- endif -%}
    <div class="ec-cmpr__before">
      {%- if before != blank -%}
        {{ before | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 990px) 560px, 100vw', class: 'ec-cmpr__img', alt: before_caption }}
      {%- else -%}{{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}{%- endif -%}
    </div>
    <span class="ec-cmpr__tag ec-cmpr__tag--l">{{ before_caption | escape }}</span>
    <span class="ec-cmpr__tag ec-cmpr__tag--r">{{ after_caption | escape }}</span>
    <span class="ec-cmpr__line" aria-hidden="true"><span class="ec-cmpr__knob">&lsaquo; &rsaquo;</span></span>
    <input class="ec-cmpr__range" type="range" min="0" max="100" value="50" aria-label="Comparar antes y después" data-ec-cmpr-range>
  </div>
{%- else -%}
  <div class="ec-ba">
    <figure>
      {%- if before != blank -%}
        {{ before | image_url: width: 900 | image_tag: loading: 'lazy', widths: '350,550,750,900', sizes: '(min-width: 990px) 25vw, 50vw' }}
      {%- else -%}{{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}{%- endif -%}
      <figcaption><b>{{ before_caption | escape }}</b></figcaption>
    </figure>
    <span class="ec-ba__arrow" aria-hidden="true">{% render 'ecoms-icon', name: 'arrow' %}</span>
    <figure>
      {%- if after != blank -%}
        {{ after | image_url: width: 900 | image_tag: loading: 'lazy', widths: '350,550,750,900', sizes: '(min-width: 990px) 25vw, 50vw' }}
      {%- else -%}{{ 'image' | placeholder_svg_tag: 'ec-placeholder' }}{%- endif -%}
      <figcaption><b>{{ after_caption | escape }}</b></figcaption>
    </figure>
  </div>
{%- endif -%}
