{%- comment -%} ECOMS · Social icons (Instagram, TikTok, YouTube, Facebook). Usage: {% render 'ecoms-social-icon', name: 'ig' %} {%- endcomment -%}
{%- liquid
  case name
    when 'ig'
      assign ec_path = '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".8" fill="currentColor"/>'
    when 'tt'
      assign ec_path = '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.8 2.4 4.5 5 4.8"/>'
    when 'yt'
      assign ec_path = '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.3v5.4l4.7-2.7z" fill="currentColor"/>'
    when 'fb'
      assign ec_path = '<path d="M14 21v-8h3l.5-3.5H14V7.8c0-1 .4-1.8 1.8-1.8h1.8V3a20 20 0 0 0-2.7-.2c-2.6 0-4.4 1.6-4.4 4.6v2.1H7.5V13h3v8"/>'
  endcase
-%}
<svg class="ec-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ ec_path }}</svg>
