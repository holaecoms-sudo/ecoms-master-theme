    "faq": {
      "type": "ecoms-faq",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "¿Cuánto dura la batería?",
            "answer": "<p>Indica la autonomía y el tiempo de carga reales según la ficha del proveedor.</p>",
            "draft": true
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "¿Qué cabezales incluye?",
            "answer": "<p>Detalla la cantidad y el tipo de cabezales que vienen en la caja.</p>",
            "draft": true
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "¿Se puede mojar?",
            "answer": "<p>Indica la resistencia al agua real (por ejemplo, la certificación IPX) según la ficha del proveedor.</p>",
            "draft": true
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "¿En qué superficies lo puedo usar?",
            "answer": "<p>Está pensado para superficies duras del hogar: baño, ducha, azulejos, cocina y pisos. En superficies delicadas usa el cabezal más suave y prueba primero en una zona poco visible.</p>",
            "draft": false
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "question": "¿Cuánto cuesta el envío y cuánto tarda?",
            "answer": "<p>Despachamos a todo Chile. El costo y el plazo estimado para tu comuna aparecen en el checkout antes de pagar.</p>",
            "draft": false
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "question": "¿Cómo puedo pagar?",
            "answer": "<p>Con los medios de pago disponibles en el checkout seguro de Shopify.</p>",
            "draft": false
          }
        },
        "q7": {
          "type": "faq",
          "settings": {
            "question": "¿Puedo cambiar o devolver mi compra?",
            "answer": "<p>Resume tu política de cambios y devoluciones y enlázala (Configuración → Políticas).</p>",
            "draft": true
          }
        }
