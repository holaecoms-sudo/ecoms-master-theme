          "type": "faq",
          "settings": {
            "question": "¿Sirve para piel sensible?",
            "answer": "<p>Si tu piel es sensible, pruébalo primero en una zona pequeña antes de usarlo en todo el rostro.</p>",
            "draft": false
          }
        },
