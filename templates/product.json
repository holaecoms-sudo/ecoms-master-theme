          "type": "faq",
          "settings": {
            "question": "¿Cuánto demora en llegar?",
            "answer": "<p>Entre 2 y 5 días hábiles según tu comuna. Te enviamos el seguimiento de tu pedido.</p>",
            "draft": false
          }
        },
