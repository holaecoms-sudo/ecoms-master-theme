<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><title>Pedido nuevo {{ order_name }}</title></head>
<body style="margin:0;padding:16px;background:#f4f4f4;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#1E1B24">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;margin:0 auto;background:#ffffff;border-radius:12px"><tr><td style="padding:22px 24px">
<div style="font-size:12px;letter-spacing:1.4px;text-transform:uppercase;font-weight:700;color:#B5536A">Pedido nuevo</div>
<div style="font-size:26px;font-weight:800;padding:4px 0 2px">{{ order_name }} · {{ total_price | money }}</div>
<div style="font-size:14px;color:#6A5C62;padding-bottom:14px">{% if financial_status == 'paid' %}<b style="color:#0a7a3e">PAGADO</b> con tarjeta{% else %}<b style="color:#B5536A">PAGO AL RECIBIR</b> · confirmar por WhatsApp antes de despachar{% endif %}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FFF1F4;border-radius:10px"><tr><td style="padding:14px 16px;font-size:14px;line-height:22px">
<b>Cliente:</b> {{ shipping_address.name | default: customer.name }}<br>
<b>Teléfono:</b> {{ shipping_address.phone | default: customer.phone }}<br>
<b>Email:</b> {{ customer.email | default: email }}<br>
<b>Dirección:</b> {{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}, {{ shipping_address.city }}, {{ shipping_address.province }}<br>
<b>Envío:</b> {% if shipping_price == 0 %}Gratis{% else %}{{ shipping_price | money }}{% endif %}{% if shipping_method.title %} ({{ shipping_method.title }}){% endif %}{% if note != blank %}<br><b>Nota:</b> {{ note }}{% endif %}
</td></tr></table>
<div style="font-size:13px;letter-spacing:1.2px;text-transform:uppercase;font-weight:700;color:#6A5C62;padding:16px 0 6px">Productos</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
{%- for line in subtotal_line_items -%}<tr><td style="padding:8px 0;border-bottom:1px solid #E7DAD6;font-size:15px"><b>{{ line.quantity }} ×</b> {{ line.product.title | default: line.title }}{% if line.sku != blank %} <span style="color:#6A5C62;font-size:12px">({{ line.sku }})</span>{% endif %}</td><td align="right" style="padding:8px 0;border-bottom:1px solid #E7DAD6;font-size:15px;white-space:nowrap">{{ line.final_line_price | money }}</td></tr>{%- endfor -%}
</table>
{%- assign bal_qty = 0 -%}{%- for line in subtotal_line_items -%}{%- if line.product.handle == 'balsamo-pdrn-hidratante-colageno' -%}{%- assign bal_qty = bal_qty | plus: line.quantity -%}{%- endif -%}{%- endfor -%}
{%- if bal_qty >= 4 -%}<div style="margin-top:12px;padding:10px 14px;background:#fff7d6;border-radius:8px;font-size:14px"><b>Ojo bodega:</b> este pedido incluye 2 barras de regalo. Verificar que el paquete lleve 4 barras en total.</div>{%- endif -%}
<div style="padding-top:14px"><a href="{{ order_status_url }}" style="color:#B5536A;font-size:14px">Ver pedido</a></div>
</td></tr></table></body></html>
